---
import LoginModal from '../components/LoginModal.astro';
import CtaFooter from '../components/CtaFooter.astro';
import LigaBookShell from '../components/LigaBookShell.astro';

interface Props {
  title?: string;
  description?: string;
  minimal?: boolean;
}
const {
  title = "Liga Supersaludable",
  description = "Cuentos, juegos, retos y recursos educativos para aprender, divertirse y desarrollar hábitos saludables en familia.",
  minimal = false,
} = Astro.props;
const activeSection = Astro.url.pathname === '/'
  ? 'inicio'
  : Astro.url.pathname === '/biblioteca'
    ? 'cuentos'
    : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/logos/logo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {!minimal && <LoginModal />}
    {minimal ? (
      <slot />
    ) : (
      <>
        <LigaBookShell activeSection={activeSection}>
          <slot />
        </LigaBookShell>
        <CtaFooter />
      </>
    )}

    <script>
      interface BookUpdateDetail {
        slug?: string;
        descargas_total?: number;
        rating_promedio?: number;
        total_valoraciones?: number;
      }

      function onReady(callback: () => void) {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', callback);
        } else {
          callback();
        }
      }

      function updateCardCounts(detail: BookUpdateDetail | undefined) {
        if (!detail?.slug) return;
        const cards = document.querySelectorAll(`[data-libro-slug="${detail.slug}"]`);
        cards.forEach((card) => {
          if (detail.descargas_total !== undefined) {
            const descNode = card.querySelector('[data-book-count="descargas"]');
            if (descNode) {
              descNode.textContent = detail.descargas_total.toLocaleString('es');
            }
          }

          if (detail.rating_promedio !== undefined) {
            const ratingNode = card.querySelector('[data-book-count="rating-value"]');
            if (ratingNode) {
              ratingNode.textContent = Number(detail.rating_promedio).toFixed(1);
            }
          }

          if (detail.total_valoraciones !== undefined) {
            const votosNode = card.querySelector('[data-book-count="valoraciones"]');
            if (votosNode) {
              votosNode.textContent = `(${detail.total_valoraciones})`;
            }
          }
        });
      }

      onReady(() => {
        window.addEventListener('auth:expired', () => {
          localStorage.removeItem('token');
          localStorage.removeItem('usuario');
        });

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest<HTMLAnchorElement>('a[href]');
          if (!link) return;

          const destination = new URL(link.href, window.location.href);
          if (destination.origin !== window.location.origin ||
              !['/auth/login', '/auth/registro'].includes(destination.pathname) ||
              window.location.pathname.startsWith('/auth/')) return;

          sessionStorage.setItem(
            'auth:returnTo',
            `${window.location.pathname}${window.location.search}${window.location.hash}`,
          );
        });

        window.addEventListener('book:update', (event) => {
          updateCardCounts((event as CustomEvent<BookUpdateDetail>).detail);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --color-navy: #1d294a;
    --color-navy-light: #2b4f9f;
    --color-gold: #f7ae4a;
    --color-gold-light: #ffd57d;
    --color-cream: #fff7f1;
    --color-cream-dark: #ffe5d1;
    --color-primary-blue: #4ea0ff;
    --color-primary-pink: #ff5f9c;
    --color-primary-green: #16a085;
    --color-primary-purple: #7d5ae9;
    --color-primary-red: #ff6d5a;
    --color-primary-yellow: #ffd75b;
    --color-text: #213047;
    --color-text-muted: #68778c;
    --color-white: #ffffff;
    --color-border: rgba(34, 52, 75, 0.09);
    --color-surface: #fffaf6;
    --color-surface-strong: #fff1e2;
    --radius-sm: 12px;
    --radius-md: 18px;
    --radius-lg: 28px;
    --shadow-sm: 0 10px 24px rgba(27, 39, 58, 0.06);
    --shadow-md: 0 18px 30px rgba(27, 39, 58, 0.12);
    --shadow-lg: 0 28px 55px rgba(27, 39, 58, 0.14);
    --font-serif: 'Lora', Georgia, serif;
    --font-sans: 'Inter', system-ui, sans-serif;
    --max-width: 1200px;
  }

  html {
    font-family: var(--font-sans);
    color: var(--color-text);
    background: linear-gradient(180deg, #fffdfb 0%, #fffaf5 100%);
    scroll-behavior: smooth;
  }

  body {
    min-height: 100vh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at top left, rgba(255, 182, 98, 0.14), transparent 22%),
      radial-gradient(circle at bottom right, rgba(78, 160, 255, 0.08), transparent 22%),
      var(--color-white);
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    cursor: pointer;
    font-family: var(--font-sans);
    border: none;
    background: none;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section {
    padding: 5rem 0;
  }

  .section-bg {
    background: linear-gradient(180deg, #fff9f5 0%, #fff3eb 100%);
  }

  .section-header {
    margin-bottom: 2.5rem;
  }

  .section-header h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3vw, 2.7rem);
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 0.35rem;
    letter-spacing: -0.03em;
  }

  .section-header p {
    color: var(--color-text-muted);
    font-size: 0.97rem;
    line-height: 1.7;
  }

  .section-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .ver-mas {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-navy);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    transition: transform 0.2s ease, opacity 0.2s ease;
    padding-top: 0.25rem;
  }

  .ver-mas:hover {
    opacity: 0.75;
    transform: translateX(2px);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.32rem 0.72rem;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 700;
    background: rgba(247, 174, 74, 0.14);
    color: #9d5b13;
  }

  .badge-destacado {
    background: linear-gradient(135deg, #ffb347, #ff7b54);
    color: var(--color-white);
    font-size: 0.73rem;
    font-weight: 800;
    padding: 0.3rem 0.8rem;
  }

  .star-rating {
    color: var(--color-gold);
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .star-rating span {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    :root {
      --radius-sm: 10px;
      --radius-md: 14px;
      --radius-lg: 20px;
    }

    html {
      font-size: 15px;
    }

    .container {
      padding: 0 1.25rem;
    }

    .section {
      padding: 3.5rem 0;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .section-header h2 {
      font-size: clamp(1.5rem, 2.5vw, 1.95rem);
      margin-bottom: 0.3rem;
    }

    .section-header p {
      font-size: 0.9rem;
    }

    .section-header-row {
      gap: 0.75rem;
    }

    .ver-mas {
      font-size: 0.85rem;
    }

    .badge {
      padding: 0.18rem 0.5rem;
      font-size: 0.72rem;
    }

    .badge-destacado {
      padding: 0.22rem 0.65rem;
      font-size: 0.7rem;
    }
  }

  @media (max-width: 480px) {
    html {
      font-size: 14px;
    }

    .container {
      padding: 0 1rem;
    }

    .section {
      padding: 2.5rem 0;
    }

    .section-header {
      margin-bottom: 1.75rem;
    }

    .section-header h2 {
      font-size: clamp(1.35rem, 2vw, 1.75rem);
      margin-bottom: 0.25rem;
    }

    .section-header p {
      font-size: 0.85rem;
    }

    .ver-mas {
      font-size: 0.8rem;
    }

    .badge {
      padding: 0.15rem 0.45rem;
      font-size: 0.68rem;
    }

    .badge-destacado {
      padding: 0.2rem 0.6rem;
      font-size: 0.65rem;
    }
  }
</style>
