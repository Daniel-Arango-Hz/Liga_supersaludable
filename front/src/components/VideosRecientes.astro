<!-- Modal de reproducción de video -->
<div id="videoPlayerModal" style="display:none;" class="vplayer-overlay" aria-hidden="true">
  <div class="vplayer-backdrop" id="vplayerBackdrop"></div>
  <div class="vplayer-card" role="dialog" aria-modal="true" aria-label="Reproductor de video">
    <div class="vplayer-header">
      <div>
        <p class="vplayer-titulo" id="vplayerTitulo"></p>
        <p class="vplayer-autor" id="vplayerAutor"></p>
      </div>
      <button type="button" class="vplayer-close" id="vplayerClose" aria-label="Cerrar">×</button>
    </div>
    <video id="vplayerVideo" class="vplayer-video" controls playsinline preload="metadata">
      Tu navegador no soporta la reproducción de video.
    </video>
  </div>
</div>

<script>
  (() => {
    const modal    = document.getElementById('videoPlayerModal');
    const backdrop = document.getElementById('vplayerBackdrop');
    const closeBtn = document.getElementById('vplayerClose');
    const videoEl  = document.getElementById('vplayerVideo') as HTMLVideoElement | null;
    const tituloEl = document.getElementById('vplayerTitulo');
    const autorEl  = document.getElementById('vplayerAutor');
    const API_URL = document.getElementById('videos')?.getAttribute('data-api') || '/api';

    function openPlayer(url: string, titulo: string, autor: string, slug: string) {
      if (!modal || !videoEl) return;
      videoEl.src = url;
      if (tituloEl) tituloEl.textContent = titulo || '';
      if (autorEl)  autorEl.textContent  = autor  || '';
      modal.style.display = 'grid';
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      videoEl.play().catch(() => {});
      // Registrar vista y actualizar el contador en la UI.
      if (slug) {
        fetch(`${API_URL}/videos/${encodeURIComponent(slug)}`)
          .then(() => window.dispatchEvent(new CustomEvent('video:updated', { detail: { slug } })))
          .catch(() => {});
      }
    }

    function closePlayer() {
      if (!modal || !videoEl) return;
      videoEl.pause();
      videoEl.src = '';
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest('[data-video-url]') : null;
      if (btn) {
        const url    = btn.getAttribute('data-video-url')    || '';
        const titulo = btn.getAttribute('data-video-titulo') || '';
        const autor  = btn.getAttribute('data-video-autor')  || '';
        const slug   = btn.getAttribute('data-video-slug')   || '';
        if (url) openPlayer(url, titulo, autor, slug);
        return;
      }

      if (e.target === backdrop || e.target === closeBtn) closePlayer();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.style.display !== 'none') closePlayer();
    });
  })();
</script>

