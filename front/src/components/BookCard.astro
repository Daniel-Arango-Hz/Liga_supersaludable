---
import type { Libro } from '../data/libros';

interface Props {
  libro: Libro;
  variante?: 'vertical' | 'horizontal' | 'catalogo';
}

const { libro, variante = 'vertical' } = Astro.props;
const isImageCover = typeof libro.portadaIcono === 'string' && /^https?:\/\//i.test(libro.portadaIcono);
const rating = typeof libro.rating === 'number' ? libro.rating : 0;
---

{variante === 'catalogo' ? (
  <article class="adventure-card" data-libro-slug={libro.slug}>
    <a href={`/libro/${libro.slug}`} class="adventure-card-link" aria-label={`Comenzar ${libro.titulo}`}>
      <div class="adventure-cover" style={`background: ${libro.portadaGradiente}`}>
        {isImageCover ? (
          <img class="adventure-cover-image" src={libro.portadaIcono} alt={`Portada de ${libro.titulo}`} loading="lazy" />
        ) : (
          <span class="adventure-cover-icon" aria-hidden="true">{libro.portadaIcono}</span>
        )}
        {libro.destacado && <span class="adventure-badge">Destacado</span>}
        <h3 class="adventure-title">{libro.titulo}</h3>
      </div>

      <div class="adventure-info">
        <div class="adventure-stats">
          <div class="adventure-stat adventure-downloads" aria-label={`${(libro.descargas ?? 0).toLocaleString('es')} descargas`}>
            <div class="adventure-stat-value">
              <strong>{(libro.descargas ?? 0).toLocaleString('es')}</strong>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span>Descargas</span>
          </div>
          <span class="adventure-divider" aria-hidden="true"></span>
          <div class="adventure-stat adventure-rating" aria-label={`${rating.toFixed(1)} de 5, valoración`}>
            <span class="adventure-stars" style={`--rating: ${Math.min(5, Math.max(0, rating)) / 5 * 100}%`} aria-hidden="true">★★★★★</span>
            <span><strong>{rating.toFixed(1)}</strong> Valoración</span>
          </div>
        </div>
        <span class="adventure-cta">Comenzar</span>
      </div>
    </a>
  </article>
) : variante === 'vertical' ? (
  <article class="book-card" data-libro-slug={libro.slug}>
    <a href={`/libro/${libro.slug}`} class="book-card-link" aria-label={`Ver ${libro.titulo}`}>
      <div class="book-cover" style={`background: ${libro.portadaGradiente}`}>
        {libro.destacado && <span class="badge badge-destacado">Destacado</span>}
        <span class="pages-bubble">{libro.paginas ?? (libro.paginasContenido?.length ?? '')} págs.</span>
        {isImageCover ? (
          <img class="cover-image" src={libro.portadaIcono} alt={`Portada de ${libro.titulo}`} loading="lazy" />
        ) : (
          <span class="cover-icon" aria-hidden="true">{libro.portadaIcono}</span>
        )}
        <div class="cover-title-overlay">
          <p class="cover-titulo">{libro.titulo}</p>
        </div>
      </div>

      <div class="book-info">
        <p class="book-eyebrow">{(libro.categorias && libro.categorias.length) ? libro.categorias[0] : 'Familia'}</p>
        <h3 class="book-titulo">{libro.titulo}</h3>
        <p class="book-subtitle">{libro.familiaInfo || `${libro.autor}`}</p>

        <div class="book-footer">
          <div class="book-stats">
            <div class="stat stat-rating" title="Valoración">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .587l3.668 7.431L23.4 9.587l-5.7 5.556L18.9 23.4 12 19.771 5.1 23.4l1.2-8.257L.6 9.587l7.732-1.569z"/>
              </svg>
              <span>{(typeof libro.rating === 'number' ? libro.rating.toFixed(1) : (libro.votos ?? 0)).toString()}</span>
            </div>
            <div class="stat stat-downloads" title="Descargas">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>{(libro.descargas ?? 0).toLocaleString('es')}</span>
            </div>
          </div>

          <div class="book-cta">
            <span class="leer">Leer</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </div>
    </a>
  </article>
) : (
  <article class="book-h-card" data-libro-slug={libro.slug}>
    <a href={`/libro/${libro.slug}`} class="book-h-link" aria-label={`Ver ${libro.titulo}`}>
      <div class="book-h-thumb" style={`background: ${libro.portadaGradiente}`} aria-hidden="true">
        {isImageCover ? (
          <img class="h-cover-image" src={libro.portadaIcono} alt="Portada" loading="lazy" />
        ) : (
          <span class="h-cover-icon">{libro.portadaIcono}</span>
        )}
        <span class="pages-bubble-small">{libro.paginas ?? (libro.paginasContenido?.length ?? '')} págs.</span>
      </div>
      <div class="book-h-info">
        <p class="book-autor">{libro.autor}</p>
        <h3 class="book-titulo">{libro.titulo}</h3>
        <div class="book-tags">
          {libro.categorias.map((cat) => <span class="badge">{cat}</span>)}
          <span class="badge">{libro.edadRango}</span>
        </div>
      </div>
      <div class="book-h-meta">
        <div class="stat stat-rating">⭐ {(typeof libro.rating === 'number' ? libro.rating.toFixed(1) : (libro.votos ?? 0)).toString()}</div>
        <div class="stat stat-downloads">⬇️ {(libro.descargas ?? 0).toLocaleString('es')}</div>
      </div>
    </a>
  </article>
)}

<style>
  .adventure-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(41, 54, 66, 0.1);
    border-radius: 30px;
    background: #fff;
    box-shadow: 0 12px 28px rgba(28, 45, 56, 0.12);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    container-type: inline-size;
  }

  .adventure-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 38px rgba(28, 45, 56, 0.17);
  }

  .adventure-card-link {
    display: block;
    padding: clamp(0.6rem, 2.8cqi, 1.1rem);
    color: inherit;
  }

  .adventure-cover {
    position: relative;
    display: grid;
    aspect-ratio: 1.18 / 1;
    place-items: center;
    overflow: hidden;
    border-radius: 24px;
    background-color: #eaf3f1;
    background-position: center;
    background-size: cover;
  }

  .adventure-cover::after {
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(180deg, transparent, rgba(12, 24, 30, 0.68));
    content: '';
    pointer-events: none;
  }

  .adventure-cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .adventure-cover-icon {
    font-size: clamp(4rem, 8vw, 6.5rem);
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.16));
  }

  .adventure-badge {
    position: absolute;
    z-index: 1;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: #fff;
    color: #315d49;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .adventure-title {
    position: absolute;
    z-index: 1;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    color: #fff;
    font-family: var(--font-sans);
    font-size: clamp(1.2rem, 5.5cqi, 2.25rem);
    font-weight: 900;
    line-height: 1.08;
    text-align: center;
    text-shadow: 0 2px 5px rgba(0, 0, 0, 0.6);
  }

  .adventure-info {
    display: grid;
    gap: clamp(0.6rem, 2.4cqi, 1rem);
    padding: clamp(0.75rem, 2.8cqi, 1.25rem) 0.35rem 0.25rem;
  }

  .adventure-stats {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    align-items: center;
    gap: clamp(0.3rem, 1.5cqi, 0.75rem);
    min-height: clamp(76px, 16cqi, 112px);
  }

  .adventure-stat {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    color: #1b1b1b;
    font-size: clamp(0.78rem, 3.5cqi, 1.4rem);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
  }

  .adventure-stat-value {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    gap: clamp(0.25rem, 1.5cqi, 0.65rem);
    font-size: clamp(1.35rem, 7cqi, 2.8rem);
    line-height: 1;
    white-space: nowrap;
  }

  .adventure-stat-value svg {
    width: 1.05em;
    height: 1.05em;
    flex: 0 0 auto;
  }

  .adventure-divider {
    width: 1px;
    height: 80%;
    background: #d7d7d7;
  }

  .adventure-stars {
    display: block;
    max-width: 100%;
    color: transparent;
    background: linear-gradient(90deg, #f5aa24 var(--rating), #d0d0d0 var(--rating));
    background-clip: text;
    -webkit-background-clip: text;
    font-size: clamp(1rem, 5.4cqi, 2.1rem);
    letter-spacing: 0;
    line-height: 1;
    white-space: nowrap;
  }

  .adventure-rating strong {
    font-weight: 900;
  }

  .adventure-rating > span:last-child {
    white-space: nowrap;
  }

  .adventure-cta {
    display: grid;
    width: 90%;
    min-height: clamp(56px, 19cqi, 132px);
    margin: 0 auto;
    place-items: center;
    border: 2px solid #20528d;
    border-radius: 20px;
    background: linear-gradient(180deg, #4d91d1, #3477bd);
    box-shadow: inset 0 -4px 0 rgba(20, 59, 105, 0.22);
    color: #fff;
    font-size: clamp(1.35rem, 8cqi, 3rem);
    font-weight: 900;
    text-shadow: 0 2px 2px rgba(21, 51, 82, 0.35);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .adventure-card:hover .adventure-cta {
    filter: brightness(1.06);
  }

  .book-card {
    background: rgba(255, 255, 255, 0.9);
    border-radius: 26px;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: all 0.25s ease;
    border: 1px solid rgba(29, 41, 74, 0.05);
    position: relative;
  }

  .book-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(78, 160, 255, 0.03), rgba(255, 95, 156, 0.06));
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .book-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-8px);
    border-color: rgba(255, 95, 156, 0.2);
  }

  .book-card:hover::before {
    opacity: 1;
  }

  .book-card-link {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }

  .book-cover {
    position: relative;
    aspect-ratio: 3/4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    overflow: hidden;
  }

  .cover-icon {
    font-size: 4.5rem;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    opacity: 0.38;
    pointer-events: none;
    user-select: none;
  }

  .cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-title-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem 1rem 1rem;
    background: linear-gradient(to top, rgba(8, 15, 24, 0.8) 0%, transparent 100%);
  }

  .cover-titulo {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.45);
  }

  .badge-destacado {
    background: linear-gradient(135deg, #ffb347, #ff725d);
    color: #fff;
    font-weight: 800;
    padding: 0.38rem 0.72rem;
    border-radius: 999px;
    font-size: 0.72rem;
    display: inline-block;
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    box-shadow: 0 8px 18px rgba(255, 116, 88, 0.12);
  }

  .pages-bubble {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--color-navy);
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.74rem;
    box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    z-index: 3;
  }

  .pages-bubble-small {
    position: absolute;
    top: 8px;
    right: 8px;
    background: rgba(255,255,255,0.95);
    color: var(--color-navy);
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    font-weight: 800;
    font-size: 0.7rem;
    box-shadow: 0 6px 12px rgba(0,0,0,0.08);
    z-index: 3;
  }

  .book-info {
    display: flex;
    flex-direction: column;
    padding: 1rem 1rem 1.1rem;
    gap: 0.5rem;
  }

  .book-eyebrow {
    color: #c86628;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 800;
  }

  .book-titulo {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: var(--color-navy);
    line-height: 1.2;
  }

  .book-subtitle {
    color: var(--color-text-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .book-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 0.2rem;
  }

  .book-stats {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .stat {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.76rem;
    color: var(--color-text-muted);
    font-weight: 700;
  }

  .stat svg {
    width: 14px;
    height: 14px;
  }

  .book-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    color: var(--color-primary-pink);
    font-weight: 800;
    font-size: 0.8rem;
  }

  .book-cta svg {
    width: 14px;
    height: 14px;
  }

  .cover-autor {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.25rem;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    font-weight: 500;
  }

  .book-info {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .book-eyebrow {
    color: #ff6c3f;
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
  }

  .book-subtitle {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .book-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.6rem;
  }

  .book-stats {
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }

  .stat {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--color-text-muted);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .book-cta {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    color: #ff6c3f;
    font-weight: 800;
  }

  .book-autor {
    font-size: 0.85rem;
    color: var(--color-primary-blue);
    font-weight: 600;
  }

  .book-titulo {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.35;
  }

  .book-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .book-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0.3rem;
  }

  .star-rating {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    color: var(--color-primary-yellow);
    font-weight: 600;
  }

  .star-rating svg {
    color: var(--color-primary-yellow);
  }

  .book-descargas {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    color: var(--color-primary-blue);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .book-edad {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    font-size: 0.85rem;
    color: var(--color-primary-purple);
    font-weight: 600;
  }

  .book-meta svg,
  .book-edad svg {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .book-card {
      border-width: 2px;
    }

    .cover-icon {
      font-size: 3.5rem;
    }

    .book-info {
      padding: 1.1rem;
      gap: 0.5rem;
    }

    .book-titulo {
      font-size: 0.95rem;
    }

    .book-autor {
      font-size: 0.8rem;
    }

    .book-meta {
      font-size: 0.85rem;
      gap: 0.75rem;
    }

    .star-rating {
      font-size: 0.8rem;
    }

    .book-descargas {
      font-size: 0.8rem;
    }

    .book-edad {
      font-size: 0.8rem;
    }

    .book-meta svg,
    .book-edad svg {
      width: 0.9rem;
      height: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .book-card {
      border-width: 2px;
    }

    .book-cover {
      aspect-ratio: 3/4;
      padding: 0.75rem;
    }

    .cover-icon {
      font-size: 2.5rem;
    }

    .cover-title-overlay {
      padding: 1rem 0.75rem 0.75rem;
    }

    .cover-titulo {
      font-size: 0.8rem;
    }

    .cover-autor {
      font-size: 0.7rem;
      margin-top: 0.15rem;
    }

    .book-info {
      padding: 1rem;
      gap: 0.4rem;
    }

    .book-autor {
      font-size: 0.75rem;
    }

    .book-titulo {
      font-size: 0.9rem;
      line-height: 1.3;
    }

    .book-tags {
      gap: 0.35rem;
    }

    .badge {
      font-size: 0.7rem;
      padding: 0.2rem 0.5rem;
    }

    .book-meta {
      width: 100%;
      display: grid;
      grid-template-columns: auto auto;
      justify-content: start;
      align-items: center;
      gap: 0.4rem 0.9rem;
      margin-top: 0.25rem;
    }

    .star-rating {
      font-size: 0.8rem;
    }

    .book-descargas {
      font-size: 0.8rem;
    }

    .book-edad {
      font-size: 0.8rem;
      grid-column: 1 / -1;
    }

    .book-meta svg,
    .book-edad svg {
      width: 0.9rem;
      height: 0.9rem;
    }
  }

  .book-h-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .book-h-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .book-h-link {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    padding: 1rem;
  }

  .book-h-thumb {
    width: 72px;
    min-width: 72px;
    height: 90px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .h-cover-icon {
    font-size: 2rem;
    opacity: 0.7;
  }

  .h-cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .book-h-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .book-h-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-end;
    color: var(--color-text-muted);
    font-weight: 700;
    min-width: 56px;
  }

  @media (max-width: 640px) {
    .book-h-link {
      gap: 0.75rem;
