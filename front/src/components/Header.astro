---
const navLinks = [
  { label: "Biblioteca", href: "/#biblioteca" },
  { label: "Autores", href: "/#autores" },
  { label: "Galería Familiar", href: "/#galeria" },
  { label: "Recursos", href: "/#recursos" },
  { label: "Apoyar", href: "/apoyar" },
];
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="FamiliaLee inicio">
      <div class="logo-image">
          <img src="/logos/logo.png" alt="CBI Personitas Biblioteca" />
      </div>
      <span class="logo-text">
         <span class="logo-line-1">CBI Personitas</span>
  <span class="logo-line-2">Biblioteca</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navegación principal">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li><a href={link.href} class="nav-link">{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="btn-icon" aria-label="Buscar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </button>
      
      <!-- Auth actions (mostrar si NO está logueado) -->
      <div id="auth-actions" class="auth-actions">
        <a href="/auth/login" class="btn-outline">
          🔑 Ingresar
        </a>
        <a href="/auth/registro" class="btn-primary">✨ Registrarse ✨</a>
      </div>

      <!-- User menu (mostrar si está logueado) -->
      <div id="user-menu" class="user-menu" style="display: none;">
        <button class="profile-btn" aria-label="Menú de usuario" aria-expanded="false">
          <div class="avatar">
            <span id="avatar-inicial">U</span>
          </div>
        </button>
        <div class="dropdown-menu">
          <a href="/perfil" class="menu-item">
            👤 Mi Perfil
          </a>
          <button id="logout-btn" class="menu-item logout">
            👋 Cerrar sesión
          </button>
        </div>
      </div>
    </div>

    <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" id="menu-toggle">
      <span></span><span></span><span></span>
    </button>

    <!-- Mobile Menu -->
    <nav class="mobile-menu" id="mobile-menu" aria-label="Menú principal móvil">
      <button class="mobile-menu-link mobile-search" aria-label="Buscar">
        🔎 Buscar
      </button>
      <a href="/#biblioteca" class="mobile-menu-link">📚 Biblioteca</a>
      <a href="/#autores" class="mobile-menu-link">✍️ Autores</a>
      <a href="/#galeria" class="mobile-menu-link">🎨 Galería Familiar</a>
      <a href="/#recursos" class="mobile-menu-link">📖 Recursos</a>
      <a href="/apoyar" class="mobile-menu-link">Apoyar la biblioteca</a>
      
      <!-- Mobile Auth Actions -->
      <div id="mobile-auth" class="mobile-auth-buttons">
        <a href="/auth/login" class="btn-outline">🔑 Ingresar</a>
        <a href="/auth/registro" class="btn-primary">✨ Registrar</a>
      </div>

      <!-- Mobile User Menu -->
      <div id="mobile-user-menu" style="display: none;">
        <a href="/perfil" class="mobile-menu-link">👤 Mi Perfil</a>
        <button id="mobile-logout-btn" class="mobile-menu-link logout">👋 Cerrar sesión</button>
      </div>
    </nav>

  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(29, 41, 74, 0.08);
    box-shadow: 0 8px 30px rgba(29, 41, 74, 0.04);
    --header-height: 80px;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: var(--header-height);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .logo-image {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 54px;
    height: 54px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(255, 164, 87, 0.14), rgba(78, 160, 255, 0.12));
    box-shadow: 0 8px 20px rgba(78, 160, 255, 0.12);
  }

  .logo-image img {
    width: 42px;
    height: 42px;
    object-fit: contain;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1;
    user-select: none;
  }

  .logo-line-1,
  .logo-line-2 {
    font-family: var(--font-serif);
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-navy-light), var(--color-primary-pink), var(--color-primary-blue));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .logo-line-1 {
    font-size: 1.02rem;
    letter-spacing: 0.04em;
  }

  .logo-line-2 {
    font-size: 1.45rem;
    letter-spacing: 0.08em;
    margin-top: 0.2rem;
  }

  .nav {
    flex: 1;
  }

  .nav-list {
    list-style: none;
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: center;
  }

  .nav-link {
    font-size: 0.94rem;
    color: var(--color-text);
    font-weight: 600;
    transition: color 0.2s ease, transform 0.2s ease;
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-primary-pink);
    transform: translateY(-1px);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: var(--color-text-muted);
    background: rgba(78, 160, 255, 0.08);
    border: 1px solid rgba(78, 160, 255, 0.12);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-icon:hover {
    background: rgba(255, 95, 156, 0.08);
    color: var(--color-primary-pink);
  }

  .auth-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .btn-outline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.72rem 1.2rem;
    border: 1.5px solid rgba(78, 160, 255, 0.35);
    border-radius: 14px;
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--color-navy);
    background: rgba(255, 255, 255, 0.8);
    transition: all 0.2s ease;
  }

  .btn-outline:hover {
    background: rgba(78, 160, 255, 0.08);
    transform: translateY(-1px);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    background: linear-gradient(135deg, var(--color-primary-pink), var(--color-primary-red));
    color: var(--color-white);
    border: none;
    border-radius: 14px;
    font-size: 0.94rem;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 12px 24px rgba(255, 95, 156, 0.22);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 28px rgba(255, 95, 156, 0.28);
  }

  .user-menu {
    position: relative;
  }

  .profile-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary-blue), var(--color-primary-purple), var(--color-primary-pink));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-white);
    font-weight: 700;
    font-size: 1.1rem;
    box-shadow: 0 10px 18px rgba(125, 90, 233, 0.24);
    transition: transform 0.3s;
  }

  .profile-btn:hover .avatar {
    transform: scale(1.08);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    background: var(--color-white);
    border: 1px solid rgba(29, 41, 74, 0.08);
    border-radius: 16px;
    box-shadow: var(--shadow-md);
    min-width: 200px;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .profile-btn[aria-expanded="true"] ~ .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .menu-item {
    display: block;
    width: 100%;
    padding: 0.8rem 1.2rem;
    border: none;
    background: none;
    text-align: left;
    color: var(--color-text);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--font-sans);
  }

  .menu-item:hover {
    background: rgba(255, 111, 97, 0.05);
    padding-left: 1.4rem;
  }

  .menu-item.logout {
    color: var(--color-primary-red);
    border-top: 1px solid rgba(29, 41, 74, 0.08);
    font-weight: 700;
  }

  .menu-item.logout:hover {
    background: rgba(255, 109, 90, 0.06);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
  }

  .menu-toggle span {
    display: block;
    width: 24px;
    height: 3px;
    background: var(--color-navy);
    border-radius: 2px;
    transition: all 0.3s;
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    border-bottom: 1px solid rgba(29, 41, 74, 0.08);
    flex-direction: column;
    gap: 0;
    z-index: 999;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-out;
  }

  .mobile-menu.active {
    max-height: 600px;
  }

  .mobile-menu-link {
    display: block;
    padding: 1.15rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background 0.2s ease;
  }

  .mobile-search {
    width: 100%;
  }

  .mobile-menu-link:hover {
    background: rgba(255, 95, 156, 0.04);
    padding-left: 1.8rem;
  }

  .mobile-menu-link.logout {
    color: var(--color-primary-red);
  }

  .mobile-auth-buttons {
    display: flex;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    border-top: 3px solid var(--color-primary-blue);
  }

  .mobile-auth-buttons .btn-outline,
  .mobile-auth-buttons .btn-primary {
    flex: 1;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .header-inner {
      --header-height: 56px;
      gap: 0.75rem;
    }

    .logo-emoji {
      font-size: 1.5rem;
    }

    .logo {
      gap: 0.3rem;
    }

    .nav {
      display: none;
    }

    .header-actions {
      display: none;
    }

    .menu-toggle {
      display: flex;
      margin-left: 0;
    }

    .mobile-menu {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      --header-height: 52px;
    }

    .logo-emoji {
      font-size: 1.3rem;
    }

    .menu-toggle {
      gap: 4px;
      padding: 0.35rem;
    }

    .menu-toggle span {
      width: 20px;
      height: 2px;
    }

    .mobile-menu-link {
      padding: 1rem 1.25rem;
      font-size: 0.95rem;
    }

    .mobile-auth-buttons {
      padding: 0.85rem 1.25rem;
      gap: 0.5rem;
      flex-direction: column;
    }
  }
</style>

<script>
  import { getUsuario, logout } from '../utils/api';

  // Mobile Menu Toggle
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  menuToggle?.addEventListener('click', () => {
    const isActive = mobileMenu?.classList.toggle('active');
    menuToggle?.setAttribute('aria-expanded', isActive ? 'true' : 'false');
  });

  // Keep the menu state consistent when switching between mobile and desktop
  window.addEventListener('resize', () => {
    if (window.innerWidth > 900) {
      mobileMenu?.classList.remove('active');
      menuToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // Close mobile menu when tapping outside of the toggle/menu
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (!mobileMenu?.contains(target) && !menuToggle?.contains(target)) {
      mobileMenu?.classList.remove('active');
      menuToggle?.setAttribute('aria-expanded', 'false');
    }
  });

  // Close mobile menu when clicking a link
  document.querySelectorAll('.mobile-menu-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('active');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // Check if user is logged in
  const usuario = getUsuario();
  const authActions = document.getElementById('auth-actions');
  const userMenu = document.getElementById('user-menu');
  const mobileAuth = document.getElementById('mobile-auth');
  const mobileUserMenu = document.getElementById('mobile-user-menu');
  const logoutBtn = document.getElementById('logout-btn');
  const mobileLogoutBtn = document.getElementById('mobile-logout-btn');
  const avatarInicial = document.getElementById('avatar-inicial');
  const profileBtn = document.querySelector('.profile-btn') as HTMLButtonElement;

  if (usuario) {
    authActions!.style.display = 'none';
    userMenu!.style.display = 'block';
    mobileAuth!.style.display = 'none';
    mobileUserMenu!.style.display = 'block';

    const inicial = usuario.nombre?.charAt(0).toUpperCase() || 'U';
    avatarInicial!.textContent = inicial;

    // Toggle dropdown menu on profile button click
    profileBtn?.addEventListener('click', () => {
      const isExpanded = profileBtn.getAttribute('aria-expanded') === 'true';
      profileBtn.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
    });

    // Close dropdown when clicking elsewhere
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!userMenu?.contains(target)) {
        profileBtn?.setAttribute('aria-expanded', 'false');
      }
    });

    logoutBtn?.addEventListener('click', () => {
      logout();
      window.location.reload();
    });

    mobileLogoutBtn?.addEventListener('click', () => {
      logout();
      window.location.reload();
    });
  } else {
    authActions!.style.display = 'flex';
    userMenu!.style.display = 'none';
    mobileAuth!.style.display = 'flex';
    mobileUserMenu!.style.display = 'none';
  }
</script>
