<dialog class="legal-policy-dialog" id="legal-policy-dialog" aria-label="Información legal">
  <button class="legal-policy-close" type="button" aria-label="Cerrar ventana">×</button>
  <div class="legal-policy-content" id="legal-policy-content" aria-live="polite">
    <p class="legal-policy-status">Cargando información…</p>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('legal-policy-dialog');
  const content = document.getElementById('legal-policy-content');
  const closeButton = dialog?.querySelector('.legal-policy-close');
  const allowedPaths = new Set(['/terminos', '/privacidad']);

  if (dialog instanceof HTMLDialogElement && content && closeButton instanceof HTMLButtonElement) {
    let activeRequest = 0;

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('click', async (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const link = target.closest<HTMLAnchorElement>('a[href]');
      if (!link) return;

      const destination = new URL(link.href, window.location.href);
      if (destination.origin !== window.location.origin || !allowedPaths.has(destination.pathname)) return;

      event.preventDefault();
      const requestId = ++activeRequest;
      content.innerHTML = '<p class="legal-policy-status">Cargando información…</p>';
      if (!dialog.open) dialog.showModal();

      try {
        const response = await fetch(destination.pathname, {
          headers: { Accept: 'text/html' },
          signal: AbortSignal.timeout(15000),
        });
        if (!response.ok) throw new Error(`No se pudo cargar la página (${response.status}).`);

        const page = new DOMParser().parseFromString(await response.text(), 'text/html');
        const policy = page.querySelector<HTMLElement>('.policy-page');
        if (!policy) throw new Error('La página no contiene el documento solicitado.');
        if (requestId !== activeRequest) return;

        const title = policy.querySelector('h1')?.textContent?.trim() || 'Información legal';
        dialog.setAttribute('aria-label', title);
        policy.querySelector('.policy-back')?.remove();
        const contentNode = document.createElement('div');
        contentNode.className = 'policy-page';
        contentNode.append(...Array.from(policy.childNodes, (node) => document.importNode(node, true)));
        content.replaceChildren(contentNode);
        content.scrollTop = 0;
        closeButton.focus();
      } catch (error) {
        if (requestId !== activeRequest) return;
        console.error('No se pudo abrir la información legal en el modal.', error);
        content.innerHTML = '<p class="legal-policy-status" role="alert">No se pudo cargar la información. Intenta de nuevo o recarga la página.</p>';
      }
    });
  }
</script>

<style is:global>
  .legal-policy-dialog {
    position: fixed;
    inset: 50% auto auto 50%;
    width: min(920px, calc(100vw - 2rem));
    max-width: none;
    max-height: min(90dvh, 900px);
    padding: 0;
    overflow: auto;
    transform: translate(-50%, -50%);
    border: 0;
    border-radius: 22px;
    color: #26334c;
    background: #fff;
    box-shadow: 0 24px 80px rgba(13, 30, 48, 0.3);
  }

  .legal-policy-dialog::backdrop { background: rgba(15, 30, 48, 0.58); backdrop-filter: blur(4px); }
  .legal-policy-dialog[open] { animation: legal-policy-enter 180ms ease-out; }
  .legal-policy-close { position: sticky; z-index: 1; top: 0.8rem; float: right; display: grid; width: 40px; height: 40px; margin: 0.8rem 0.8rem -3.4rem 0; place-items: center; border: 1px solid #e3ecef; border-radius: 50%; color: #52647a; background: #fff; cursor: pointer; font-size: 1.65rem; line-height: 1; }
  .legal-policy-close:hover { color: #087d72; background: #f2fbf8; }
  .legal-policy-content { min-height: 12rem; }
  .legal-policy-content .policy-page { width: min(100% - 2rem, 920px); margin: 0 auto; padding: 2rem 0 3rem; color: #26334c; }
  .legal-policy-content .policy-header { max-width: 760px; margin-bottom: 2rem; }
  .legal-policy-content .policy-back { color: #119d91; font-size: 0.9rem; font-weight: 600; text-decoration: none; }
  .legal-policy-content .policy-kicker { margin-top: 1.3rem; color: #119d91; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.16em; }
  .legal-policy-content h1 { margin-top: 0.65rem; font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.08; letter-spacing: -0.05em; }
  .legal-policy-content .policy-intro { max-width: 680px; margin-top: 1rem; color: #607087; font-size: 1.02rem; line-height: 1.7; }
  .legal-policy-content .policy-updated { margin-top: 1rem; color: #7d8da3; font-size: 0.82rem; }
  .legal-policy-content .policy-toc { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 1.5rem 0; padding: 0.9rem; border: 1px solid #e3ecef; border-radius: 16px; background: #f7fbfa; }
  .legal-policy-content .policy-toc a { padding: 0.45rem 0.7rem; border-radius: 999px; color: #147f77; background: #e8f7f3; font-size: 0.8rem; text-decoration: none; }
  .legal-policy-content .policy-content { display: grid; gap: 1.6rem; }
  .legal-policy-content .policy-content section { scroll-margin-top: 1rem; }
  .legal-policy-content h2 { margin-bottom: 0.65rem; font-size: clamp(1.15rem, 3vw, 1.45rem); letter-spacing: -0.02em; }
  .legal-policy-content .policy-content p,
  .legal-policy-content .policy-content li { color: #52647a; font-size: 0.94rem; line-height: 1.75; }
  .legal-policy-content .policy-content p + p { margin-top: 0.75rem; }
  .legal-policy-content .policy-content ul { display: grid; gap: 0.45rem; margin: 0.75rem 0 0 1.2rem; }
  .legal-policy-content .policy-content a { color: #108d83; font-weight: 600; }
  .legal-policy-content .policy-note { padding: 1rem 1.1rem; border-left: 4px solid #f3bb4e; border-radius: 8px; color: #52647a; background: #fff8e9; font-size: 0.9rem; line-height: 1.65; }
  .legal-policy-status { padding: 4rem 1.5rem; color: #52647a; text-align: center; }

  @keyframes legal-policy-enter {
    from { opacity: 0; transform: translate(-50%, -48%); }
    to { opacity: 1; transform: translate(-50%, -50%); }
  }

  @media (max-width: 600px) {
    .legal-policy-dialog { width: calc(100vw - 1rem); max-height: 94dvh; border-radius: 16px; }
    .legal-policy-content .policy-page { width: calc(100% - 1.5rem); padding-top: 1.5rem; }
    .legal-policy-content .policy-toc { gap: 0.4rem; padding: 0.7rem; }
    .legal-policy-content .policy-toc a { font-size: 0.74rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal-policy-dialog[open] { animation: none; }
  }
</style>
