---
interface Props {
  apiUrl?: string;
}

const { apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api' } = Astro.props;
---

<div id="communityUploadModal" class="upload-modal" hidden aria-hidden="true">
  <div class="upload-modal-backdrop" data-close-upload-modal></div>
  <div class="upload-modal-card" role="dialog" aria-modal="true" aria-labelledby="uploadModalTitle">
    <button type="button" class="upload-modal-close" data-close-upload-modal aria-label="Cerrar">×</button>

    <header class="upload-modal-heading">
      <span class="upload-modal-kicker">Galería familiar</span>
      <h3 id="uploadModalTitle" class="upload-modal-title">Compartir con la comunidad</h3>
      <p class="upload-modal-subtitle" id="uploadModalSubtitle">Elige qué deseas publicar.</p>
    </header>

    <form id="communityUploadForm" class="upload-modal-form">
      <input type="hidden" id="uploadMode" value="comentario" />

      <label class="upload-field" id="fieldAutor">
        <span>Autor</span>
        <input id="nombreAutorInput" type="text" maxlength="120" autocomplete="name" readonly required />
       </label>

      <label class="upload-field" id="fieldTitulo" hidden>
        <span>Título del video</span>
        <input id="tituloInput" type="text" maxlength="180" placeholder="Ej: Devocional en casa" />
      </label>

      <label class="upload-field" id="fieldCategoria" hidden>
        <span>Categoría</span>
        <input id="categoriaInput" type="text" maxlength="80" placeholder="Ej: Devoción" />
      </label>


      <label class="upload-field" id="fieldComentario">
        <span>Comentario</span>
        <textarea id="comentarioInput" rows="4" maxlength="2000" placeholder="Comparte tu experiencia..." required></textarea>
      </label>

      <label class="upload-field" id="fieldArchivo" hidden>
        <span id="archivoLabel">Archivo</span>
        <input id="archivoInput" type="file" />
        <small id="archivoHelp">Selecciona un archivo.</small>
      </label>

      <p class="upload-modal-status" id="uploadModalStatus" role="status" aria-live="polite"></p>

      <div class="upload-modal-actions">
        <button type="button" class="btn-secondary" data-close-upload-modal>Cancelar</button>
        <button type="submit" class="btn-primary" id="uploadSubmitBtn">Enviar</button>
      </div>
    </form>
  </div>
</div>

<script define:vars={{ apiUrl }}>
  (() => {
    const modal = document.getElementById('communityUploadModal');
    if (!modal) return;

    const form = document.getElementById('communityUploadForm');
    const modeInput = document.getElementById('uploadMode');
    const subtitle = document.getElementById('uploadModalSubtitle');
    const title = document.getElementById('uploadModalTitle');
    const status = document.getElementById('uploadModalStatus');
    const submitBtn = document.getElementById('uploadSubmitBtn');

    const fieldAutor = document.getElementById('fieldAutor');
    const fieldTitulo = document.getElementById('fieldTitulo');
    const fieldCategoria = document.getElementById('fieldCategoria');
    const fieldComentario = document.getElementById('fieldComentario');
    const fieldArchivo = document.getElementById('fieldArchivo');

    const nombreAutorInput = document.getElementById('nombreAutorInput');
    const tituloInput = document.getElementById('tituloInput');
    const categoriaInput = document.getElementById('categoriaInput');
    const comentarioInput = document.getElementById('comentarioInput');
    const archivoInput = document.getElementById('archivoInput');
    const archivoLabel = document.getElementById('archivoLabel');
    const archivoHelp = document.getElementById('archivoHelp');

    const allowedVideoTypes = [
      'video/mp4',
      'video/webm',
      'video/ogg',
      'video/quicktime',
      'video/x-m4v',
    ];

    const allowedImageTypes = [
      'image/jpeg',
      'image/png',
      'image/webp',
      'image/gif',
    ];

    function getFileExtension(file) {
      return file.name.split('.').pop()?.toLowerCase() || '';
    }

    function validateUploadFile(file, mode) {
      if (!file) return false;

      if (mode === 'video') {
        const extension = getFileExtension(file);
        if (!allowedVideoTypes.includes(file.type) && !['mp4', 'webm', 'ogg', 'mov', 'm4v'].includes(extension)) {
          throw new Error('El video debe ser MP4, WEBM, OGG, MOV o M4V.');
        }
        if (file.size > 80 * 1024 * 1024) {
          throw new Error('El video no puede superar 80 MB.');
        }
      }

      if (mode === 'foto') {
        const extension = getFileExtension(file);
        if (!allowedImageTypes.includes(file.type) && !['jpg', 'jpeg', 'png', 'webp', 'gif'].includes(extension)) {
          throw new Error('La imagen debe ser JPG, PNG, WEBP o GIF.');
        }
        if (file.size > 8 * 1024 * 1024) {
          throw new Error('La imagen no puede superar 8 MB.');
        }
      }

      return true;
    }

    function setFieldVisibility(el, visible) {
      if (!el) return;
      el.hidden = !visible;
      if (visible) {
        el.removeAttribute('hidden');
      } else {
        el.setAttribute('hidden', 'hidden');
      }
    }

    function setStatus(message, isError = false) {
      status.textContent = message || '';
      status.classList.toggle('error', Boolean(isError));
      status.classList.toggle('ok', !isError && Boolean(message));
    }

    function getAuthenticatedAuthor() {
      const usuarioRaw = localStorage.getItem('usuario');
      if (!usuarioRaw) return '';

      try {
        const usuario = JSON.parse(usuarioRaw);
        return [usuario?.nombre, usuario?.apellido]
          .filter((part) => typeof part === 'string' && part.trim())
          .map((part) => part.trim())
          .join(' ');
      } catch (error) {
        console.error('No se pudo leer el usuario autenticado para la publicación.', error);
        return '';
      }
    }

    function requestLogin(message) {
      window.dispatchEvent(new CustomEvent('auth:required', {
        detail: { title: 'Inicio de sesión requerido', message },
      }));
    }

    function openModal(mode) {
      if (!localStorage.getItem('token')) {
        requestLogin('Debes iniciar sesión para publicar contenido en la galería.');
        return;
      }

      const author = getAuthenticatedAuthor();
      if (!author) {
        requestLogin('No pudimos identificar tu cuenta. Inicia sesión nuevamente para publicar.');
        return;
      }

      const currentMode = mode || 'comentario';
      modeInput.value = currentMode;
      setStatus('');
      form.reset();

      setFieldVisibility(fieldAutor, true);
      setFieldVisibility(fieldTitulo, currentMode === 'video');
      setFieldVisibility(fieldCategoria, currentMode === 'video');
      setFieldVisibility(fieldArchivo, currentMode !== 'comentario');
      setFieldVisibility(fieldComentario, currentMode !== 'video');
      nombreAutorInput.value = author;

      comentarioInput.required = currentMode === 'comentario';
      tituloInput.required = currentMode === 'video';
      archivoInput.required = currentMode !== 'comentario';
      nombreAutorInput.required = true;

      if (currentMode === 'video') {
        title.textContent = 'Subir video';
        subtitle.textContent = 'Comparte un video para publicarlo en la galería.';
        archivoLabel.textContent = 'Archivo de video';
        archivoHelp.textContent = 'Formatos permitidos: MP4, WEBM, OGG, MOV, M4V (máx. 80MB).';
        archivoInput.accept = 'video/mp4,video/webm,video/ogg,video/quicktime,video/x-m4v,.mov,.m4v';
      } else if (currentMode === 'foto') {
        title.textContent = 'Subir foto';
        subtitle.textContent = 'Comparte una imagen familiar. El comentario es opcional.';
        archivoLabel.textContent = 'Imagen';
        archivoHelp.textContent = 'Formatos permitidos: JPG, PNG, WEBP, GIF (máx. 8MB).';
        archivoInput.accept = 'image/jpeg,image/png,image/webp,image/gif';
        comentarioInput.required = false;
      } else {
        title.textContent = 'Compartir comentario';
        subtitle.textContent = 'Escribe un testimonio para la comunidad.';
      }

      archivoInput.value = '';
      setStatus('');

      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('modal-open');
      window.setTimeout(() => {
        if (currentMode === 'video') {
          tituloInput.focus();
        } else {
          comentarioInput.focus();
        }
      }, 20);
    }

    archivoInput.addEventListener('change', () => {
      const file = archivoInput.files?.[0];
      if (!file) {
        setStatus('');
        return;
      }

      try {
        validateUploadFile(file, modeInput.value);
        setStatus('Archivo listo para publicar.');
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Formato de archivo no válido.', true);
        archivoInput.value = '';
      }
    });

    function closeModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('modal-open');
      setStatus('');
    }

    async function fileToBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ''));
        reader.onerror = () => reject(new Error('No se pudo leer el archivo.'));
        reader.readAsDataURL(file);
      });
    }

    function getVideoDuration(file) {
      return new Promise((resolve) => {
        const url = URL.createObjectURL(file);
        const tempVideo = document.createElement('video');
        tempVideo.preload = 'metadata';
        tempVideo.src = url;
        tempVideo.onloadedmetadata = () => {
          URL.revokeObjectURL(url);
          const totalSeconds = Math.round(tempVideo.duration || 0);
          const minutes = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
          const seconds = (totalSeconds % 60).toString().padStart(2, '0');
          resolve(`${minutes}:${seconds}`);
        };
        tempVideo.onerror = () => {
          URL.revokeObjectURL(url);
          resolve(null);
        };
      });
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const openBtn = target.closest('.js-open-upload');
      if (openBtn) {
        event.preventDefault();
        const mode = openBtn.getAttribute('data-upload-type') || 'comentario';
        openModal(mode);
        return;
      }

      if (target.closest('[data-close-upload-modal]')) {
        event.preventDefault();
        closeModal();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.hidden) closeModal();
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const mode = modeInput.value;
      const token = localStorage.getItem('token');

      if (!token) {
        requestLogin('Debes iniciar sesión para publicar contenido en la galería.');
        return;
      }

      const nombreAutor = getAuthenticatedAuthor();
      if (!nombreAutor) {
        requestLogin('No pudimos identificar tu cuenta. Inicia sesión nuevamente para publicar.');
        return;
      }
      nombreAutorInput.value = nombreAutor;
      const comentario = String(comentarioInput.value || '').trim();

      submitBtn.disabled = true;
      setStatus('Enviando...');

      try {
        let endpoint = '';
        let payload = {};

        if (mode === 'video') {
          const titulo = String(tituloInput.value || '').trim();
          if (!titulo) throw new Error('El título del video es obligatorio.');

          const file = archivoInput.files?.[0];
          if (!file) throw new Error('Selecciona un video.');
          validateUploadFile(file, 'video');

          const fileBase64 = await fileToBase64(file);
          const duracion = await getVideoDuration(file);
          endpoint = `${apiUrl}/videos/propuesta`;
          payload = {
            titulo,
            categoria: String(categoriaInput.value || '').trim() || 'Comunidad',
            duracion,
            fileName: file.name,
            fileBase64,
            mimeType: file.type,
          };
        } else if (mode === 'foto') {
          const file = archivoInput.files?.[0];
          if (!file) throw new Error('Selecciona una imagen.');
          validateUploadFile(file, 'foto');

          const fileBase64 = await fileToBase64(file);
          endpoint = `${apiUrl}/galeria`;
          payload = {
            nombre_familia: nombreAutor,
            texto: comentario || '',
            tipo: 'foto',
            fileName: file.name,
            fileBase64,
            mimeType: file.type,
          };
        } else {
          if (!comentario) throw new Error('El comentario es obligatorio.');

          endpoint = `${apiUrl}/galeria`;
          payload = {
            nombre_familia: nombreAutor,
            texto: comentario,
            tipo: 'testimonio',
          };
        }

        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify(payload),
        });

        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(data?.error || 'No se pudo completar la publicación.');
        }

        setStatus(data?.mensaje || 'Contenido enviado correctamente.');

        // Notificar a los componentes para que se refresquen.
        window.dispatchEvent(new CustomEvent('community:uploaded', { detail: { mode } }));

        window.setTimeout(() => {
          closeModal();
        }, 900);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Error inesperado.', true);
      } finally {
        submitBtn.disabled = false;
      }
    });
  })();
</script>

<style>
  .upload-modal[hidden] {
    display: none;
  }

  .upload-modal {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .upload-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(24, 39, 61, 0.52);
    backdrop-filter: blur(6px);
  }

  .upload-modal-card {
    position: relative;
    width: min(600px, calc(100vw - 2rem));
    max-height: min(92vh, 820px);
    overflow: auto;
    background: #fff;
    border: 1px solid rgba(220, 235, 232, 0.9);
    border-radius: 26px;
    box-shadow: 0 28px 80px rgba(32, 48, 75, 0.25);
    padding: 1.5rem;
  }

  .upload-modal-close {
    position: absolute;
    z-index: 1;
    top: 0.85rem;
    right: 0.85rem;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(220, 235, 232, 0.9);
    border-radius: 50%;
    background: rgba(255,255,255,0.82);
    font-size: 1.55rem;
    line-height: 1;
    color: #607889;
    cursor: pointer;
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .upload-modal-close:hover {
    background: #fff;
    transform: rotate(90deg);
  }

  .upload-modal-heading {
    margin: -1.5rem -1.5rem 1.25rem;
    padding: 1.65rem 4rem 1.25rem 1.5rem;
    border-bottom: 1px solid #e6f0ed;
    border-radius: 26px 26px 0 0;
    background: linear-gradient(135deg, #eaf7f4 0%, #f5fbf9 58%, #fff4e8 100%);
  }

  .upload-modal-kicker {
    display: inline-flex;
    margin-bottom: 0.55rem;
    padding: 0.28rem 0.7rem;
    border: 1px solid rgba(59,127,134,0.12);
    border-radius: 999px;
    background: rgba(255,255,255,0.72);
    color: #3b7f86;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .upload-modal-title {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 4vw, 1.7rem);
    line-height: 1.2;
    color: #2d405d;
    margin: 0;
  }

  .upload-modal-subtitle {
    margin: 0.45rem 0 0;
    color: #607889;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .upload-modal-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .upload-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .upload-field > span {
    font-size: 0.88rem;
    font-weight: 800;
    color: #2d405d;
  }

  .upload-field input,
  .upload-field textarea {
    width: 100%;
    border: 1px solid #dce8e7;
    border-radius: 14px;
    background: #fff;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    padding: 0.8rem 0.9rem;
    color: #2d405d;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  .upload-field input:focus,
  .upload-field textarea:focus {
    outline: none;
    border-color: #69aaa7;
    box-shadow: 0 0 0 4px rgba(59,127,134,0.12);
  }

  .upload-field input[readonly] {
    background: #f3faf8;
    color: #3b7f86;
    font-weight: 700;
    cursor: default;
  }

  .upload-field input[type="file"] {
    padding: 0.55rem;
    background: #f8fbfa;
    color: #607889;
    font-size: 0.86rem;
  }

  .upload-field input[type="file"]::file-selector-button {
    margin-right: 0.8rem;
    padding: 0.55rem 0.8rem;
    border: 0;
    border-radius: 999px;
    background: #e5f3f0;
    color: #347d7c;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .upload-field textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.55;
  }

  .upload-field small {
    color: #718797;
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .upload-modal-status {
    margin: 0;
    min-height: 1.35rem;
    font-size: 0.88rem;
    color: #607889;
    line-height: 1.5;
  }

  .upload-modal-status.error {
    color: #b43e3e;
  }

  .upload-modal-status.ok {
    color: #2f8062;
  }

  .upload-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.7rem;
    padding-top: 0.45rem;
  }

  .btn-primary,
  .btn-secondary {
    min-height: 44px;
    border: 1px solid #dce8e7;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 800;
    font-family: var(--font-sans);
    padding: 0.65rem 1.15rem;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  .btn-primary {
    border-color: #f06641;
    background: #f06641;
    color: var(--color-white);
    box-shadow: 0 8px 18px rgba(240,102,65,0.2);
  }

  .btn-primary:hover:not(:disabled) {
    background: #d95735;
    transform: translateY(-1px);
    box-shadow: 0 11px 22px rgba(229,86,47,0.25);
  }

  .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-secondary {
    background: #fff;
    color: #607889;
  }

  .btn-secondary:hover {
    background: #f3faf8;
    transform: translateY(-1px);
  }

  @media (max-width: 520px) {
    .upload-modal { padding: 0.65rem; }
    .upload-modal-card { width: 100%; max-height: 94vh; padding: 1.1rem; border-radius: 22px; }
    .upload-modal-heading { margin: -1.1rem -1.1rem 1rem; padding: 1.35rem 3.5rem 1rem 1.1rem; border-radius: 22px 22px 0 0; }
    .upload-modal-close { top: 0.65rem; right: 0.65rem; }
    .upload-modal-actions { flex-direction: column-reverse; }
    .upload-modal-actions button { width: 100%; }
  }

  :global(body.modal-open) {
    overflow: hidden;
  }
</style>
