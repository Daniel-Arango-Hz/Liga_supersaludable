---
interface Props {
  libroSlug: string;
  libroTitulo: string;
  pdfUrl?: string;
}

const { libroSlug, libroTitulo, pdfUrl } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';
---

<div class="libro-actions-row">
  <button class="btn-leer-lg" id="btn-leer" data-libro-slug={libroSlug} data-libro-titulo={libroTitulo}>
    📖 Leer en línea
  </button>
  <button class="btn-dl-lg" id="btn-descargar" data-libro-slug={libroSlug} data-pdf-url={pdfUrl || ''}>
    ⬇️ Descargar PDF
  </button>
  <button class="btn-save-lg" id="btn-guardar" data-libro-slug={libroSlug} aria-label="Guardar">
    ❤️
  </button>
</div>

<script define:vars={{ libroSlug, libroTitulo, apiUrl }}>
  function onReady(callback) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', callback);
    } else {
      callback();
    }
  }

  function dispatchBookUpdate(detail) {
    window.dispatchEvent(new CustomEvent('book:update', { detail }));
  }

  onReady(() => {
    const btnLeer = document.getElementById('btn-leer');
    const btnDescargar = document.getElementById('btn-descargar');
    const btnGuardar = document.getElementById('btn-guardar');

    // Obtener token del localStorage
    function getToken() {
      return localStorage.getItem('token');
    }

    function setGuardarState(isGuardado) {
      if (!btnGuardar) return;

      if (isGuardado) {
        btnGuardar.classList.add('guardado');
        btnGuardar.textContent = '❤️ Guardado';
        btnGuardar.setAttribute('aria-label', 'Quitar de guardados');
      } else {
        btnGuardar.classList.remove('guardado');
        btnGuardar.textContent = '❤️ Guardar';
        btnGuardar.setAttribute('aria-label', 'Guardar libro');
      }
    }

    // Obtener headers con autenticación
    function getAuthHeaders() {
      const token = getToken();
      const headers = {
        'Content-Type': 'application/json',
      };
      if (token) {
        headers['Authorization'] = `Bearer ${token}`;
      }
      return headers;
    }

    async function hydrateGuardarState() {
      if (!btnGuardar) return;
      const token = getToken();
      if (!token) {
        setGuardarState(false);
        return;
      }

      try {
        const response = await fetch(`${apiUrl}/libros/${libroSlug}`, {
          headers: {
            Authorization: `Bearer ${token}`,
          },
        });

        if (!response.ok) {
          setGuardarState(false);
          return;
        }

        const data = await response.json();
        setGuardarState(Boolean(data?.guardado));
      } catch (error) {
        console.warn('No se pudo cargar estado de guardado:', error);
        setGuardarState(false);
      }
    }

    // Leer en línea
    if (btnLeer) {
      btnLeer.addEventListener('click', async () => {
        window.location.href = `/libro/${libroSlug}/leer`;
      });
    }

    // Descargar PDF
    if (btnDescargar) {
      btnDescargar.addEventListener('click', async () => {
        try {
          btnDescargar.disabled = true;
          btnDescargar.textContent = '⏳ Descargando...';

          const token = getToken();
          if (!token) {
            const modal = document.getElementById('loginModalOverlay');
            if (modal) {
              modal.classList.add('active');
              const titleEl = document.getElementById('modalTitle');
              const msgEl = document.getElementById('modalMessage');
              if (titleEl) titleEl.textContent = 'Descargar libros';
              if (msgEl) msgEl.textContent = 'Debes iniciar sesión para descargar libros. 📚';
              btnDescargar.disabled = false;
              btnDescargar.textContent = '⬇️ Descargar PDF';
            }
            return;
          }

          // Primero, registrar la descarga
          const response = await fetch(`${apiUrl}/libros/${libroSlug}/descargar`, {
            method: 'POST',
            headers: getAuthHeaders(),
          });

          if (response.status === 401) {
            const modal = document.getElementById('loginModalOverlay');
            if (modal) {
              modal.classList.add('active');
              const titleEl = document.getElementById('modalTitle');
              const msgEl = document.getElementById('modalMessage');
              if (titleEl) titleEl.textContent = 'Sesión expirada';
              if (msgEl) msgEl.textContent = 'Tu sesión ha expirado. Por favor, inicia sesión de nuevo. 🔐';
            }
            btnDescargar.disabled = false;
            btnDescargar.textContent = '⬇️ Descargar PDF';
            return;
          }

          if (!response.ok) throw new Error('Error en descarga');

          const data = await response.json();

          // Descargar el PDF usando la URL retornada por el servidor
          const pdfUrl = data.pdfUrl || `/api/libros/${libroSlug}/pdf`;
          const link = document.createElement('a');
          link.href = pdfUrl;
          link.download = `${libroTitulo}.pdf`;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);

          // Actualizar contador de descargas
          const descargasEl = document.getElementById('descargas-count');
          if (descargasEl && data.descargas_total !== undefined) {
            descargasEl.textContent = data.descargas_total.toLocaleString('es');
          }

          dispatchBookUpdate({ slug: libroSlug, descargas_total: data.descargas_total });

          btnDescargar.textContent = '✓ Descargado';
          setTimeout(() => {
            btnDescargar.textContent = '⬇️ Descargar PDF';
            btnDescargar.disabled = false;
          }, 2000);
        } catch (error) {
          console.error('Error al descargar:', error);
          const modal = document.getElementById('loginModalOverlay');
          if (modal) {
            modal.classList.add('active');
            const titleEl = document.getElementById('modalTitle');
            const msgEl = document.getElementById('modalMessage');
            if (titleEl) titleEl.textContent = 'Error';
            if (msgEl) msgEl.textContent = 'Error al descargar. Intenta de nuevo.';
          }
          btnDescargar.textContent = '⬇️ Descargar PDF';
          btnDescargar.disabled = false;
        }
      });
    }

    // Guardar/Like
    if (btnGuardar) {
      setGuardarState(false);
      hydrateGuardarState();

      btnGuardar.addEventListener('click', async () => {
        try {
          const token = getToken();
          if (!token) {
            const modal = document.getElementById('loginModalOverlay');
            if (modal) {
              modal.classList.add('active');
              const titleEl = document.getElementById('modalTitle');
              const msgEl = document.getElementById('modalMessage');
              if (titleEl) titleEl.textContent = 'Guardar libros';
              if (msgEl) msgEl.textContent = 'Debes iniciar sesión para guardar libros. ❤️';
            }
            return;
          }

          btnGuardar.disabled = true;

          const response = await fetch('/api/guardar', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ libroSlug }),
          });

          if (response.status === 401) {
            const modal = document.getElementById('loginModalOverlay');
            if (modal) {
              modal.classList.add('active');
              const titleEl = document.getElementById('modalTitle');
              const msgEl = document.getElementById('modalMessage');
              if (titleEl) titleEl.textContent = 'Sesión expirada';
              if (msgEl) msgEl.textContent = 'Tu sesión ha expirado. Por favor, inicia sesión de nuevo. 🔐';
            }
            btnGuardar.disabled = false;
            return;
          }

          if (!response.ok) throw new Error('Error al guardar');

          const data = await response.json();
          const isGuardado = Boolean(data?.guardado);
          setGuardarState(isGuardado);
          dispatchBookUpdate({ slug: libroSlug, guardado: isGuardado });
        } catch (error) {
          console.error('Error:', error);
          const modal = document.getElementById('loginModalOverlay');
          if (modal) {
            modal.classList.add('active');
            const titleEl = document.getElementById('modalTitle');
            const msgEl = document.getElementById('modalMessage');
            if (titleEl) titleEl.textContent = 'Error';
            if (msgEl) msgEl.textContent = 'Error al guardar. Intenta de nuevo.';
          }
        } finally {
          if (btnGuardar) btnGuardar.disabled = false;
        }
      });
    }
  });
</script>

<style>
  .libro-actions-row {
    display: flex;
    gap: 1rem;
    margin: 2rem 0;
    flex-wrap: wrap;
  }

  .btn-leer-lg,
  .btn-dl-lg,
  .btn-save-lg {
    padding: 0.875rem 1.5rem;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: inherit;
  }

  .btn-leer-lg {
    background: linear-gradient(135deg, #ff006e, #ff4757);
    color: white;
    flex: 1;
    min-width: 150px;
  }

  .btn-leer-lg:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 0, 110, 0.3);
  }

  .btn-dl-lg {
    background: linear-gradient(135deg, #06a77d, #26de81);
    color: white;
    flex: 1;
    min-width: 150px;
  }

  .btn-dl-lg:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(6, 168, 125, 0.3);
  }

  .btn-save-lg {
    background: transparent;
    border: 2.5px solid var(--color-primary-pink, #ff006e);
    color: var(--color-primary-pink, #ff006e);
    padding: 0.75rem 1.25rem;
    font-size: 1.5rem;
  }

  .btn-save-lg:hover {
    background: rgba(255, 0, 110, 0.1);
    transform: scale(1.05);
  }

  .btn-save-lg.guardado {
    background: var(--color-primary-pink, #ff006e);
    color: white;
  }

  .btn-leer-lg:disabled,
  .btn-dl-lg:disabled,
  .btn-save-lg:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 680px) {
    .libro-actions-row {
      flex-direction: column;
      gap: 0.75rem;
    }

    .btn-leer-lg,
    .btn-dl-lg {
      flex: 1;
      min-width: unset;
    }

    .btn-save-lg {
      width: 100%;
    }
  }
</style>
