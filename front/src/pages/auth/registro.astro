    .form-row { grid-template-columns: 1fr 1fr; gap: 0.55rem; }
    .auth-content .form-input { padding-inline: 2.35rem 2rem; font-size: 0.8rem; }
    .field-icon { left: 0.7rem; }
  }
</style>

<script>
  import { completeGoogleAuth, registro, setAuth, startGoogleAuth } from '../../utils/api';

  const form = document.getElementById('registro-form') as HTMLFormElement;
  const nombreInput = document.getElementById('nombre') as HTMLInputElement;
  const apellidoInput = document.getElementById('apellido') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const terminosCheckbox = document.querySelector('input[name="terminos"]') as HTMLInputElement;
  const tipoRadios = document.querySelectorAll('input[name="tipo"]') as NodeListOf<HTMLInputElement>;
  const togglePwBtn = document.querySelector('.toggle-pw') as HTMLButtonElement;
  const errorDiv = document.getElementById('error-message') as HTMLDivElement;
  const successDiv = document.getElementById('success-message') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const googleBtn = document.getElementById('google-auth-btn') as HTMLButtonElement;

  googleBtn?.addEventListener('click', () => {
    if (!terminosCheckbox.checked) {
      errorDiv.textContent = 'Debes aceptar los términos y la política de privacidad';
      errorDiv.style.display = 'block';
      terminosCheckbox.focus();
      return;
    }

    const tipo = Array.from(tipoRadios).find((radio) => radio.checked)?.value;
    errorDiv.style.display = 'none';
    googleBtn.disabled = true;
    googleBtn.textContent = 'Conectando con Google...';
    startGoogleAuth('registro', tipo === 'autor' ? 'autor' : 'familia');
  });

  void completeGoogleAuth().catch((error: unknown) => {
    errorDiv.textContent = error instanceof Error ? error.message : 'No se pudo crear la cuenta con Google.';
    errorDiv.style.display = 'block';
  });

  // Toggle password visibility
  togglePwBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nombre = nombreInput.value.trim();
    const apellido = apellidoInput.value.trim();
    const email = emailInput.value.trim();
    const password = passwordInput.value;
    const aceptaTerminos = terminosCheckbox.checked;
    
    // Get selected tipo
    let tipo = 'familia';
    for (const radio of tipoRadios) {
      if (radio.checked) {
        tipo = radio.value;
        break;
      }
    }

    // Clear messages
    errorDiv.style.display = 'none';
    errorDiv.textContent = '';
    successDiv.style.display = 'none';
    successDiv.textContent = '';

    // Validate
    if (!nombre || !apellido || !email || !password) {
      errorDiv.textContent = 'Por favor completa todos los campos';
      errorDiv.style.display = 'block';
      return;
    }

    if (!aceptaTerminos) {
      errorDiv.textContent = 'Debes aceptar los términos y la política de privacidad';
      errorDiv.style.display = 'block';
      return;
    }

    try {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creando cuenta...';

      const response = await registro({
        email,
        password,
        nombre,
        apellido,
        tipo: tipo as 'familia' | 'autor' | 'admin',
      });

      // Store auth data
      setAuth(response.token, response.usuario);

      successDiv.textContent = '¡Cuenta creada exitosamente! Redirigiendo...';
      successDiv.style.display = 'block';

      // Redirect a login después de 1.5 segundos
      setTimeout(() => {
        window.location.href = '/auth/login';
      }, 1500);
    } catch (error: any) {
      errorDiv.textContent = error.message || 'Error al crear la cuenta. Intenta de nuevo.';
      errorDiv.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Crear cuenta gratis';
    }
  });
</script>
