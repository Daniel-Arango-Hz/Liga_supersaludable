  .type-box { display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 0.5rem; min-height: 38px; padding: 0.4rem; border: 1px solid #d9e5ef; border-radius: 10px; color: #60748a; background: #fbfcfd; font-size: 0.78rem; font-weight: 600; transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease; }
