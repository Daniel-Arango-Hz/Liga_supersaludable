---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Registrarse – Liga Supersaludables" description="Crea tu cuenta en Liga Supersaludables." minimal>
  <main class="auth-layout">
    <aside class="promo-panel">
      <a href="/" class="brand" aria-label="Liga Supersaludables, inicio">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none"><path d="M25.5 5.5c-9.2.5-16.6 4.2-17.8 11.3-.7 4.2 2.3 7.1 6.1 6.6 7.5-1 10.8-8.8 11.7-17.9Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M7 27c3.4-7.5 8.1-11.2 14.5-14.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
        <span class="brand-copy"><strong>Liga</strong><span>SUPER SALUDABLES</span></span>
      </a>

      <div class="promo-copy">
        <p class="eyebrow">TU AVENTURA SALUDABLE</p>
        <h2>Pequeños pasos,<br />grandes<br /><span>superpoderes.</span></h2>
        <p class="promo-description">Aprende, juega y crece acompañado por tu liga de héroes saludables.</p>
        <ul class="benefits">
          <li><span aria-hidden="true">✓</span> Actividades divertidas</li>
          <li><span aria-hidden="true">✓</span> Hábitos para crecer</li>
        </ul>
      </div>

      <svg class="promo-decoration" viewBox="0 0 440 440" fill="none" aria-hidden="true">
        <circle cx="250" cy="250" r="220" /><circle cx="250" cy="250" r="165" />
        <path d="M205 346c-19-39-1-74 31-94 36-22 43-53 25-88 46 23 66 62 54 101-13 44-59 69-95 49-24-13-32-34-26-56 5-19 20-32 38-40" />
      </svg>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-title">
      <div class="auth-content">
        <a class="back-link" href="/" aria-label="Volver al inicio">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 6-6 6 6 6M4 12h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Volver al inicio
        </a>

        <header class="auth-brand">
          <span class="lock-badge" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><rect x="4" y="10" width="16" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="15.5" r="1.2" fill="currentColor"/></svg>
          </span>
          <p class="auth-eyebrow">LIGA SUPER SALUDABLE</p>
          <h1 id="auth-title" class="auth-title">Crea tu cuenta</h1>
          <p class="auth-subtitle">Únete a la aventura y empieza a cuidar de ti.</p>
        </header>

        <div id="error-message" class="message error-message" style="display: none;" role="alert"></div>
        <div id="success-message" class="message success-message" style="display: none;" role="status"></div>

        <form class="auth-form" id="registro-form" novalidate>
          

          <div class="form-row">
            <div class="form-group">
              <label for="nombre" class="form-label">Nombre</label>
              <div class="input-wrapper">
                <svg class="field-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <input id="nombre" type="text" name="nombre" class="form-input" placeholder="Tu nombre" autocomplete="given-name" required />
              </div>
            </div>
            <div class="form-group">
              <label for="apellido" class="form-label">Apellido</label>
              <div class="input-wrapper">
                <svg class="field-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <input id="apellido" type="text" name="apellido" class="form-input" placeholder="Tu apellido" autocomplete="family-name" required />
              </div>
            </div>
          </div>

          <div class="form-group">
            <label for="email" class="form-label">Correo electrónico</label>
            <div class="input-wrapper">
              <svg class="field-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <input id="email" type="email" name="email" class="form-input" placeholder="tu@email.com" autocomplete="email" required />
            </div>
          </div>

          <div class="form-group">
            <label for="password" class="form-label">Contraseña</label>
            <div class="input-wrapper">
              <svg class="field-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="15.5" r="1" fill="currentColor"/></svg>
              <input id="password" type="password" name="password" class="form-input" placeholder="Mínimo 8 caracteres" autocomplete="new-password" required minlength="8" />
              <button type="button" class="toggle-pw" aria-label="Mostrar contraseña">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
              </button>
            </div>
            <p class="form-hint">Usa al menos 8 caracteres con letras y números.</p>
          </div>

          <label class="check-label">
            <input type="checkbox" name="terminos" class="check-input" required />
            <span>Acepto los <a href="/terminos" class="form-link">términos de uso</a> y la <a href="/privacidad" class="form-link">política de privacidad</a>.</span>
          </label>

          <button type="submit" class="btn-submit" id="submit-btn">Crear mi cuenta</button>
        </form>

        <div class="divider"><span>o regístrate con</span></div>
        <div class="social-auth">
          <button class="btn-social" id="google-auth-btn" type="button" aria-label="Registrarse con Google">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Registrarse con Google
          </button>
        </div>

        <p class="auth-footer-text">¿Ya tienes una cuenta? <a href="/auth/login" class="form-link">Inicia sesión</a></p>
        <p class="legal-note">Al continuar aceptas nuestros <a href="/terminos">términos de uso</a> y <a href="/privacidad">política de privacidad</a>.</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  .auth-main {
    min-height: calc(100vh - 64px);
    background: linear-gradient(135deg, var(--color-cream) 0%, var(--color-primary-blue) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  .auth-card {
    width: 100%;
    max-width: 480px;
    background: var(--color-white);
    border: 3px solid var(--color-primary-blue);
    border-radius: var(--radius-lg);
    padding: 2.75rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .auth-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .auth-logo-emoji {
    font-size: 2rem;
  }

  .auth-logo span {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-navy-light), var(--color-primary-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .auth-title {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-primary-blue), var(--color-primary-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0.5rem 0;
  }

  .auth-subtitle {
    font-size: 0.95rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .type-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .type-option {
    cursor: pointer;
  }

  .type-radio {
    display: none;
  }

  .type-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.2rem 0.75rem;
    border: 2.5px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    transition: all 0.3s;
    background: var(--color-white);
  }

  .type-emoji {
    font-size: 2.5rem;
  }

  .type-radio:checked + .type-box {
    border-color: var(--color-primary-blue);
    background: linear-gradient(135deg, rgba(0, 168, 232, 0.1), rgba(184, 45, 181, 0.1));
    color: var(--color-primary-blue);
    transform: scale(1.05);
  }

  .type-box:hover {
    border-color: var(--color-primary-blue);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .form-input {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 2.5px solid var(--color-primary-blue);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-white);
    transition: all 0.3s;
    outline: none;
  }

  .form-input:focus {
    border-color: var(--color-primary-purple);
    box-shadow: 0 0 0 4px rgba(184, 45, 181, 0.15);
    transform: scale(1.02);
  }

  .btn-submit {
    width: 100%;
    padding: 0.9rem;
    background: linear-gradient(135deg, var(--color-primary-pink), var(--color-primary-red));
    color: var(--color-white);
    border: none;
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.3s;
    margin-top: 0.25rem;
    box-shadow: var(--shadow-md);
  }

  .btn-submit:hover {
    transform: scale(1.05);
    box-shadow: var(--shadow-lg);
  }

  .auth-footer-text { text-align: center; font-size: 0.9rem; color: var(--color-text-muted); }

  .divider {
    display: flex; align-items: center; gap: 1rem;
    font-size: 0.85rem; color: var(--color-text-muted);
  }
  .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--color-border); }

  .social-auth { display: flex; flex-direction: column; gap: 0.75rem; }
  .btn-social {
    display: flex; align-items: center; justify-content: center; gap: 0.75rem;
    width: 100%; padding: 0.7rem; border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm); font-size: 0.92rem; font-weight: 500;
    color: var(--color-text); background: var(--color-white); cursor: pointer;
    font-family: var(--font-sans); transition: border-color 0.2s, background 0.2s;
  }
  .btn-social:hover { border-color: var(--color-navy); background: var(--color-cream); }

  .error-message {
    padding: 0.75rem;
    background: #fee;
    border: 1px solid #fcc;
    border-radius: var(--radius-sm);
    color: #c33;
    font-size: 0.9rem;
    text-align: center;
  }

  .success-message {
    padding: 0.75rem;
    background: #efe;
    border: 1px solid #cfc;
    border-radius: var(--radius-sm);
    color: #3c3;
    font-size: 0.9rem;
    text-align: center;
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    .auth-main {
      padding: 2rem 1rem;
    }

    .auth-card {
      max-width: 100%;
      padding: 2rem 1.5rem;
      gap: 1.25rem;
    }

    .auth-title {
      font-size: 1.5rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .form-input {
      padding: 1rem 1.1rem;
      font-size: 1rem;
    }

    .btn-submit {
      padding: 1rem;
      font-size: 1rem;
      margin-top: 0.5rem;
    }

    .type-options {
      gap: 0.75rem;
    }

    .type-box {
      padding: 1rem 0.6rem;
    }
  }

  @media (max-width: 480px) {
    .auth-main {
      padding: 1.5rem 1rem;
    }

    .auth-card {
      padding: 1.75rem 1.25rem;
      gap: 1.25rem;
      border-radius: var(--radius-md);
    }

    .auth-logo-emoji {
      font-size: 1.5rem;
    }

    .auth-logo span {
      font-size: 1.25rem;
    }

    .auth-title {
      font-size: 1.35rem;
      margin: 0.35rem 0;
    }

    .auth-subtitle {
      font-size: 0.9rem;
    }

    .type-options {
      gap: 0.6rem;
    }

    .type-box {
      padding: 0.95rem 0.5rem;
      font-size: 0.85rem;
    }

    .type-emoji {
      font-size: 2rem;
    }

    .form-group {
      gap: 0.35rem;
    }

    .form-label {
      font-size: 0.85rem;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .form-input {
      padding: 0.95rem 1rem;
      font-size: 1rem;
      border-radius: var(--radius-md);
    }

    .btn-submit {
      padding: 0.95rem;
      font-size: 0.95rem;
      border-radius: var(--radius-md);
    }

    .check-label {
      font-size: 0.85rem;
      line-height: 1.4;
    }

    .form-link {
      font-size: 0.85rem;
    }

    .form-hint {
      font-size: 0.8rem;
    }

    .divider {
      margin: 1rem 0;
    }

    .btn-social {
      padding: 0.8rem;
      font-size: 0.9rem;
    }

    .auth-footer-text {
      font-size: 0.85rem;
      margin-top: 0.5rem;
    }
  }

  .auth-main {
    min-height: calc(100svh - 64px);
    padding: 3rem 1.25rem;
    background:
      radial-gradient(circle at 8% 12%, rgba(140, 224, 211, 0.35), transparent 28rem),
      radial-gradient(circle at 92% 88%, rgba(255, 195, 103, 0.24), transparent 25rem),
      #f5fbfa;
  }

  .auth-card {
    max-width: 500px;
    padding: 2.5rem;
    gap: 1.5rem;
    border: 1px solid #d8ece9;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 20px 48px rgba(42, 101, 102, 0.12);
  }

  .auth-brand { gap: 0.55rem; }

  .auth-logo span {
    background: linear-gradient(135deg, #168f83, #e57650);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .auth-title {
    color: #2e405e;
    background: none;
    -webkit-text-fill-color: currentColor;
    font-size: 1.65rem;
    letter-spacing: -0.035em;
  }

  .auth-subtitle {
    color: #607889;
    font-weight: 400;
    line-height: 1.6;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  .form-label { color: #2c465c; }

  .form-input {
    border: 1px solid #d5e7e4;
    border-radius: 12px;
    background: #fcfefd;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .form-input::placeholder { color: #91a3ad; }

  .form-input:focus {
    border-color: #46b9ae;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(70, 185, 174, 0.15);
    transform: none;
  }

  .form-hint {
    color: #718995;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .type-options { gap: 0.8rem; }

  .type-option { position: relative; }

  .type-radio {
    display: block;
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .type-box {
    border: 1px solid #d8ece9;
    border-radius: 15px;
    background: #fcfefd;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }

  .type-radio:checked + .type-box {
    border-color: #46b9ae;
    background: #effaf7;
    color: #087d72;
    box-shadow: inset 0 0 0 1px rgba(70, 185, 174, 0.18);
    transform: none;
  }

  .type-option:hover .type-box {
    border-color: #46b9ae;
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(42, 101, 102, 0.1);
  }

  .type-radio:focus-visible + .type-box {
    outline: 3px solid rgba(70, 185, 174, 0.45);
    outline-offset: 3px;
  }

  .toggle-pw:hover { color: #168f83; }

  .check-input { accent-color: #168f83; }

  .form-link {
    color: #168f83;
    font-weight: 700;
  }

  .form-link:hover { color: #e57650; opacity: 1; }

  .btn-submit {
    border-radius: 13px;
    background: linear-gradient(135deg, #46b9ae, #168f83);
    box-shadow: 0 9px 18px rgba(42, 147, 137, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .btn-submit:hover {
    background: linear-gradient(135deg, #39aa9f, #087d72);
    transform: translateY(-2px);
    box-shadow: 0 13px 22px rgba(42, 147, 137, 0.24);
  }

  .btn-submit:focus-visible,
  .btn-social:focus-visible,
  .form-link:focus-visible,
  .toggle-pw:focus-visible {
    outline: 3px solid rgba(70, 185, 174, 0.45);
    outline-offset: 3px;
  }

  .auth-footer-text { color: #607889; }

  .divider::before,
  .divider::after { background: #d8ece9; }

  .btn-social {
    border-color: #d8ece9;
    border-radius: 12px;
    background: #fff;
  }

  .btn-social:hover {
    border-color: #46b9ae;
    background: #f1faf8;
  }

  .success-message {
    border-color: #bcecdf;
    background: #effaf6;
    color: #087d72;
  }

  @media (max-width: 768px) {
    .form-row { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .auth-main { padding: 1.5rem 1rem; }
    .auth-card { padding: 1.75rem 1.25rem; }
  }

  .auth-layout {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(420px, 45%) minmax(0, 1fr);
    background: #fff;
  }

  .promo-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100vh;
    min-height: 100svh;
    padding: 2.4rem clamp(2.5rem, 6vw, 5rem);
    color: #fff;
    background: linear-gradient(145deg, #159c97 0%, #22ada0 48%, #75d3ae 100%);
  }

  .brand {
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    color: #fff;
  }

  .brand-mark {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 14px 14px 14px 5px;
    color: #fff;
    background: #ffc957;
    transform: rotate(-4deg);
  }

  .brand-mark svg { width: 27px; height: 27px; }
  .brand-copy { display: grid; gap: 0.15rem; }
  .brand-copy strong { font-size: 1rem; font-weight: 700; }
  .brand-copy span { font-size: 0.7rem; letter-spacing: 0.13em; }

  .promo-copy { z-index: 1; width: min(100%, 510px); margin: 3rem 0 4rem; }
  .eyebrow,
  .auth-eyebrow { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.18em; }
  .eyebrow { margin-bottom: 1.45rem; color: rgba(255, 255, 255, 0.88); }

  .promo-copy h2 {
    margin: 0;
    font-size: clamp(3.2rem, 5.2vw, 4.45rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.065em;
  }

  .promo-copy h2 span { color: #ffdc70; }
  .promo-description { max-width: 445px; margin-top: 1.4rem; color: rgba(255, 255, 255, 0.88); font-size: 1.06rem; line-height: 1.7; }
