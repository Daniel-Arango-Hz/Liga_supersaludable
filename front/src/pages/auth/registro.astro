    .promo-decoration { right: -70px; bottom: -210px; width: 280px; }
    .auth-panel { flex: 1; align-items: flex-start; padding: 1.2rem 1.35rem 2rem; }
    .auth-content { width: min(100%, 456px); margin: 0 auto; gap: 0.85rem; }
    .back-link { align-self: flex-start; }
    .auth-brand { margin: 0.5rem 0 0.1rem; }
