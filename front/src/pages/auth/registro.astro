---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Registrarse – FamiliaLee" description="Crea tu cuenta en FamiliaLee gratuitamente.">
  <main class="auth-main">
    <div class="auth-card">
      <div class="auth-brand">
        <a href="/" class="auth-logo" aria-label="Ir al inicio">
          <span class="auth-logo-emoji">📚</span>
          <span>FamiliaLee</span>
        </a>
        <h1 class="auth-title">✨ ¡Bienvenido! ✨</h1>
        <p class="auth-subtitle">Únete a miles de familias que ya son parte de FamiliaLee y descubre historias increíbles.</p>
      </div>

      <!-- Tipos de cuenta -->
      <div class="account-type" role="group" aria-labelledby="tipo-label">
        <p id="tipo-label" class="form-label">¿Cómo quieres participar?</p>
        <div class="type-options">
          <label class="type-option">
            <input type="radio" name="tipo" value="familia" class="type-radio" checked />
            <div class="type-box">
              <span class="type-emoji">👨‍👩‍👧‍👦</span>
              <span>Familia</span>
            </div>
          </label>
          <label class="type-option">
            <input type="radio" name="tipo" value="autor" class="type-radio" />
            <div class="type-box">
              <span class="type-emoji">✍️</span>
              <span>Autor</span>
            </div>
          </label>
        </div>
      </div>

      <div id="error-message" class="error-message" style="display: none;"></div>
      <div id="success-message" class="success-message" style="display: none;"></div>

      <form class="auth-form" id="registro-form" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="nombre" class="form-label">Nombre</label>
            <input
              id="nombre"
              type="text"
              name="nombre"
              class="form-input"
              placeholder="Tu nombre"
              autocomplete="given-name"
              required
            />
          </div>
          <div class="form-group">
            <label for="apellido" class="form-label">Apellido</label>
            <input
              id="apellido"
              type="text"
              name="apellido"
              class="form-input"
              placeholder="Tu apellido"
              autocomplete="family-name"
              required
            />
          </div>
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Correo electrónico</label>
          <input
            id="email"
            type="email"
            name="email"
            class="form-input"
            placeholder="tucorreo@ejemplo.com"
            autocomplete="email"
            required
          />
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Contraseña</label>
          <div class="input-wrapper">
            <input
              id="password"
              type="password"
              name="password"
              class="form-input"
              placeholder="Mínimo 8 caracteres"
              autocomplete="new-password"
              required
              minlength="8"
            />
            <button type="button" class="toggle-pw" aria-label="Mostrar contraseña">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
          <p class="form-hint">Usa al menos 8 caracteres con letras y números.</p>
        </div>

        <div class="form-check">
          <label class="check-label">
            <input type="checkbox" name="terminos" class="check-input" required />
            Acepto los
            <a href="/terminos" class="form-link">Términos de uso</a>
            y la
            <a href="/privacidad" class="form-link">Política de privacidad</a>
          </label>
        </div>

        <button type="submit" class="btn-submit" id="submit-btn">🌟 ¡Crear mi cuenta! 🌟</button>
      </form>

      <p class="auth-footer-text">
        ¿Ya tienes cuenta?
        <a href="/auth/login" class="form-link">Ingresar</a>
      </p>

      <div class="divider"><span>o</span></div>

      <div class="social-auth">
        <button class="btn-social" aria-label="Registrarse con Google">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Registrarse con Google
        </button>
      </div>
    </div>
  </main>
</Layout>

<style>
  .auth-main {
    min-height: calc(100vh - 64px);
    background: linear-gradient(135deg, var(--color-cream) 0%, var(--color-primary-blue) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  .auth-card {
    width: 100%;
    max-width: 480px;
    background: var(--color-white);
    border: 3px solid var(--color-primary-blue);
    border-radius: var(--radius-lg);
    padding: 2.75rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .auth-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .auth-logo-emoji {
    font-size: 2rem;
  }

  .auth-logo span {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-navy-light), var(--color-primary-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .auth-title {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-primary-blue), var(--color-primary-purple));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0.5rem 0;
  }

  .auth-subtitle {
    font-size: 0.95rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .type-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .type-option {
    cursor: pointer;
  }

  .type-radio {
    display: none;
  }

  .type-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.2rem 0.75rem;
    border: 2.5px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    transition: all 0.3s;
    background: var(--color-white);
  }

  .type-emoji {
    font-size: 2.5rem;
  }

  .type-radio:checked + .type-box {
    border-color: var(--color-primary-blue);
    background: linear-gradient(135deg, rgba(0, 168, 232, 0.1), rgba(184, 45, 181, 0.1));
    color: var(--color-primary-blue);
    transform: scale(1.05);
  }

  .type-box:hover {
    border-color: var(--color-primary-blue);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .form-input {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 2.5px solid var(--color-primary-blue);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    font-family: var(--font-sans);
    color: var(--color-text);
    background: var(--color-white);
    transition: all 0.3s;
    outline: none;
  }

  .form-input:focus {
    border-color: var(--color-primary-purple);
    box-shadow: 0 0 0 4px rgba(184, 45, 181, 0.15);
    transform: scale(1.02);
  }

  .btn-submit {
    width: 100%;
    padding: 0.9rem;
    background: linear-gradient(135deg, var(--color-primary-pink), var(--color-primary-red));
    color: var(--color-white);
    border: none;
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: all 0.3s;
    margin-top: 0.25rem;
    box-shadow: var(--shadow-md);
  }

  .btn-submit:hover {
    transform: scale(1.05);
    box-shadow: var(--shadow-lg);
  }

  .auth-footer-text { text-align: center; font-size: 0.9rem; color: var(--color-text-muted); }

  .divider {
    display: flex; align-items: center; gap: 1rem;
    font-size: 0.85rem; color: var(--color-text-muted);
  }
  .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--color-border); }

  .social-auth { display: flex; flex-direction: column; gap: 0.75rem; }
  .btn-social {
    display: flex; align-items: center; justify-content: center; gap: 0.75rem;
    width: 100%; padding: 0.7rem; border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm); font-size: 0.92rem; font-weight: 500;
    color: var(--color-text); background: var(--color-white); cursor: pointer;
    font-family: var(--font-sans); transition: border-color 0.2s, background 0.2s;
  }
  .btn-social:hover { border-color: var(--color-navy); background: var(--color-cream); }

  .error-message {
    padding: 0.75rem;
    background: #fee;
    border: 1px solid #fcc;
    border-radius: var(--radius-sm);
    color: #c33;
    font-size: 0.9rem;
    text-align: center;
  }

  .success-message {
    padding: 0.75rem;
    background: #efe;
    border: 1px solid #cfc;
    border-radius: var(--radius-sm);
    color: #3c3;
    font-size: 0.9rem;
    text-align: center;
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    .auth-main {
      padding: 2rem 1rem;
    }

    .auth-card {
      max-width: 100%;
      padding: 2rem 1.5rem;
      gap: 1.25rem;
    }

    .auth-title {
      font-size: 1.5rem;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .form-input {
      padding: 1rem 1.1rem;
      font-size: 1rem;
    }

    .btn-submit {
      padding: 1rem;
      font-size: 1rem;
      margin-top: 0.5rem;
    }

    .type-options {
      gap: 0.75rem;
    }

    .type-box {
      padding: 1rem 0.6rem;
    }
  }

  @media (max-width: 480px) {
    .auth-main {
      padding: 1.5rem 1rem;
    }

    .auth-card {
      padding: 1.75rem 1.25rem;
      gap: 1.25rem;
      border-radius: var(--radius-md);
    }

    .auth-logo-emoji {
      font-size: 1.5rem;
    }

    .auth-logo span {
      font-size: 1.25rem;
    }

    .auth-title {
      font-size: 1.35rem;
      margin: 0.35rem 0;
    }

    .auth-subtitle {
      font-size: 0.9rem;
    }

    .type-options {
      gap: 0.6rem;
    }

    .type-box {
      padding: 0.95rem 0.5rem;
      font-size: 0.85rem;
    }

    .type-emoji {
      font-size: 2rem;
    }

    .form-group {
      gap: 0.35rem;
    }

    .form-label {
      font-size: 0.85rem;
    }

    .form-row {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .form-input {
      padding: 0.95rem 1rem;
      font-size: 1rem;
      border-radius: var(--radius-md);
    }

    .btn-submit {
      padding: 0.95rem;
      font-size: 0.95rem;
      border-radius: var(--radius-md);
    }

    .check-label {
      font-size: 0.85rem;
      line-height: 1.4;
    }

    .form-link {
      font-size: 0.85rem;
    }

    .form-hint {
      font-size: 0.8rem;
    }

    .divider {
      margin: 1rem 0;
    }

    .btn-social {
      padding: 0.8rem;
      font-size: 0.9rem;
    }

    .auth-footer-text {
      font-size: 0.85rem;
      margin-top: 0.5rem;
    }
  }
</style>

<script>
  import { registro, setAuth } from '../../utils/api';

  const form = document.getElementById('registro-form') as HTMLFormElement;
  const nombreInput = document.getElementById('nombre') as HTMLInputElement;
  const apellidoInput = document.getElementById('apellido') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const terminosCheckbox = document.querySelector('input[name="terminos"]') as HTMLInputElement;
  const tipoRadios = document.querySelectorAll('input[name="tipo"]') as NodeListOf<HTMLInputElement>;
  const togglePwBtn = document.querySelector('.toggle-pw') as HTMLButtonElement;
  const errorDiv = document.getElementById('error-message') as HTMLDivElement;
  const successDiv = document.getElementById('success-message') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  // Toggle password visibility
  togglePwBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const isPassword = passwordInput.type === 'password';
    passwordInput.type = isPassword ? 'text' : 'password';
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nombre = nombreInput.value.trim();
    const apellido = apellidoInput.value.trim();
    const email = emailInput.value.trim();
    const password = passwordInput.value;
    const aceptaTerminos = terminosCheckbox.checked;
    
    // Get selected tipo
    let tipo = 'familia';
    for (const radio of tipoRadios) {
      if (radio.checked) {
        tipo = radio.value;
        break;
      }
    }

    // Clear messages
    errorDiv.style.display = 'none';
    errorDiv.textContent = '';
    successDiv.style.display = 'none';
    successDiv.textContent = '';

    // Validate
    if (!nombre || !apellido || !email || !password) {
      errorDiv.textContent = 'Por favor completa todos los campos';
      errorDiv.style.display = 'block';
      return;
    }

    if (!aceptaTerminos) {
      errorDiv.textContent = 'Debes aceptar los términos y la política de privacidad';
      errorDiv.style.display = 'block';
      return;
    }

    try {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Creando cuenta...';

      const response = await registro({
        email,
        password,
        nombre,
        apellido,
        tipo: tipo as 'familia' | 'autor' | 'admin',
      });

      // Store auth data
      setAuth(response.token, response.usuario);

      successDiv.textContent = '¡Cuenta creada exitosamente! Redirigiendo...';
      successDiv.style.display = 'block';

      // Redirect a login después de 1.5 segundos
      setTimeout(() => {
        window.location.href = '/auth/login';
      }, 1500);
    } catch (error: any) {
      errorDiv.textContent = error.message || 'Error al crear la cuenta. Intenta de nuevo.';
      errorDiv.style.display = 'block';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Crear cuenta gratis';
    }
  });
</script>
