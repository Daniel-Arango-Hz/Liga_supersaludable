  .check-label { display: flex; align-items: flex-start; gap: 0.55rem; color: #8190a5; cursor: pointer; font-size: 0.72rem; line-height: 1.5; }
  .check-input { flex: 0 0 auto; width: 15px; height: 15px; margin: 1px 0 0; accent-color: #159f93; }
  .form-link { color: #119d91; font-size: inherit; font-weight: 600; transition: color 0.2s ease; }
  .form-link:hover,
  .legal-note a:hover { color: #08796f; }

  .btn-submit { width: 100%; min-height: 50px; margin-top: 0.1rem; border-radius: 12px; color: #fff; background: linear-gradient(110deg, #20b39f, #109b98); box-shadow: 0 9px 20px rgba(24, 155, 145, 0.17); font: inherit; font-size: 0.88rem; font-weight: 700; transition: transform 0.2s ease, box-shadow 0.2s ease; }
