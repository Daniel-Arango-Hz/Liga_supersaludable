    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .auth-content .form-input::placeholder { color: #8d99aa; opacity: 1; }
  .auth-content .form-input:focus { border-color: #40b7aa; outline: none; background: #fff; box-shadow: 0 0 0 3px rgba(64, 183, 170, 0.14); }
