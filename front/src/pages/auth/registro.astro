  .auth-title { margin: 0; color: #26334c; font-size: clamp(1.8rem, 2.5vw, 2.15rem); font-weight: 500; letter-spacing: -0.055em; line-height: 1.2; }
  .auth-subtitle { margin-top: 0.65rem; color: #8291a7; font-size: 0.91rem; line-height: 1.5; }

  .auth-form { display: flex; flex-direction: column; gap: 0.85rem; }
