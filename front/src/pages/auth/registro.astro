  .field-icon { position: absolute; left: 0.85rem; width: 18px; height: 18px; color: #94a9bd; pointer-events: none; }

  .auth-content .form-input {
    width: 100%;
    min-height: 47px;
    padding: 0.75rem 2.7rem;
    border: 1px solid #d9e5ef;
