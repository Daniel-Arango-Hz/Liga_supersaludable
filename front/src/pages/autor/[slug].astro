---
import Layout from '../../layouts/Layout.astro';
import AuthorActions from '../../components/AuthorActions.astro';
import { obtenerAutor, obtenerLibros, obtenerAutores } from '../../utils/api';

export async function getStaticPaths() {
  try {
    const autoresResponse = await obtenerAutores();
    const autores = Array.isArray(autoresResponse) ? autoresResponse : (autoresResponse.data || []);
    
    return autores.map((autor: any) => ({
      params: { slug: autor.slug },
      props: { autor },
    }));
  } catch (error) {
    console.error('Error getting static paths for authors:', error);
    return [];
  }
}

interface Props {
  autor?: any;
}

export const prerender = true;

const { slug } = Astro.params;
const { autor: initialAutor } = Astro.props;

let autor = initialAutor || null;
const rawSlug = typeof slug === 'string' ? slug : (Array.isArray(slug) ? slug[0] : '') || '';
const normalizedSlug = rawSlug.toLowerCase();

let librosAutor: any[] = [];
let error = false;

try {
  if (!autor && rawSlug) {
    try {
      autor = await obtenerAutor(rawSlug);
    } catch (e) {
      autor = await obtenerAutor(normalizedSlug);
    }
  }
  
  if (autor) {
    try {
      const autorCompleto = await obtenerAutor(rawSlug || normalizedSlug);
      autor = { ...autor, ...autorCompleto };
    } catch (e) {
      console.warn('No se pudo enriquecer el autor con sus libros:', e);
    }

    const librosDelAutor = Array.isArray(autor?.libros) && autor.libros.length > 0
      ? autor.libros
      : [];

    if (librosDelAutor.length > 0) {
      librosAutor = librosDelAutor;
    } else {
      const allLibros = await obtenerLibros({ limite: 100 });
      librosAutor = (allLibros.data || []).filter((l: any) =>
        l.autor_slug?.toLowerCase() === normalizedSlug ||
        l.autor_nombre?.toLowerCase() === autor.nombre?.toLowerCase()
      );
    }

    autor.email = autor.email || autor.correo || autor.usuario?.email || '';
  }
} catch (err) {
  console.error('Error al obtener autor:', err);
  error = true;
}
---

<Layout title={!error && autor ? `${autor.nombre} – Autor – FamiliaLee` : 'Autor no encontrado'} description={!error && autor ? autor.especialidad : 'Conoce a los autores de FamiliaLee'}>
  <main>
    {!error && autor ? (
      <>
        <section class="autor-hero">
          <div class="container">
            <a href="/autores" class="breadcrumb">← Volver a Autores</a>

            <div class="autor-header">
              <div class="autor-avatar-large" aria-hidden="true">
                <span class="avatar-spark avatar-spark-one"></span>
                <span class="avatar-spark avatar-spark-two"></span>
                <span class="avatar-icon">✍️</span>
              </div>
              <div class="autor-content">
                <p class="autor-eyebrow">Personas que inspiran</p>
                <h1 class="autor-nombre">{autor.nombre}</h1>
                <p class="autor-especialidad">{autor.especialidad || 'Autor destacado'}</p>
                <p class="autor-bio">{autor.biografia || 'Creador de contenido para familias'}</p>

                <div class="autor-stats">
                  <div class="stat">
                    <strong>{autor.total_libros || 0}</strong>
                    <p>Libros publicados</p>
                  </div>
                  <div class="stat">
                    <strong>{(autor.total_descargas || 0).toLocaleString('es')}</strong>
                    <p>Descargas totales</p>
                  </div>
                  <div class="stat">
                    <strong id="seguidores-count">{autor.total_seguidores || 0}</strong>
                    <p>Seguidores</p>
                  </div>
                </div>

                <AuthorActions
                  autorId={autor.id}
                  autorSlug={autor.slug}
                  autorNombre={autor.nombre}
                  autorEmail={autor.email || autor.correo || autor.usuario?.email || ''}
                  estaSiguiendo={Boolean(autor.siguiendo)}
                />
              </div>
            </div>
          </div>
        </section>

        {librosAutor.length > 0 && (
          <section class="autor-libros">
            <div class="container">
              <header class="libros-heading">
                <div class="libros-heading-icon" aria-hidden="true">📚</div>
                <div>
                  <p class="libros-eyebrow">Historias para descubrir</p>
                  <h2 class="section-title">Libros de {autor.nombre}</h2>
                </div>
              </header>
              <div class="libros-grid">
                {librosAutor.map((libro: any) => {
                  const isImageCover = typeof libro.portada_icono === 'string' && /^https?:\/\//i.test(libro.portada_icono);
                  return (
                    <article class="libro-card">
                      <a href={`/libro/${libro.slug}`} class="libro-link">
                        <div class="libro-cover-card" style={`background: ${libro.portada_gradiente || 'linear-gradient(135deg, #00a8e8, #6c5ce7)'}`}>
                          {isImageCover ? (
                            <img class="libro-icon-img" src={libro.portada_icono} alt={libro.titulo} loading="lazy" />
                          ) : (
                            <span class="libro-icon">{libro.portada_icono || '📖'}</span>
                          )}
                          {libro.destacado && <span class="badge-pequeño">⭐</span>}
                        </div>
                        <div class="libro-info-card">
                          <h3>{libro.titulo}</h3>
                          <p class="edad-rango">Edad: {libro.edad_rango || 'N/A'}</p>
                          <div class="rating">⭐ {libro.rating_promedio?.toFixed(1) || '0'}</div>
                        </div>
                      </a>
                    </article>
                  );
                })}
              </div>
            </div>
          </section>
        )}
        {librosAutor.length === 0 && (
          <section class="autor-libros autor-libros-empty">
            <div class="container centered">
              <div class="empty-icon" aria-hidden="true">📚</div>
              <p class="libros-eyebrow">Próximamente</p>
              <h2 class="section-title">Nuevas historias en camino</h2>
              <p class="empty-description">Este autor todavía no tiene libros publicados.</p>
            </div>
          </section>
        )}
      </>
    ) : (
      <section class="section">
        <div class="container centered">
          <p style="font-size: 3rem; margin-bottom: 1rem;">👤</p>
          <h2>Autor no encontrado</h2>
          <p>Lo sentimos, el autor que buscas no está disponible.</p>
          <a href="/autores" class="btn-primary">Volver a Autores</a>
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
