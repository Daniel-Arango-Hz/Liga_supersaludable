---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Mi perfil – Liga Supersaludables" description="Consulta tu actividad y administra tu perfil en Liga Supersaludables.">
  <main class="profile-page">
    <div class="profile-container">
      <section class="profile-hero" aria-labelledby="profile-name">
        <div class="avatar-wrap">
          <button class="avatar-button" id="avatar-button" type="button" aria-label="Agregar foto de perfil">
            <img class="profile-avatar-image" id="profile-avatar-image" alt="" hidden />
            <span class="avatar-fallback" id="avatar-fallback" aria-hidden="true">U</span>
            <span class="avatar-edit-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4 11.5-11.5Z" /></svg>
            </span>
          </button>
          <input id="avatar-input" type="file" accept="image/jpeg,image/png,image/webp" hidden />
        </div>

        <div class="profile-identity">
          <p class="eyebrow">MI PERFIL</p>
          <h1 id="profile-name">Tu espacio saludable</h1>
          <p class="profile-meta" id="profile-meta">Un lugar para seguir aprendiendo y creciendo en familia.</p>
          <span class="member-since" id="member-since" hidden></span>
        </div>

        <button class="edit-profile-button" id="edit-profile-button" type="button">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4 11.5-11.5Z" /></svg>
          Editar perfil
        </button>
      </section>

      <section class="profile-grid" aria-label="Resumen de tu cuenta">
        <article class="profile-card activity-card">
          <div class="card-heading">
            <div>
              <p class="eyebrow">MI ACTIVIDAD</p>
              <h2>Tu recorrido lector</h2>
            </div>
            <span class="heading-icon trophy-icon" aria-hidden="true">🏆</span>
          </div>

          <div class="stats-row" aria-live="polite">
            <div class="stat">
              <strong id="downloads-count">0</strong>
              <span>descargas</span>
            </div>
            <div class="stat">
              <strong id="saved-count">0</strong>
              <span>guardados</span>
            </div>
            <div class="stat">
              <strong id="publications-count">0</strong>
              <span>publicaciones</span>
            </div>
          </div>

          <div class="reading-card">
            <div class="reading-card-top">
              <span>Tu biblioteca personal</span>
              <strong id="reading-summary">¡Empieza una nueva aventura!</strong>
            </div>
            <div class="reading-bar" aria-hidden="true"><span id="reading-progress"></span></div>
            <p id="reading-tip">Explora cuentos y guarda tus favoritos para después.</p>
          </div>

          <a class="text-link" href="/biblioteca">Explorar cuentos <span aria-hidden="true">›</span></a>
        </article>

        <article class="profile-card shortcuts-card">
          <div class="card-heading">
            <div>
              <p class="eyebrow">TU ESPACIO</p>
              <h2>Accesos rápidos</h2>
            </div>
            <span class="heading-icon settings-icon" aria-hidden="true">⚙</span>
          </div>

          <a class="shortcut" href="/panel/guardados">
            <span class="shortcut-icon heart-icon" aria-hidden="true">♡</span>
            <span class="shortcut-copy">
              <strong>Mis cuentos guardados</strong>
              <small>Vuelve a tus historias favoritas</small>
            </span>
            <span class="shortcut-arrow" aria-hidden="true">›</span>
          </a>
          <a class="shortcut" href="/panel/publicaciones">
            <span class="shortcut-icon book-icon" aria-hidden="true">▤</span>
            <span class="shortcut-copy">
              <strong>Mis publicaciones</strong>
              <small>Consulta los cuentos que compartiste</small>
            </span>
            <span class="shortcut-arrow" aria-hidden="true">›</span>
          </a>
          <a class="shortcut" href="/biblioteca">
            <span class="shortcut-icon explore-icon" aria-hidden="true">✦</span>
            <span class="shortcut-copy">
              <strong>Descubrir cuentos</strong>
              <small>Encuentra tu próxima lectura</small>
            </span>
            <span class="shortcut-arrow" aria-hidden="true">›</span>
          </a>
        </article>
      </section>

      <section class="profile-card badges-card" aria-labelledby="badges-title">
        <div class="card-heading">
          <div>
            <p class="eyebrow">TUS LOGROS</p>
            <h2 id="badges-title">Pequeños grandes pasos</h2>
          </div>
          <span class="heading-icon medal-icon" aria-hidden="true">♙</span>
        </div>
        <div class="badges-grid" id="badges-grid">
          <article class="badge badge-mint" data-badge="explorer">
            <span class="badge-art" aria-hidden="true">🌱</span>
            <strong>Primer cuento</strong>
            <small>Descarga tu primer cuento</small>
          </article>
          <article class="badge badge-yellow" data-badge="collector">
            <span class="badge-art" aria-hidden="true">⭐</span>
            <strong>Buen explorador</strong>
            <small>Guarda tu primer favorito</small>
          </article>
          <article class="badge badge-blue" data-badge="author">
            <span class="badge-art" aria-hidden="true">📚</span>
            <strong>Autor de historias</strong>
            <small>Comparte tu primera publicación</small>
          </article>
          <article class="badge badge-peach" data-badge="reader">
            <span class="badge-art" aria-hidden="true">🏆</span>
            <strong>Lector constante</strong>
            <small>Descarga 5 cuentos</small>
          </article>
        </div>
        <p class="profile-status" id="profile-status" role="status" aria-live="polite"></p>
      </section>
    </div>

    <dialog class="edit-dialog" id="edit-dialog" aria-labelledby="edit-dialog-title">
      <form id="edit-profile-form">
        <div class="dialog-heading">
          <div>
            <p class="eyebrow">TU CUENTA</p>
            <h2 id="edit-dialog-title">Editar perfil</h2>
          </div>
          <button class="dialog-close" id="close-dialog-button" type="button" aria-label="Cerrar">×</button>
        </div>
        <label for="first-name">Nombre</label>
        <input id="first-name" name="nombre" type="text" maxlength="80" autocomplete="given-name" required />
        <label for="last-name">Apellido</label>
        <input id="last-name" name="apellido" type="text" maxlength="80" autocomplete="family-name" required />
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="email" readonly />
        <p class="dialog-status" id="dialog-status" role="status" aria-live="polite"></p>
        <div class="dialog-actions">
          <button class="cancel-button" id="cancel-dialog-button" type="button">Cancelar</button>
          <button class="save-button" id="save-profile-button" type="submit">Guardar cambios</button>
        </div>
      </form>
    </dialog>
  </main>
</Layout>

<script>
  import {
    actualizarAvatar,
    actualizarPerfil,
    getUsuario,
    obtenerDescargas,
    obtenerPerfil,
    obtenerPublicaciones,
    obtenerGuardados,
  } from '../utils/api';

  type ProfileUser = {
    id: string;
    nombre: string;
    apellido: string;
    email: string;
    avatar_url?: string;
    created_at?: string;
    tipo?: string;
  };

  const nameElement = document.getElementById('profile-name');
  const metaElement = document.getElementById('profile-meta');
  const memberSinceElement = document.getElementById('member-since');
  const avatarButton = document.getElementById('avatar-button') as HTMLButtonElement | null;
  const avatarInput = document.getElementById('avatar-input') as HTMLInputElement | null;
  const avatarImage = document.getElementById('profile-avatar-image') as HTMLImageElement | null;
  const avatarFallback = document.getElementById('avatar-fallback');
  const editDialog = document.getElementById('edit-dialog') as HTMLDialogElement | null;
  const editForm = document.getElementById('edit-profile-form') as HTMLFormElement | null;
  const profileStatus = document.getElementById('profile-status');
  const dialogStatus = document.getElementById('dialog-status');
  const saveButton = document.getElementById('save-profile-button') as HTMLButtonElement | null;
  let currentUser: ProfileUser | null = getUsuario();

  function renderAvatar(user: ProfileUser) {
    const initial = user.nombre?.trim().charAt(0).toLocaleUpperCase('es') || 'U';
    if (avatarFallback) avatarFallback.textContent = initial;
    if (avatarFallback) (avatarFallback as HTMLElement).hidden = Boolean(user.avatar_url);
    if (avatarImage) {
      avatarImage.hidden = !user.avatar_url;
      if (user.avatar_url) avatarImage.src = user.avatar_url;
      else avatarImage.removeAttribute('src');
    }
    if (avatarButton) {
      const label = user.avatar_url ? 'Editar foto de perfil' : 'Agregar foto de perfil';
      avatarButton.setAttribute('aria-label', label);
    }
  }

  function renderUser(user: ProfileUser) {
    currentUser = user;
    if (nameElement) {
      nameElement.textContent = [user.nombre, user.apellido].filter(Boolean).join(' ') || 'Mi perfil';
    }
    if (metaElement) {
      metaElement.textContent = user.tipo === 'autor'
        ? 'Gracias por compartir tus historias con nuestra comunidad.'
        : 'Un lugar para seguir aprendiendo y creciendo en familia.';
    }
    if (memberSinceElement && user.created_at) {
      const date = new Date(user.created_at);
      if (!Number.isNaN(date.getTime())) {
        memberSinceElement.textContent = `Miembro desde ${new Intl.DateTimeFormat('es', { month: 'long', year: 'numeric' }).format(date)}`;
        memberSinceElement.hidden = false;
      }
    }
    renderAvatar(user);
  }

  function setProfileStatus(message: string, isError = false) {
    if (!profileStatus) return;
    profileStatus.textContent = message;
    profileStatus.classList.toggle('is-error', isError);
  }

  async function loadProfile() {
    if (!currentUser) {
      window.dispatchEvent(new CustomEvent('auth:required', {
        detail: { title: 'Inicio de sesión requerido', message: 'Inicia sesión para consultar y editar tu perfil.' },
      }));
      setProfileStatus('Inicia sesión para cargar la actividad de tu cuenta.', true);
      return;
    }

    renderUser(currentUser);
    const results = await Promise.allSettled([
      obtenerPerfil(),
      obtenerDescargas(),
      obtenerGuardados(),
      obtenerPublicaciones(),
    ]);

    const [profileResult, downloadsResult, savedResult, publicationsResult] = results;
    if (profileResult.status === 'fulfilled') {
      renderUser(profileResult.value);
    } else {
      console.error('No se pudo cargar el perfil actualizado.', profileResult.reason);
    }

    if (downloadsResult.status === 'fulfilled' && savedResult.status === 'fulfilled' && publicationsResult.status === 'fulfilled') {
      const downloads = Array.isArray(downloadsResult.value) ? downloadsResult.value.length : 0;
      const saved = Array.isArray(savedResult.value) ? savedResult.value.length : 0;
      const publications = Array.isArray(publicationsResult.value) ? publicationsResult.value.length : 0;
      renderActivity(downloads, saved, publications);
    } else {
      const failedActivity = results.slice(1).find((result) => result.status === 'rejected');
      console.error('No se pudo cargar toda la actividad del perfil.', failedActivity?.status === 'rejected' ? failedActivity.reason : undefined);
      setProfileStatus('No pudimos cargar tu actividad. Intenta recargar la página.', true);
    }
  }

  function renderActivity(downloads: number, saved: number, publications: number) {
    const counts = { downloads, saved, publications };
    const countElements = [
      ['downloads-count', downloads],
      ['saved-count', saved],
      ['publications-count', publications],
    ] as const;
    countElements.forEach(([id, count]) => {
      const element = document.getElementById(id);
      if (element) element.textContent = String(count);
    });

    const summary = document.getElementById('reading-summary');
    const progress = document.getElementById('reading-progress');
    const tip = document.getElementById('reading-tip');
    if (summary) summary.textContent = downloads >= 5
      ? '¡Insignia Lector constante desbloqueada!'
      : `${downloads} de 5 descargas para Lector constante`;
    if (progress) (progress as HTMLElement).style.width = `${Math.min(downloads / 5 * 100, 100)}%`;
    if (tip) tip.textContent = downloads >= 5
      ? '¡Sigue disfrutando de nuevas historias!'
      : 'Descarga cuentos para descubrir tu próxima insignia.';

    const badges: Record<string, boolean> = {
      explorer: counts.downloads >= 1,
      collector: counts.saved >= 1,
      author: counts.publications >= 1,
      reader: counts.downloads >= 5,
    };
    Object.entries(badges).forEach(([id, unlocked]) => {
      const badge = document.querySelector<HTMLElement>(`[data-badge="${id}"]`);
      badge?.classList.toggle('is-unlocked', unlocked);
      badge?.setAttribute('aria-label', `${badge.querySelector('strong')?.textContent}: ${unlocked ? 'logro desbloqueado' : 'logro pendiente'}`);
    });
  }

  document.getElementById('edit-profile-button')?.addEventListener('click', () => {
    if (!currentUser || !editDialog || !editForm) return;
    (editForm.elements.namedItem('nombre') as HTMLInputElement).value = currentUser.nombre || '';
    (editForm.elements.namedItem('apellido') as HTMLInputElement).value = currentUser.apellido || '';
    (editForm.elements.namedItem('email') as HTMLInputElement).value = currentUser.email || '';
    if (dialogStatus) dialogStatus.textContent = '';
    editDialog.showModal();
  });

  function closeDialog() {
    editDialog?.close();
  }

  document.getElementById('close-dialog-button')?.addEventListener('click', closeDialog);
  document.getElementById('cancel-dialog-button')?.addEventListener('click', closeDialog);

  editForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!currentUser || !saveButton || !editForm) return;
    const formData = new FormData(editForm);
    saveButton.disabled = true;
    if (dialogStatus) dialogStatus.textContent = 'Guardando tus cambios…';
    try {
      const updatedUser = await actualizarPerfil({
        nombre: String(formData.get('nombre') || '').trim(),
        apellido: String(formData.get('apellido') || '').trim(),
      });
      renderUser(updatedUser);
      setProfileStatus('Tu perfil se actualizó correctamente.');
      closeDialog();
    } catch (error) {
      console.error('No se pudo actualizar el perfil.', error);
      if (dialogStatus) dialogStatus.textContent = error instanceof Error ? error.message : 'No se pudieron guardar los cambios. Intenta de nuevo.';
    } finally {
      saveButton.disabled = false;
    }
  });

  avatarButton?.addEventListener('click', () => avatarInput?.click());

  avatarInput?.addEventListener('change', async () => {
    const file = avatarInput.files?.[0];
    if (!file) return;
    const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
    if (!allowedTypes.includes(file.type)) {
      setProfileStatus('Elige una imagen JPG, PNG o WEBP.', true);
      avatarInput.value = '';
      return;
    }
    if (file.size > 2 * 1024 * 1024) {
      setProfileStatus('La imagen debe pesar menos de 2 MB.', true);
      avatarInput.value = '';
      return;
    }
    if (!currentUser || !avatarButton) return;

    avatarButton.disabled = true;
    setProfileStatus('Subiendo tu foto de perfil…');
    try {
      const updatedUser = await actualizarAvatar(file);
      renderUser(updatedUser);
      setProfileStatus('Tu foto de perfil se actualizó correctamente.');
    } catch (error) {
      console.error('No se pudo actualizar la foto de perfil.', error);
      setProfileStatus(error instanceof Error ? error.message : 'No se pudo subir la imagen. Intenta de nuevo.', true);
    } finally {
      avatarButton.disabled = false;
      avatarInput.value = '';
    }
  });

  void loadProfile();
</script>

<style>
  .profile-page {
    min-height: calc(100vh - 74px);
    padding: 1.75rem clamp(1rem, 3vw, 2rem) 2.5rem;
    background: #f6fafb;
  }

  .profile-container {
    width: min(100%, 1120px);
    margin: 0 auto;
  }

  .profile-hero {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 184px;
    padding: 1.6rem 2rem;
    border: 1px solid rgba(38, 184, 164, 0.08);
    border-radius: 24px;
    background: linear-gradient(110deg, #e4f8f2 0%, #eef8fb 100%);
  }

  .avatar-wrap { flex: 0 0 auto; }
  .avatar-button {
    position: relative;
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    overflow: hidden;
    border: 5px solid #fff8df;
    border-radius: 28px;
    background: linear-gradient(145deg, #f3c965, #e9a45e);
    color: #fff;
    transition: transform 160ms ease, box-shadow 160ms ease;
  }
  .avatar-button:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(51, 117, 105, 0.16); }
  .avatar-button:focus-visible, .edit-profile-button:focus-visible, .shortcut:focus-visible, .text-link:focus-visible {
    outline: 3px solid #20b8a7;
    outline-offset: 3px;
  }
  .avatar-fallback { font-size: 2.4rem; font-weight: 600; line-height: 1; }
  .avatar-fallback[hidden], .profile-avatar-image[hidden] { display: none; }
  .profile-avatar-image { width: 100%; height: 100%; object-fit: cover; }
  .avatar-edit-icon {
    position: absolute;
    right: 2px;
    bottom: 2px;
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #20b8a7;
  }
  .avatar-edit-icon svg, .edit-profile-button svg { width: 15px; height: 15px; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .profile-identity { min-width: 0; flex: 1; }
  .eyebrow {
    margin: 0 0 0.65rem;
    color: #8999ad;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
  }
  .profile-identity h1 {
    margin: 0;
    color: #26364d;
    font-family: var(--font-sans);
    font-size: clamp(1.85rem, 4vw, 2.55rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 1.1;
  }
  .profile-meta { margin: 0.55rem 0 0; color: #7c8ba0; font-size: 0.88rem; }
  .member-since[hidden] { display: none; }
  .member-since { display: inline-block; margin-top: 0.45rem; color: #8291a4; font-size: 0.76rem; }

  .edit-profile-button {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 42px;
    margin-left: auto;
    padding: 0.65rem 0.9rem;
    border: 1px solid #c8e8e3;
    border-radius: 11px;
    background: #fff;
    color: #10a99b;
    font-size: 0.78rem;
    font-weight: 600;
    transition: background 150ms ease, border-color 150ms ease;
  }
  .edit-profile-button:hover { border-color: #20b8a7; background: #f6fffd; }

  .profile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  .profile-card {
    min-width: 0;
    padding: 1.5rem 1.65rem;
    border: 1px solid #e7eef2;
    border-radius: 19px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(36, 65, 83, 0.035);
  }
  .activity-card, .shortcuts-card { min-height: 298px; }
  .card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .card-heading .eyebrow { margin-bottom: 0.55rem; }
  .card-heading h2 { margin: 0; color: #2a3a50; font-size: 1.22rem; font-weight: 600; letter-spacing: -0.04em; }
  .heading-icon { color: #eba91c; font-size: 1.3rem; line-height: 1; }
  .settings-icon { font-size: 1.5rem; }

  .stats-row { display: flex; gap: clamp(1.4rem, 5vw, 3.2rem); margin: 1.8rem 0 1.15rem; }
  .stat { display: flex; flex-direction: column; gap: 0.35rem; }
  .stat strong { color: #28374d; font-size: 1.55rem; font-weight: 700; letter-spacing: -0.05em; }
  .stat span { color: #8593a7; font-size: 0.72rem; }

  .reading-card { padding: 0.8rem 0.9rem 0.72rem; border-radius: 12px; background: #f5fbfc; }
  .reading-card-top { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; color: #8090a4; font-size: 0.67rem; }
  .reading-card-top strong { color: #14b5a7; font-size: 0.67rem; font-weight: 600; text-align: right; }
  .reading-bar { height: 6px; margin: 0.65rem 0 0.4rem; overflow: hidden; border-radius: 99px; background: #dcebea; }
  .reading-bar span { display: block; width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #1cbaa8, #70c697); transition: width 250ms ease; }
  .reading-card p { margin: 0; color: #eaa01c; font-size: 0.64rem; }
  .text-link { display: inline-flex; align-items: center; gap: 0.55rem; margin-top: 1.25rem; color: #0fae9f; font-size: 0.75rem; font-weight: 600; }
  .text-link span { font-size: 1.15rem; line-height: 0.7; }

  .shortcuts-card { padding-bottom: 0.8rem; }
  .shortcut {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 62px;
    border-bottom: 1px solid #edf1f3;
    transition: background 150ms ease;
  }
  .shortcut:last-child { border-bottom: 0; }
  .shortcut:hover { background: #f9fcfc; }
  .shortcut-icon { display: grid; flex: 0 0 auto; place-items: center; width: 30px; height: 30px; border-radius: 9px; background: #e7f8f3; color: #19b9a6; font-size: 1.12rem; font-weight: 600; }
  .book-icon { color: #4d9ec4; background: #eaf6fb; }
  .explore-icon { color: #d69c19; background: #fff7df; }
  .shortcut-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 0.25rem; }
  .shortcut-copy strong { overflow: hidden; color: #556980; font-size: 0.72rem; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  .shortcut-copy small { overflow: hidden; color: #9aa7b6; font-size: 0.63rem; text-overflow: ellipsis; white-space: nowrap; }
  .shortcut-arrow { color: #91a1b3; font-size: 1.3rem; }

  .badges-card { margin-top: 1rem; }
  .badges-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.7rem; margin-top: 1.2rem; }
  .badge {
    display: flex;
    min-height: 132px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.8rem 0.55rem;
    border: 1px solid transparent;
    border-radius: 13px;
    text-align: center;
    opacity: 0.57;
    filter: saturate(0.72);
    transition: opacity 160ms ease, filter 160ms ease, transform 160ms ease;
  }
  .badge.is-unlocked { opacity: 1; filter: none; }
  .badge-art { margin-bottom: 0.2rem; font-size: 1.5rem; }
  .badge strong { color: #526980; font-size: 0.68rem; font-weight: 600; }
  .badge small { color: #8798aa; font-size: 0.58rem; line-height: 1.4; }
  .badge-mint { background: #e8f8f3; }
  .badge-yellow { background: #fff6d9; }
  .badge-blue { background: #eaf6fc; }
  .badge-peach { background: #fff0e9; }
