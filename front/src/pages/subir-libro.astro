---
import Layout from '../layouts/Layout.astro';

---

<Layout title="Subir Libro – FamiliaLee" description="Sube tu libro en PDF o DOCX.">
  <div class="liga-shell">
    <aside class="app-sidebar" id="app-sidebar">
      <a class="brand" href="/" aria-label="Liga Supersaludables, inicio">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 64 64"><path d="M18 18c0-6.6 5.4-12 12-12h4c6.6 0 12 5.4 12 12v4c0 6.6-5.4 12-12 12h-4c-6.6 0-12-5.4-12-12v-4Z" fill="none" stroke="currentColor" stroke-width="3.5"/><path d="M26 30c0-3.3 2.7-6 6-6s6 2.7 6 6M20 46c5.4-6.5 13.9-10 24-10 4 0 8 .7 12 2" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/></svg>
        </span>
        <span class="brand-text"><strong>Liga</strong><small>SUPER SALUDABLES</small></span>
      </a>
      <button class="drawer-close" id="drawer-close" type="button" aria-label="Cerrar menú">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
      <nav class="app-menu" id="primary-menu" aria-label="Navegación principal">
        <a class="app-menu-item" href="/"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4v-7H9v7H5a1 1 0 0 1-1-1v-8.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span><span>Inicio</span></a>
        <a class="app-menu-item" href="/biblioteca"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h9.5A2.5 2.5 0 0 1 17 7v11.5H7.5A2.5 2.5 0 0 1 5 16V4.5Z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M8 8h7M8 12h7M8 16h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>Cuentos</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 2.5 5 5.5.7-4 3.9 1 5.4-5-2.7-5 2.7 1-5.4-4-3.9 5.5-.7L12 3.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span><span>Niños felices</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5a8.5 8.5 0 1 0 8.5 8.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 12 18 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="12" r="2.25" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span><span>Super Capibara</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 14.5A4.5 4.5 0 0 1 12.5 10h2A4.5 4.5 0 1 1 19 14.5V17a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-2.5Z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M11 6.5a3 3 0 1 1 6 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>Kiwi</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18c0-3.3 2.7-6 6-6s6 2.7 6 6" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="7" r="3" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span><span>Jabonoso</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5v17M3.5 12h17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span><span>Super Z</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8 8 8M8 16l8-8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span><span>Retos</span></a>
        <a class="app-menu-item" href="/panel"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18V9.5M12 18V5M17 18v-8M4 18h16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>Progreso</span></a>
        <div class="sidebar-note"><span aria-hidden="true">✦</span> Pequeños pasos, grandes superpoderes.</div>
      </nav>
    </aside>
    <button class="sidebar-backdrop" id="sidebar-backdrop" type="button" aria-label="Cerrar menú" hidden></button>

    <main class="app-content">
      <header class="topbar">
        <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="primary-menu">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <div class="topbar-actions">
          <div class="notification-wrap">
            <button class="notification-button" id="notification-trigger" type="button" aria-label="Notificaciones" aria-expanded="false" aria-controls="notification-popover">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="notification-popover" id="notification-popover" role="status" hidden>No tienes notificaciones nuevas.</div>
          </div>
          <a class="login-button" id="topbar-login" href="/auth/login">Iniciar sesión</a>
          <div class="account-menu" id="topbar-account" style="display: none;">
            <button class="account-trigger" id="account-trigger" type="button" aria-label="Abrir menú de usuario" aria-expanded="false">
              <span class="account-avatar" id="account-initial">U</span>
              <span class="account-greeting">¡Hola, <span class="account-name" id="account-name">Mi cuenta</span>!</span>
              <svg class="account-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="account-dropdown" id="account-dropdown" hidden>
              <a class="account-menu-link" href="/perfil">Mi perfil</a>
              <a class="account-menu-link" href="/panel">Mi panel</a>
              <button class="account-menu-link account-logout" id="account-logout" type="button">Cerrar sesión</button>
            </div>
          </div>
        </div>
      </header>

      <div class="upload-container">
    <section class="upload-hero">
      <div class="container">
        <h1 class="upload-titulo">📤 Sube tu Libro</h1>
        <p class="upload-subtitle">Carga un PDF o DOCX. Los archivos Word se convierten automáticamente a PDF antes de publicar.</p>
      </div>
    </section>

    <section class="upload-content">
      <div class="container">
        <div class="upload-grid">
          <aside class="upload-visual-column">
            <article class="upload-banner-card">
              <div class="banner-overlay"></div>
              <div class="banner-copy">
                <p class="banner-eyebrow">Publica Tu Historia</p>
                <h2>Convierte tus páginas en una experiencia para toda la familia</h2>
                <p>
                  Sube tu libro en PDF o Word y compártelo con la comunidad de FamiliaLee.
                  Puedes añadir una miniatura para que tu publicación destaque desde el primer vistazo.
                </p>
              </div>
            </article>

            <!-- Zona de Drop -->
            <div class="drop-zone" id="dropZone">
              <svg class="upload-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="17 8 12 3 7 8"/>
                <line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
              <h2>Arrastra tu archivo aquí</h2>
              <p>o haz clic para seleccionar</p>
              <input type="file" id="fileInput" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" style="display: none;" />
            </div>
          </aside>

          <!-- Formulario -->
          <div class="upload-form">
            <h2>Información del Libro</h2>
            
            <div class="form-group">
              <label for="titulo">Título *</label>
              <input type="text" id="titulo" placeholder="Ej: Mi Historia Favorita" required />
            </div>

            <div class="form-group">
              <label for="descripcion">Descripción *</label>
              <textarea id="descripcion" placeholder="Breve descripción del libro" rows="4" required></textarea>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="autor">Autor *</label>
                <input type="text" id="autor" placeholder="Tu nombre" required />
              </div>

              <div class="form-group">
                <label for="edadRango">Edad Recomendada *</label>
                <input type="text" id="edadRango" placeholder="Ej: 5-10" required />
              </div>
            </div>

            <div class="form-group">
              <label for="categoria">Categoría *</label>
              <select id="categoria" required>
                <option value="">Selecciona una categoría</option>
                <option value="Biblia">Biblia</option>
                <option value="Ficción">Ficción</option>
                <option value="Educativo">Educativo</option>
                <option value="Aventura">Aventura</option>
                <option value="Drama">Drama</option>
                <option value="Poesía">Poesía</option>
                <option value="Historia">Historia</option>
                <option value="Otro">Otro</option>
              </select>
            </div>

            <div class="form-group">
              <label for="anio">Año de Publicación</label>
              <input type="number" id="anio" placeholder="2026" value="2026" />
            </div>

            <div class="form-group">
              <label for="coverInput">Miniatura del libro (opcional)</label>
              <input type="file" id="coverInput" accept="image/jpeg,image/png,image/webp,image/gif" />
              <small class="input-help">Formatos permitidos: JPG, PNG, WEBP o GIF (máx 5MB).</small>
            </div>

            <div id="coverPreview" class="cover-preview" style="display: none;">
              <img id="coverPreviewImage" alt="Vista previa de miniatura" />
              <div>
                <p>🖼️ <strong id="coverName"></strong></p>
                <p id="coverSize"></p>
              </div>
            </div>

            <div id="fileInfo" class="file-info" style="display: none;">
              <p>📄 <strong id="fileName"></strong></p>
              <p id="fileSize"></p>
            </div>

            <div id="uploadProgress" class="upload-progress" style="display: none;">
              <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
              </div>
              <p id="progressText">Procesando...</p>
            </div>

            <button id="uploadBtn" class="btn-submit" disabled>Subir Libro</button>

            <div id="uploadStatus" class="upload-status"></div>
          </div>
        </div>
      </div>
    </section>
      </div>
    </main>
  </div>

  <script>
    // @ts-nocheck
    const API_URL = (import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api');
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const uploadBtn = document.getElementById('uploadBtn');
    const fileInfo = document.getElementById('fileInfo');
    const uploadProgress = document.getElementById('uploadProgress');
    const uploadStatus = document.getElementById('uploadStatus');
    const progressFill = document.getElementById('progressFill');
    const progressText = document.getElementById('progressText');
    const coverInput = document.getElementById('coverInput');
    const coverPreview = document.getElementById('coverPreview');
    const coverPreviewImage = document.getElementById('coverPreviewImage');

    let selectedFile = null;
    let selectedCover = null;
    let convertedUploadFile = null;
    const MAX_BOOK_UPLOAD_SIZE = 80 * 1024 * 1024;

    function isUploadFileSizeValid(file) {
      return file.size <= MAX_BOOK_UPLOAD_SIZE;
    }

    function showAuthRequiredModal() {
      const modal = document.getElementById('loginModalOverlay');
      const titleEl = document.getElementById('modalTitle');
      const msgEl = document.getElementById('modalMessage');

      if (titleEl) titleEl.textContent = 'Inicio de sesión requerido';
      if (msgEl) msgEl.textContent = 'Debes iniciar sesión para publicar contenido.';
      if (modal) modal.classList.add('active');
    }

    // Click to upload
    dropZone.addEventListener('click', () => {
      fileInput.click();
    });

    // Drag and drop
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('dragover');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('dragover');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('dragover');
      
      const files = e.dataTransfer.files;
      if (files.length > 0) {
        handleFileSelect(files[0]);
      }
    });

    // File input change
    fileInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) {
        handleFileSelect(e.target.files[0]);
      }
    });

    coverInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) {
        handleCoverSelect(e.target.files[0]);
      } else {
        clearCover();
      }
    });

    function getReadableSize(file) {
      return `${(file.size / 1024 / 1024).toFixed(2)} MB`;
    }

    function isPdfFile(file) {
      if (!file) return false;
      return file.type === 'application/pdf' || /\.pdf$/i.test(file.name || '');
    }

    function isDocxFile(file) {
      if (!file) return false;
      return (
        file.type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
        /\.docx$/i.test(file.name || '')
      );
    }

    function isDocFile(file) {
      if (!file) return false;
      return file.type === 'application/msword' || /\.doc$/i.test(file.name || '');
    }

    function updateFileInfo(file, originalName = null) {
      const title = originalName
        ? `${file.name} (convertido desde ${originalName})`
        : file.name;

      document.getElementById('fileName').textContent = title;
      document.getElementById('fileSize').textContent = getReadableSize(file);
      fileInfo.style.display = 'block';
      uploadBtn.disabled = false;
    }

    async function convertDocxToPdf(file) {
      const mammoth = await import('https://esm.sh/mammoth@1.9.0?bundle');
      const { jsPDF } = await import('https://esm.sh/jspdf@2.5.1');
      const html2canvas = (await import('https://esm.sh/html2canvas@1.4.1')).default;

      const arrayBuffer = await file.arrayBuffer();
      const result = await mammoth.convertToHtml(
        { arrayBuffer },
        {
          convertImage: mammoth.images.imgElement((image) => {
            return image.read('base64').then((base64) => ({
              src: `data:${image.contentType};base64,${base64}`,
            }));
          }),
        }
      );
      const html = String(result?.value || '').trim();

      if (!html) {
        throw new Error('No se pudo leer el contenido del archivo DOCX.');
      }

      const renderHost = document.createElement('div');
      renderHost.style.position = 'fixed';
      renderHost.style.left = '-3000px';
      renderHost.style.top = '0';
      renderHost.style.pointerEvents = 'none';
      renderHost.style.zIndex = '0';
      renderHost.style.width = '794px';
      renderHost.style.padding = '24px';
      renderHost.style.background = '#ffffff';
      renderHost.style.color = '#111111';
      renderHost.style.fontFamily = 'Georgia, serif';
      renderHost.style.fontSize = '14px';
      renderHost.style.lineHeight = '1.6';
      renderHost.innerHTML = html;

      // Evita desbordes y preserva imágenes dentro de página.
      renderHost.querySelectorAll('img').forEach((img) => {
        img.style.maxWidth = '100%';
        img.style.height = 'auto';
        img.style.display = 'block';
        img.style.margin = '0.6rem auto';
      });

      document.body.appendChild(renderHost);

      const waitImageLoaded = (img) =>
        new Promise((resolve) => {
          if (img.complete) {
            resolve();
            return;
          }
          img.addEventListener('load', () => resolve(), { once: true });
          img.addEventListener('error', () => resolve(), { once: true });
        });

      const images = Array.from(renderHost.querySelectorAll('img'));
      await Promise.all(images.map((img) => waitImageLoaded(img)));
      await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));

      const renderedCanvas = await html2canvas(renderHost, {
        scale: 2,
        useCORS: true,
        allowTaint: true,
        backgroundColor: '#ffffff',
        logging: false,
      });

      renderHost.remove();

      const pdf = new jsPDF({
        orientation: 'portrait',
        unit: 'pt',
        format: 'a4',
      });

      const pageWidth = pdf.internal.pageSize.getWidth();
      const pageHeight = pdf.internal.pageSize.getHeight();
      const margin = 20;
      const contentWidth = pageWidth - margin * 2;
      const contentHeight = pageHeight - margin * 2;

      const pxPerPt = renderedCanvas.width / contentWidth;
      const sliceHeightPx = Math.floor(contentHeight * pxPerPt);

      let offsetY = 0;
      let firstPage = true;

      while (offsetY < renderedCanvas.height) {
        const currentSliceHeight = Math.min(sliceHeightPx, renderedCanvas.height - offsetY);
        const pageCanvas = document.createElement('canvas');
        pageCanvas.width = renderedCanvas.width;
        pageCanvas.height = currentSliceHeight;

        const pageCtx = pageCanvas.getContext('2d');
        if (!pageCtx) {
          throw new Error('No se pudo preparar el render de la página PDF.');
        }

        pageCtx.fillStyle = '#ffffff';
        pageCtx.fillRect(0, 0, pageCanvas.width, pageCanvas.height);
        pageCtx.drawImage(
          renderedCanvas,
          0,
          offsetY,
          renderedCanvas.width,
          currentSliceHeight,
          0,
          0,
          renderedCanvas.width,
          currentSliceHeight
        );

        const pageDataUrl = pageCanvas.toDataURL('image/jpeg', 0.98);
        const renderHeightPt = currentSliceHeight / pxPerPt;

        if (!firstPage) {
          pdf.addPage();
        }

        pdf.addImage(pageDataUrl, 'JPEG', margin, margin, contentWidth, renderHeightPt, undefined, 'FAST');

        firstPage = false;
        offsetY += currentSliceHeight;
      }

      const pdfBlob = pdf.output('blob');
      const outputName = file.name.replace(/\.docx$/i, '.pdf');
      return new File([pdfBlob], outputName, { type: 'application/pdf' });
    }

    async function convertDocToPdf(file) {
      const { jsPDF } = await import('https://esm.sh/jspdf@2.5.1');

      const arrayBuffer = await file.arrayBuffer();
      const bytes = new Uint8Array(arrayBuffer);
      let text = '';

      // Intento básico para .doc binario: leer texto visible y limpiar ruido.
      for (let i = 0; i < bytes.length; i += 1) {
        const b = bytes[i];
        if (b === 9 || b === 10 || b === 13 || (b >= 32 && b <= 126) || (b >= 160 && b <= 255)) {
          text += String.fromCharCode(b);
        } else {
          text += ' ';
        }
      }

      text = text
        .replace(/\s+/g, ' ')
        .replace(/([.!?])\s+/g, '$1\n\n')
        .trim();

      if (!text) {
        throw new Error('No se pudo extraer texto del archivo DOC.');
      }

      const pdf = new jsPDF({
        orientation: 'portrait',
        unit: 'pt',
        format: 'a4',
      });

      pdf.setFont('times', 'normal');
      pdf.setFontSize(12);

      const pageWidth = pdf.internal.pageSize.getWidth();
      const pageHeight = pdf.internal.pageSize.getHeight();
      const margin = 40;
      const maxLineWidth = pageWidth - margin * 2;
      const lineHeight = 18;
      const paragraphs = text
        .split(/\n{2,}/)
        .map((p) => p.trim())
        .filter(Boolean);

      let cursorY = margin;

      for (const paragraph of paragraphs) {
        const lines = pdf.splitTextToSize(paragraph, maxLineWidth);

        for (const line of lines) {
          if (cursorY > pageHeight - margin) {
            pdf.addPage();
            cursorY = margin;
          }

          pdf.text(line, margin, cursorY);
          cursorY += lineHeight;
        }

        cursorY += lineHeight * 0.5;
      }

      const pdfBlob = pdf.output('blob');
      const outputName = file.name.replace(/\.doc$/i, '.pdf');
      return new File([pdfBlob], outputName, { type: 'application/pdf' });
    }

    async function handleFileSelect(file) {
      if (!isPdfFile(file) && !isDocxFile(file) && !isDocFile(file)) {
        fileInput.value = '';
        showError('⚠️ Por favor sube un archivo PDF, DOCX o DOC.');
        return;
      }

      if (!isUploadFileSizeValid(file)) {
        fileInput.value = '';
        showError(`⚠️ El archivo no puede superar ${Math.round(MAX_BOOK_UPLOAD_SIZE / 1024 / 1024)} MB.`);
        return;
      }

      uploadStatus.innerHTML = '';
      uploadBtn.disabled = true;
      uploadProgress.style.display = 'block';
      progressFill.style.width = '15%';

      try {
        selectedFile = file;
        convertedUploadFile = file;

        if (isDocxFile(file)) {
          progressText.textContent = 'Convirtiendo DOCX a PDF...';
          progressFill.style.width = '45%';
          convertedUploadFile = await convertDocxToPdf(file);
          progressText.textContent = 'Conversión completa. Listo para subir.';
          progressFill.style.width = '100%';
          updateFileInfo(convertedUploadFile, file.name);
        } else if (isDocFile(file)) {
          progressText.textContent = 'Convirtiendo DOC a PDF...';
          progressFill.style.width = '45%';
          convertedUploadFile = await convertDocToPdf(file);
          progressText.textContent = 'Conversión completa. Nota: para conservar imágenes usa DOCX.';
          progressFill.style.width = '100%';
          updateFileInfo(convertedUploadFile, file.name);
        } else {
          progressText.textContent = 'Archivo PDF listo para subir.';
          progressFill.style.width = '100%';
          updateFileInfo(file);
        }
      } catch (error) {
        selectedFile = null;
        convertedUploadFile = null;
        fileInfo.style.display = 'none';
        uploadBtn.disabled = true;
        showError(`⚠️ No se pudo convertir el archivo Word: ${error.message}`);
      } finally {
        window.setTimeout(() => {
          uploadProgress.style.display = 'none';
          progressFill.style.width = '0%';
          progressText.textContent = 'Procesando...';
        }, 500);
      }
    }

    function handleCoverSelect(file) {
      const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
      if (!validTypes.includes(file.type)) {
        showError('⚠️ La miniatura debe ser JPG, PNG, WEBP o GIF.');
        coverInput.value = '';
        clearCover();
        return;
      }

      if (file.size > 5 * 1024 * 1024) {
        showError('⚠️ La miniatura no puede superar 5MB.');
        coverInput.value = '';
        clearCover();
        return;
      }

      selectedCover = file;
      document.getElementById('coverName').textContent = file.name;
      document.getElementById('coverSize').textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB`;
      coverPreviewImage.src = URL.createObjectURL(file);
      coverPreview.style.display = 'flex';
    }

    function clearCover() {
      selectedCover = null;
      coverPreview.style.display = 'none';
      coverPreviewImage.removeAttribute('src');
    }

    uploadBtn.addEventListener('click', async () => {
      if (!selectedFile || !convertedUploadFile) return;

      const titulo = document.getElementById('titulo').value.trim();
      const descripcion = document.getElementById('descripcion').value.trim();
      const autor = document.getElementById('autor').value.trim();
      const categoria = document.getElementById('categoria').value;
      const edadRango = document.getElementById('edadRango').value.trim();
      const anio = parseInt(document.getElementById('anio').value) || new Date().getFullYear();

      if (!titulo || !descripcion || !autor || !categoria || !edadRango) {
        showError('⚠️ Completa todos los campos obligatorios.');
        return;
      }

      const token = localStorage.getItem('token');
      if (!token) {
        showAuthRequiredModal();
        return;
      }

      uploadBtn.disabled = true;
      uploadProgress.style.display = 'block';
      progressText.textContent = 'Subiendo archivo PDF a la nube...';

      try {
        // Leemos el archivo en base64 para enviarlo al backend
        const fileBase64 = await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = (e) => resolve(e.target.result);
          reader.onerror = (e) => reject(new Error('Error al leer el archivo'));
          reader.readAsDataURL(convertedUploadFile);
        });

        let coverBase64 = null;
        if (selectedCover) {
          coverBase64 = await new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = (e) => resolve(e.target.result);
            reader.onerror = () => reject(new Error('Error al leer la miniatura'));
            reader.readAsDataURL(selectedCover);
          });
        }

        progressText.textContent = 'Guardando metadatos del libro...';
        progressFill.style.width = '50%';

        // Enviar al backend
        const response = await fetch(`${API_URL}/libros/upload`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({
            titulo,
            descripcion,
            autor,
            categoria,
            edad_rango: edadRango,
            anio,
            fileName: convertedUploadFile.name,
            fileBase64,
            mimeType: convertedUploadFile.type,
            coverName: selectedCover?.name || null,
            coverBase64,
            coverMimeType: selectedCover?.type || null
          })
        });

        progressFill.style.width = '90%';
        progressText.textContent = 'Completando...';

        if (response.status === 401) {
          showAuthRequiredModal();
          throw new Error('Tu sesión expiró. Inicia sesión nuevamente.');
        }

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.error || 'Error desconocido');
        }

        const result = await response.json();
        progressFill.style.width = '100%';
        showSuccess(`✅ ¡Libro subido exitosamente! Redirigiendo al dashboard...`);
        
        // Reset form
        document.querySelectorAll('input, textarea, select').forEach(el => {
          if (el.type !== 'file' && el.type !== 'number') el.value = '';
          if (el.id === 'anio') el.value = new Date().getFullYear();
        });
        selectedFile = null;
        convertedUploadFile = null;
        clearCover();
        fileInfo.style.display = 'none';
        uploadBtn.disabled = true;
        uploadProgress.style.display = 'none';
        fileInput.value = '';
        coverInput.value = '';

        setTimeout(() => {
          window.location.href = '/';
        }, 1200);

      } catch (error) {
        showError(`❌ Error: ${error.message}`);
      } finally {
        uploadBtn.disabled = false;
        progressFill.style.width = '0%';
      }
    });

    function showError(msg) {
      uploadStatus.innerHTML = `<div class="status-error">${msg}</div>`;
      uploadStatus.scrollIntoView({ behavior: 'smooth' });
    }

    function showSuccess(msg) {
      uploadStatus.innerHTML = `<div class="status-success">${msg}</div>`;
      uploadStatus.scrollIntoView({ behavior: 'smooth' });
    }
  </script>

  <script>
    import { getUsuario, logout } from '../utils/api';

    const loginLink = document.getElementById('topbar-login');
    const accountMenu = document.getElementById('topbar-account');
    const accountTrigger = document.getElementById('account-trigger') as HTMLButtonElement | null;
    const accountDropdown = document.getElementById('account-dropdown');
    const accountInitial = document.getElementById('account-initial');
    const accountName = document.getElementById('account-name');
    const logoutButton = document.getElementById('account-logout');
    const notificationTrigger = document.getElementById('notification-trigger') as HTMLButtonElement | null;
    const notificationPopover = document.getElementById('notification-popover');
    const sidebar = document.getElementById('app-sidebar');
    const sidebarToggle = document.getElementById('sidebar-toggle') as HTMLButtonElement | null;
    const sidebarBackdrop = document.getElementById('sidebar-backdrop') as HTMLButtonElement | null;
    const drawerClose = document.getElementById('drawer-close');
    const usuario = getUsuario();

    function closeSidebar() {
      sidebar?.classList.remove('is-open');
      if (sidebarBackdrop) sidebarBackdrop.hidden = true;
      sidebarToggle?.setAttribute('aria-expanded', 'false');
      sidebarToggle?.setAttribute('aria-label', 'Abrir menú');
      document.body.style.overflow = '';
    }

    sidebarToggle?.addEventListener('click', () => {
      const isOpen = sidebar?.classList.toggle('is-open') ?? false;
      if (sidebarBackdrop) sidebarBackdrop.hidden = !isOpen;
      sidebarToggle.setAttribute('aria-expanded', String(isOpen));
      sidebarToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    sidebarBackdrop?.addEventListener('click', closeSidebar);
    drawerClose?.addEventListener('click', closeSidebar);
    sidebar?.querySelectorAll('.app-menu-item').forEach((item) => item.addEventListener('click', closeSidebar));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeSidebar();
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > 680) closeSidebar();
    });

    notificationTrigger?.addEventListener('click', () => {
      const expanded = notificationTrigger.getAttribute('aria-expanded') === 'true';
      notificationTrigger.setAttribute('aria-expanded', String(!expanded));
      if (notificationPopover) notificationPopover.hidden = expanded;
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && !target.closest('.notification-wrap')) {
        notificationTrigger?.setAttribute('aria-expanded', 'false');
        if (notificationPopover) notificationPopover.hidden = true;
      }
      if (target instanceof Node && !accountMenu?.contains(target)) {
        accountTrigger?.setAttribute('aria-expanded', 'false');
        if (accountDropdown) accountDropdown.hidden = true;
      }
    });

    if (usuario && localStorage.getItem('token')) {
      if (loginLink) loginLink.hidden = true;
      if (accountMenu) accountMenu.style.display = 'block';
      if (accountInitial) accountInitial.textContent = usuario.nombre?.trim().charAt(0).toLocaleUpperCase('es') || 'U';
      if (accountName) accountName.textContent = usuario.nombre?.trim() || 'Mi cuenta';

      accountTrigger?.addEventListener('click', () => {
        const expanded = accountTrigger.getAttribute('aria-expanded') === 'true';
        accountTrigger.setAttribute('aria-expanded', String(!expanded));
        if (accountDropdown) accountDropdown.hidden = expanded;
      });

      logoutButton?.addEventListener('click', () => {
        logout();
        window.location.href = '/';
      });
    }
  </script>

