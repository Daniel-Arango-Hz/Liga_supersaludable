---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { obtenerLibros } from '../utils/api';

const validOrders = new Set(['todos', 'destacado', 'nuevo', 'descargas', 'rating']);
const ordenParam = Astro.url.searchParams.get('orden') ?? 'todos';
const orden = validOrders.has(ordenParam) ? ordenParam : 'todos';
const filtroCategoria = Astro.url.searchParams.get('categoria') ?? '';
const filtroEdad = Astro.url.searchParams.get('edad') ?? '';
const q = Astro.url.searchParams.get('q') ?? '';

// Obtener libros del backend
let respuesta: any = { data: [] };
let catalogoCompleto: any[] = [];
try {
  const [respuestaFiltrada, respuestaCatalogo] = await Promise.all([
    obtenerLibros({
    orden: orden === 'todos' ? undefined : (orden as 'destacado' | 'nuevo' | 'descargas' | 'rating'),
    categoria: filtroCategoria || undefined,
    edad: filtroEdad || undefined,
    q: q || undefined,
    limite: 1000,
    }),
    obtenerLibros({ limite: 1000 }),
  ]);

  respuesta = respuestaFiltrada;
  catalogoCompleto = respuestaCatalogo.data || [];
} catch (error) {
  console.error('Error al obtener libros:', error);
}

const catalogoLibros: any[] = catalogoCompleto.length ? catalogoCompleto : (respuesta.data || []);
const normalizarTexto = (texto: string) =>
  texto.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es');
const textoBusqueda = normalizarTexto(q.trim());

let librosFiltrados = [...catalogoLibros];
if (orden === 'nuevo') {
  librosFiltrados = librosFiltrados.filter((libro: any) => libro.nuevo);
} else if (orden === 'destacado') {
  librosFiltrados.sort((a: any, b: any) => Number(Boolean(b.destacado)) - Number(Boolean(a.destacado)));
} else if (orden === 'descargas') {
  librosFiltrados.sort((a: any, b: any) => (b.descargas_total || 0) - (a.descargas_total || 0));
} else if (orden === 'rating') {
  librosFiltrados.sort((a: any, b: any) => (b.rating_promedio || 0) - (a.rating_promedio || 0));
}

librosFiltrados = librosFiltrados.filter((libro: any) => {
  const categoriasLibro = (libro.categorias || []).map((categoria: string) => normalizarTexto(categoria));
  const coincideCategoria = !filtroCategoria || categoriasLibro.includes(normalizarTexto(filtroCategoria));
  const coincideEdad = !filtroEdad || libro.edad_rango === filtroEdad;
  const textoLibro = normalizarTexto([
    libro.titulo,
    libro.autor_nombre,
    libro.descripcion,
    ...(libro.categorias || []),
  ].filter(Boolean).join(' '));
  return coincideCategoria && coincideEdad && (!textoBusqueda || textoLibro.includes(textoBusqueda));
});
const slugsVisiblesIniciales = new Set(librosFiltrados.map((libro: any) => libro.slug));

// Obtener categorías únicas del backend
const categorias: string[] = Array.from(
  new Set((catalogoCompleto.length ? catalogoCompleto : librosFiltrados).flatMap((l: any) => l.categorias || []))
);

// Obtener rangos de edad únicos del backend
const edades: string[] = Array.from(
  new Set((catalogoCompleto.length ? catalogoCompleto : librosFiltrados).map((l: any) => l.edad_rango).filter(Boolean))
);

function buildBibliotecaUrl(next: { orden?: string; categoria?: string; edad?: string; q?: string }) {
  const params = new URLSearchParams();
  const ordenNext = next.orden !== undefined ? next.orden : orden;
  params.set('orden', ordenNext || 'todos');
  const categoria = next.categoria !== undefined ? next.categoria : filtroCategoria;
  const edad = next.edad !== undefined ? next.edad : filtroEdad;
  const texto = next.q !== undefined ? next.q : q;
  if (categoria) params.set('categoria', categoria);
  if (edad) params.set('edad', edad);
  if (texto) params.set('q', texto);
  return `/biblioteca?${params.toString()}`;
}
---

<Layout title="Biblioteca – FamiliaLee" description="Explora todos los libros y recursos de FamiliaLee.">
  <main class="app-content">
      <section class="page-hero">
        <div class="hero-content">
          <p class="hero-kicker">UN MUNDO DE AVENTURAS</p>
          <h1 class="page-title">Cuentos Super Saludables</h1>
          <p class="page-desc">Conoce a nuestros superhéroes y descubre historias que te enseñan a cuidar tu cuerpo, tus emociones y el planeta.</p>
          <a class="publish-book-button" id="publish-book-button" href="/subir-libro">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 16V4m0 0L7 9m5-5 5 5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Publicar libro
          </a>
        </div>
        <div class="hero-illustration" aria-hidden="true">
          <svg viewBox="0 0 260 220" fill="none">
            <circle class="illustration-orbit" cx="132" cy="116" r="86" />
            <path class="illustration-page-left" d="M47 92c26-11 51-7 77 8v77c-26-15-51-19-77-8V92Z" />
            <path class="illustration-page-right" d="M201 92c-26-11-51-7-77 8v77c26-15 51-19 77-8V92Z" />
            <path class="illustration-spine" d="M124 100v77" />
            <path class="illustration-line" d="M62 110c17-5 34-2 49 5M62 127c17-5 34-2 49 5M62 144c17-5 34-2 49 5M186 110c-17-5-34-2-49 5M186 127c-17-5-34-2-49 5M186 144c-17-5-34-2-49 5" />
            <path class="illustration-star" d="m177 29 7 14 15 2-11 11 3 15-14-7-13 7 2-15-11-11 15-2 7-14Z" />
            <circle class="illustration-spark" cx="67" cy="54" r="5" />
            <circle class="illustration-spark" cx="204" cy="76" r="4" />
          </svg>
        </div>
      </section>

      <section class="catalog-section">
      <form class="book-toolbar" id="book-search-form" action="/biblioteca" method="get">
        <label class="search-box">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7.5" stroke="currentColor" stroke-width="1.8"/><path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          <span class="visually-hidden">Buscar un cuento</span>
          <input type="search" name="q" value={q} placeholder="Buscar un cuento..." />
          <input id="active-order" type="hidden" name="orden" value={orden} />
          <input id="active-category" type="hidden" name="categoria" value={filtroCategoria} />
          <input id="active-age" type="hidden" name="edad" value={filtroEdad} />
        </label>

        <div class="toolbar-filters">
          <label class="filter-label" for="book-filter">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.5 5.5h17l-6.6 7.4v5.5l-3.8 2v-7.5L3.5 5.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
            <span>Filtrar por:</span>
          </label>
          <div class="select-wrap book-filter-wrap">
            <label class="select-label" for="book-filter">Orden o categoría</label>
            <button
              id="book-filter"
              class="filter-menu-button"
              type="button"
              aria-label="Filtrar por orden o categoría"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="book-filter-menu"
            >
              <span id="book-filter-current">{filtroCategoria || (orden === 'todos' ? 'Todos' : ({ destacado: 'Destacados', nuevo: 'Nuevos', descargas: 'Más descargados', rating: 'Mejor valorados' }[orden] || 'Todos'))}</span>
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 6 5 5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="filter-menu" id="book-filter-menu" role="menu" aria-label="Filtrar libros" hidden>
              <button type="button" role="menuitemradio" aria-checked={!filtroCategoria && orden === 'todos'} data-filter-kind="reset" data-filter-value="">Todos</button>
              <div class="filter-menu-heading" role="presentation">Ordenar por</div>
              {[
                { value: 'destacado', label: 'Destacados' },
                { value: 'nuevo', label: 'Nuevos' },
                { value: 'descargas', label: 'Más descargados' },
                { value: 'rating', label: 'Mejor valorados' },
              ].map(({ value, label }) => (
                <button type="button" role="menuitemradio" aria-checked={!filtroCategoria && orden === value} data-filter-kind="orden" data-filter-value={value}>{label}</button>
              ))}
              <div class="filter-menu-heading" role="presentation">Categoría</div>
              <button type="button" role="menuitemradio" aria-checked={!filtroCategoria} data-filter-kind="categoria" data-filter-value="">Todas las categorías</button>
              {categorias.map((cat) => (
                <button type="button" role="menuitemradio" aria-checked={filtroCategoria === cat} data-filter-kind="categoria" data-filter-value={cat}>{cat}</button>
              ))}
            </div>
          </div>
          <div class="select-wrap age-select-wrap">
            <span class="select-label">Edad</span>
            <button
              id="age-filter"
              class="age-filter-button"
              type="button"
              aria-label="Filtrar por edad"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="age-filter-menu"
            >
              <span id="age-filter-current">{filtroEdad || 'Todas las edades'}</span>
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 6 5 5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="age-filter-menu" id="age-filter-menu" role="menu" aria-label="Filtrar por edad" hidden>
              <button type="button" role="menuitemradio" aria-checked={!filtroEdad} data-age="">Todas las edades</button>
              {edades.map((edad) => (
                <button type="button" role="menuitemradio" aria-checked={filtroEdad === edad} data-age={edad}>{edad}</button>
              ))}
            </div>
          </div>
        </div>
      </form>

      <div class="biblioteca-layout">
        <div class="main-content">
          <div class="results-header">
            <p class="results-count">
              <strong id="results-count">{librosFiltrados.length}</strong> <span id="results-label">{librosFiltrados.length === 1 ? 'libro encontrado' : 'libros encontrados'}</span>
              <span id="results-query" hidden={!q}> para "<em>{q}</em>"</span>
            </p>
          </div>

          <div class="books-grid" id="books-grid">
              {catalogoLibros.map((libro: any, index: number) => {
                // Adaptar datos del backend al formato esperado por BookCard
                const libroAdaptado = {
                  slug: libro.slug,
                  titulo: libro.titulo,
                  autor: libro.autor_nombre || 'Anónimo',
                  familiaInfo: libro.familia_nombre || libro.autor_nombre || '',
                  autorSlug: libro.autor_slug || (libro.autor_nombre || 'anonimo').toLowerCase().replace(/\s+/g, '-'),
                  descripcion: libro.descripcion,
                  portadaGradiente: libro.portada_gradiente || 'from-blue-500 to-indigo-600',
                  portadaIcono: libro.portada_icono || '📖',
                  categorias: libro.categorias || [],
                  rating: libro.rating_promedio || 0,
                  votos: libro.total_valoraciones || 0,
                  likes: libro.likes_total || libro.total_valoraciones || 0,
                  descargas: libro.descargas_total || 0,
                  vistas: libro.vistas_total || libro.vistas || libro.descargas_total || 0,
                  edadRango: libro.edad_rango || '5-12',
                  destacado: libro.destacado || false,
                  nuevo: libro.nuevo || false,
                  paginas: Number(libro.paginas ?? libro.paginas_total ?? (Array.isArray(libro.paginas) ? libro.paginas.length : 0)),
                  anio: libro.anio || new Date().getFullYear(),
                  paginasContenido: Array.isArray(libro.paginas) ? libro.paginas : [],
                };
                const categoriasLibro = libro.categorias || [];
                const textoLibro = [
                  libro.titulo,
                  libro.autor_nombre,
                  libro.descripcion,
                  ...categoriasLibro,
                ].filter(Boolean).join(' ');
                return (
                  <div
                    class="book-result"
                    data-search={textoLibro}
                    data-categories={JSON.stringify(categoriasLibro)}
                    data-age={libro.edad_rango || ''}
                    data-new={String(Boolean(libro.nuevo))}
                    data-featured={String(Boolean(libro.destacado))}
                    data-downloads={String(libro.descargas_total || 0)}
                    data-rating={String(libro.rating_promedio || 0)}
                    data-original-order={String(index)}
                    hidden={!slugsVisiblesIniciales.has(libro.slug)}
                  >
                    <BookCard libro={libroAdaptado} variante="catalogo" />
                  </div>
                );
              })}
          </div>
          <div class="empty-state" id="empty-results" hidden={librosFiltrados.length > 0}>
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="3" y="4" width="13" height="16" rx="2"/>
              <path d="M7 8h5M7 12h5M7 16h3" stroke-linecap="round"/>
              <circle cx="18" cy="18" r="4"/>
              <line x1="20.83" y1="20.83" x2="22.5" y2="22.5"/>
            </svg>
            <p>No se encontraron libros con los filtros seleccionados.</p>
            <a href="/biblioteca" class="btn-reset">Ver todos los libros</a>
          </div>
        </div>
      </div>
      </section>
    </main>
</Layout>



<style>
  .liga-shell {
    display: flex;
    min-height: 100vh;
    background: linear-gradient(180deg, #f5fbfa 0%, #eef7f3 100%);
    color: #2c465c;
  }

  .sidebar-toggle,
  .sidebar-backdrop,
  .drawer-close { display: none; }

  .app-sidebar {
    position: sticky;
    top: 0;
    box-sizing: border-box;
    width: 260px;
    height: 100vh;
    height: 100svh;
    flex: 0 0 260px;
    overflow-y: auto;
    padding: 18px 18px 30px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: rgba(255, 255, 255, 0.35);
    border-right: 1px solid #d8ece9;
  }

  .brand {
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 8px 10px;
    text-decoration: none;
  }

  .brand-mark {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, #8ce0d3, #46b9ae);
    box-shadow: 0 8px 16px rgba(74, 188, 184, 0.24);
  }

  .brand-mark svg { width: 24px; height: 24px; }

  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-text strong { color: #1aa7a0; font: 700 2.1rem Georgia, 'Times New Roman', serif; letter-spacing: -0.08em; }
  .brand-text small { margin-top: 2px; color: #1a9c98; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; }

  .app-menu {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
  }

  .app-menu-item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 12px 12px 14px;
    border-radius: 14px;
    color: #2c465c;
    font-size: 1.02rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .app-menu-item:hover { background: rgba(133, 215, 198, 0.16); }
  .app-menu-item.active { background: rgba(133, 215, 198, 0.34); box-shadow: inset 0 0 0 1px rgba(26, 159, 150, 0.12); }

  .app-menu-icon {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
    color: #168f83;
    background: #d7f4eb;
    border-radius: 12px;
    transition: transform 0.22s ease;
  }

  .app-menu-item:nth-child(2) .app-menu-icon { color: #e57650; background: #ffeadf; }
  .app-menu-item:nth-child(3) .app-menu-icon { color: #b58216; background: #fff2c9; }
  .app-menu-item:nth-child(4) .app-menu-icon { color: #4c8cbd; background: #dff2ff; }
  .app-menu-item:nth-child(5) .app-menu-icon { color: #6f9e45; background: #e9f5d9; }
  .app-menu-item:nth-child(6) .app-menu-icon { color: #db7693; background: #ffe5ec; }
  .app-menu-item:nth-child(7) .app-menu-icon { color: #9473c2; background: #eee6ff; }
  .app-menu-item:nth-child(8) .app-menu-icon { color: #d48b3f; background: #fff0dc; }
  .app-menu-item:nth-child(9) .app-menu-icon { color: #328f9a; background: #dcf4f4; }
  .app-menu-item:hover .app-menu-icon { transform: translateY(-2px) rotate(-5deg) scale(1.06); }
  .app-menu-icon svg { width: 21px; height: 21px; }

  .menu-dot {
    width: 7px;
    height: 7px;
    margin-left: auto;
    border-radius: 50%;
    background: #1a8f86;
  }

  .sidebar-note {
    margin-top: auto;
    padding: 18px 8px 4px;
    border-top: 1px solid rgba(29, 72, 82, 0.08);
    color: #4d6678;
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .sidebar-note span { color: #e9a73a; }

  .app-content {
    min-width: 0;
    flex: 1;
    padding: 20px 32px 36px 28px;
  }

  .topbar { min-height: 56px; display: flex; align-items: center; justify-content: flex-end; gap: 16px; }
  .topbar-spacer { flex: 1; }
  .topbar-actions { display: flex; align-items: center; gap: 14px; }
  .notification-wrap, .account-menu { position: relative; }

  .notification-button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(48, 130, 125, 0.2);
    border-radius: 15px;
    background: rgba(255, 255, 255, 0.78);
    color: #286b70;
    cursor: pointer;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .notification-button:hover, .notification-button[aria-expanded="true"] { transform: translateY(-2px); background: #fff; }
  .notification-button svg { width: 21px; height: 21px; }

  .notification-popover, .account-dropdown {
    position: absolute;
    z-index: 10;
    top: calc(100% + 8px);
    right: 0;
    border: 1px solid rgba(48, 130, 125, 0.16);
    border-radius: 13px;
    background: #fff;
    box-shadow: 0 16px 36px rgba(34, 70, 76, 0.16);
  }

  .notification-popover { width: max-content; max-width: min(280px, calc(100vw - 40px)); padding: 13px 15px; font-size: 0.88rem; }
  .notification-popover[hidden], .account-dropdown[hidden] { display: none; }

  .login-button, .account-trigger {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 6px 12px;
    border: 1px solid rgba(48, 130, 125, 0.2);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.78);
    color: #286b70;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 5px 16px rgba(42, 101, 102, 0.07);
    transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }

  .login-button[hidden] { display: none; }
  .login-button:hover, .account-trigger:hover { transform: translateY(-2px); background: #fff; box-shadow: 0 9px 20px rgba(42, 101, 102, 0.12); }
  .account-avatar { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 11px; background: linear-gradient(145deg, #f6b38a, #ed825f); color: #fff; font-size: 1rem; font-weight: 800; }
  .account-greeting { white-space: nowrap; }
  .account-name { max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .account-chevron { width: 18px; height: 18px; transition: transform 0.18s ease; }
  .account-trigger[aria-expanded="true"] .account-chevron { transform: rotate(180deg); }
  .account-dropdown { width: 190px; padding: 6px; }
  .account-menu-link { width: 100%; display: block; padding: 10px 12px; border: 0; border-radius: 9px; background: transparent; color: #2c465c; font: inherit; font-size: 0.9rem; text-align: left; text-decoration: none; cursor: pointer; }
  .account-menu-link:hover { background: #eaf8f4; }
  .account-logout { color: #b64f43; border-top: 1px solid #edf1f1; }

  @media (prefers-reduced-motion: reduce) {
    .app-menu-icon, .login-button, .account-trigger, .notification-button { transition: none; }
  }

  .page-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(190px, 260px);
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    margin-top: 14px;
    padding: clamp(24px, 3.5vw, 38px) clamp(24px, 3.5vw, 42px);
    border-radius: 24px;
    color: #2c465c;
    background: linear-gradient(135deg, #d8f4ee 0%, #e1f2f7 100%);
  }

  .hero-content {
    width: 100%;
    max-width: 760px;
  }

  .hero-kicker { margin: 0 0 8px; color: #26877f; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; }
  .page-title {
    margin: 0;
    color: #2c405d;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    line-height: 1.1;
    font-weight: 800;
  }

  .page-desc {
    margin: 12px 0 0;
    color: #526d7c;
    font-size: 1rem;
    line-height: 1.5;
    max-width: 600px;
  }

  .hero-illustration {
    display: grid;
    width: 100%;
    place-items: center;
    color: #168f83;
  }

  .hero-illustration svg { display: block; width: min(100%, 250px); overflow: visible; }
  .illustration-orbit { fill: rgba(255, 255, 255, 0.3); stroke: rgba(22, 143, 131, 0.12); stroke-width: 2; }
