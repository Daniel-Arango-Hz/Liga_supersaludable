        <a class="app-menu-item active" href="/biblioteca" aria-current="page"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4.5h9.5A2.5 2.5 0 0 1 17 7v11.5H7.5A2.5 2.5 0 0 1 5 16V4.5Z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M8 8h7M8 12h7M8 16h5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>Cuentos</span><span class="menu-dot"></span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 2.5 5 5.5.7-4 3.9 1 5.4-5-2.7-5 2.7 1-5.4-4-3.9 5.5-.7L12 3.5Z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg></span><span>Niños felices</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5a8.5 8.5 0 1 0 8.5 8.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M12 12 18 6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="12" r="2.25" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span><span>Super Capibara</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 14.5A4.5 4.5 0 0 1 12.5 10h2A4.5 4.5 0 1 1 19 14.5V17a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-2.5Z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M11 6.5a3 3 0 1 1 6 0" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>Kiwi</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 18c0-3.3 2.7-6 6-6s6 2.7 6 6" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="7" r="3" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span><span>Jabonoso</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5v17M3.5 12h17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span><span>Super Z</span></a>
        <a class="app-menu-item" href="/recursos"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8 8 8M8 16l8-8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span><span>Retos</span></a>
        <a class="app-menu-item" href="/panel"><span class="app-menu-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18V9.5M12 18V5M17 18v-8M4 18h16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg></span><span>Progreso</span></a>
        <div class="sidebar-note"><span aria-hidden="true">✦</span> Pequeños pasos, grandes superpoderes.</div>
      </nav>
    </aside>
    <button class="sidebar-backdrop" id="sidebar-backdrop" type="button" aria-label="Cerrar menú" hidden></button>

    <main class="app-content">
      <header class="topbar">
        <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="primary-menu">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <div class="topbar-actions">
          <div class="notification-wrap">
            <button class="notification-button" id="notification-trigger" type="button" aria-label="Notificaciones" aria-expanded="false" aria-controls="notification-popover">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="notification-popover" id="notification-popover" role="status" hidden>No tienes notificaciones nuevas.</div>
          </div>
          <a class="login-button" id="topbar-login" href="/auth/login">Iniciar sesión</a>
          <div class="account-menu" id="topbar-account" style="display: none;">
            <button class="account-trigger" id="account-trigger" type="button" aria-label="Abrir menú de usuario" aria-expanded="false">
              <span class="account-avatar" id="account-initial">U</span>
              <span class="account-greeting">¡Hola, <span class="account-name" id="account-name">Mi cuenta</span>!</span>
              <svg class="account-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7.5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="account-dropdown" id="account-dropdown" hidden>
              <a class="account-menu-link" href="/perfil">Mi perfil</a>
              <a class="account-menu-link" href="/panel">Mi panel</a>
              <button class="account-menu-link account-logout" id="account-logout" type="button">Cerrar sesión</button>
            </div>
          </div>
        </div>
      </header>

      <section class="page-hero">
        <div class="hero-content">
          <p class="hero-kicker">BIBLIOTECA FAMILIAR</p>
          <h1 class="page-title">Descubre historias increíbles</h1>
          <p class="page-desc">Explora libros llenos de aventuras, valores y diversión para toda la familia.</p>
          <a class="publish-book-button" href="/subir-libro">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 16V4m0 0L7 9m5-5 5 5M4 15v4a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Publicar libro
          </a>
        </div>
      </section>

      <section class="catalog-section">
      <div class="biblioteca-layout">
        <aside class="filters-panel" aria-label="Filtros de libros">
          <div class="sidebar-section">
            <h2 class="sidebar-title">Ordenar por</h2>
            <ul class="filter-list">
              {[
                { value: 'todos', label: 'Todos' },
                { value: 'destacado', label: 'Destacados' },
                { value: 'nuevo', label: 'Nuevos' },
                { value: 'descargas', label: 'Más descargados' },
                { value: 'rating', label: 'Mejor valorados' },
              ].map(({ value, label }) => (
                <li>
                  <a
                    href={buildBibliotecaUrl({ orden: value })}
                    data-filter-kind="orden"
                    data-filter-value={value}
                    class={`filter-link ${orden === value ? 'active' : ''}`}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="sidebar-section">
            <h2 class="sidebar-title">Categoría</h2>
            <ul class="filter-list">
              <li>
                <a href={buildBibliotecaUrl({ categoria: '' })} data-filter-kind="categoria" data-filter-value="" class={`filter-link ${!filtroCategoria ? 'active' : ''}`}>
                  Todas
                </a>
              </li>
              {categorias.map((cat) => (
                <li>
                  <a
                    href={buildBibliotecaUrl({ categoria: cat })}
                    data-filter-kind="categoria"
                    data-filter-value={cat}
                    class={`filter-link ${filtroCategoria === cat ? 'active' : ''}`}
                  >
                    {cat}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="sidebar-section">
            <h2 class="sidebar-title">Edad</h2>
            <ul class="filter-list">
              <li>
                <a href={buildBibliotecaUrl({ edad: '' })} data-filter-kind="edad" data-filter-value="" class={`filter-link ${!filtroEdad ? 'active' : ''}`}>
                  Todas las edades
                </a>
              </li>
              {edades.map((edad) => (
                <li>
                  <a
                    href={buildBibliotecaUrl({ edad })}
                    data-filter-kind="edad"
                    data-filter-value={edad}
                    class={`filter-link ${filtroEdad === edad ? 'active' : ''}`}
                  >
                    {edad}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <!-- Grid de libros -->
        <div class="main-content">
          <div class="results-header">
            <p class="results-count">
              <strong>{librosFiltrados.length}</strong> {librosFiltrados.length === 1 ? 'libro encontrado' : 'libros encontrados'}
              {q && <span> para "<em>{q}</em>"</span>}
            </p>
          </div>

          {librosFiltrados.length > 0 ? (
            <div class="books-grid">
              {librosFiltrados.map((libro: any) => {
                // Adaptar datos del backend al formato esperado por BookCard
                const libroAdaptado = {
                  slug: libro.slug,
                  titulo: libro.titulo,
                  autor: libro.autor_nombre || 'Anónimo',
                  familiaInfo: libro.familia_nombre || libro.autor_nombre || '',
                  autorSlug: libro.autor_slug || (libro.autor_nombre || 'anonimo').toLowerCase().replace(/\s+/g, '-'),
                  descripcion: libro.descripcion,
                  portadaGradiente: libro.portada_gradiente || 'from-blue-500 to-indigo-600',
                  portadaIcono: libro.portada_icono || '📖',
                  categorias: libro.categorias || [],
                  rating: libro.rating_promedio || 0,
                  votos: libro.total_valoraciones || 0,
                  likes: libro.likes_total || libro.total_valoraciones || 0,
                  descargas: libro.descargas_total || 0,
                  vistas: libro.vistas_total || libro.vistas || libro.descargas_total || 0,
                  edadRango: libro.edad_rango || '5-12',
                  destacado: libro.destacado || false,
                  nuevo: libro.nuevo || false,
                  paginas: Number(libro.paginas ?? libro.paginas_total ?? (Array.isArray(libro.paginas) ? libro.paginas.length : 0)),
                  anio: libro.anio || new Date().getFullYear(),
                  paginasContenido: Array.isArray(libro.paginas) ? libro.paginas : [],
                };
                return <BookCard libro={libroAdaptado} />;
              })}
            </div>
          ) : (
            <div class="empty-state">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="3" y="4" width="13" height="16" rx="2"/>
                <path d="M7 8h5M7 12h5M7 16h3" stroke-linecap="round"/>
                <circle cx="18" cy="18" r="4"/>
                <line x1="20.83" y1="20.83" x2="22.5" y2="22.5"/>
              </svg>
              <p>No se encontraron libros con los filtros seleccionados.</p>
              <a href="/biblioteca" class="btn-reset">Ver todos los libros</a>
            </div>
          )}
        </div>
      </div>
      </section>
    </main>
  </div>
</Layout>

<script>
  import { getUsuario, logout } from '../utils/api';

  const loginLink = document.getElementById('topbar-login');
  const accountMenu = document.getElementById('topbar-account');
  const accountTrigger = document.getElementById('account-trigger') as HTMLButtonElement | null;
  const accountDropdown = document.getElementById('account-dropdown');
  const accountInitial = document.getElementById('account-initial');
  const accountName = document.getElementById('account-name');
  const logoutButton = document.getElementById('account-logout');
  const notificationTrigger = document.getElementById('notification-trigger') as HTMLButtonElement | null;
  const notificationPopover = document.getElementById('notification-popover');
  const sidebar = document.getElementById('app-sidebar');
  const sidebarToggle = document.getElementById('sidebar-toggle') as HTMLButtonElement | null;
  const sidebarBackdrop = document.getElementById('sidebar-backdrop') as HTMLButtonElement | null;
  const drawerClose = document.getElementById('drawer-close');
  const usuario = getUsuario();

  function closeSidebar() {
    sidebar?.classList.remove('is-open');
    if (sidebarBackdrop) sidebarBackdrop.hidden = true;
    sidebarToggle?.setAttribute('aria-expanded', 'false');
    sidebarToggle?.setAttribute('aria-label', 'Abrir menú');
    document.body.style.overflow = '';
  }

  sidebarToggle?.addEventListener('click', () => {
    const isOpen = sidebar?.classList.toggle('is-open') ?? false;
    if (sidebarBackdrop) sidebarBackdrop.hidden = !isOpen;
    sidebarToggle.setAttribute('aria-expanded', String(isOpen));
    sidebarToggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    document.body.style.overflow = isOpen ? 'hidden' : '';
  });

  sidebarBackdrop?.addEventListener('click', closeSidebar);
  drawerClose?.addEventListener('click', closeSidebar);
  sidebar?.querySelectorAll('.app-menu-item').forEach((item) => item.addEventListener('click', closeSidebar));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeSidebar();
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 680) closeSidebar();
  });

  notificationTrigger?.addEventListener('click', () => {
    const expanded = notificationTrigger.getAttribute('aria-expanded') === 'true';
    notificationTrigger.setAttribute('aria-expanded', String(!expanded));
    if (notificationPopover) notificationPopover.hidden = expanded;
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof Element && !target.closest('.notification-wrap')) {
      notificationTrigger?.setAttribute('aria-expanded', 'false');
      if (notificationPopover) notificationPopover.hidden = true;
    }
    if (target instanceof Node && !accountMenu?.contains(target)) {
      accountTrigger?.setAttribute('aria-expanded', 'false');
      if (accountDropdown) accountDropdown.hidden = true;
    }
  });

  if (usuario && localStorage.getItem('token')) {
    if (loginLink) loginLink.hidden = true;
    if (accountMenu) accountMenu.style.display = 'block';
    if (accountInitial) accountInitial.textContent = usuario.nombre?.trim().charAt(0).toLocaleUpperCase('es') || 'U';
    if (accountName) accountName.textContent = usuario.nombre?.trim() || 'Mi cuenta';

    accountTrigger?.addEventListener('click', () => {
      const expanded = accountTrigger.getAttribute('aria-expanded') === 'true';
      accountTrigger.setAttribute('aria-expanded', String(!expanded));
      if (accountDropdown) accountDropdown.hidden = expanded;
    });

    logoutButton?.addEventListener('click', () => {
      logout();
      window.location.href = '/';
    });
  }
</script>

<style>
  .liga-shell {
    display: flex;
    min-height: 100vh;
    background: linear-gradient(180deg, #f5fbfa 0%, #eef7f3 100%);
    color: #2c465c;
  }

  .sidebar-toggle,
  .sidebar-backdrop,
  .drawer-close { display: none; }

  .app-sidebar {
    position: sticky;
    top: 0;
    box-sizing: border-box;
    width: 260px;
    height: 100vh;
    height: 100svh;
    flex: 0 0 260px;
    overflow-y: auto;
    padding: 18px 18px 30px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: rgba(255, 255, 255, 0.35);
    border-right: 1px solid #d8ece9;
  }

  .brand {
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 4px 8px 10px;
    text-decoration: none;
  }

  .brand-mark {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(135deg, #8ce0d3, #46b9ae);
    box-shadow: 0 8px 16px rgba(74, 188, 184, 0.24);
  }

  .brand-mark svg { width: 24px; height: 24px; }

  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-text strong { color: #1aa7a0; font: 700 2.1rem Georgia, 'Times New Roman', serif; letter-spacing: -0.08em; }
  .brand-text small { margin-top: 2px; color: #1a9c98; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.12em; }

  .app-menu {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
  }

  .app-menu-item {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 12px 12px 12px 14px;
    border-radius: 14px;
    color: #2c465c;
    font-size: 1.02rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .app-menu-item:hover { background: rgba(133, 215, 198, 0.16); }
  .app-menu-item.active { background: rgba(133, 215, 198, 0.34); box-shadow: inset 0 0 0 1px rgba(26, 159, 150, 0.12); }

  .app-menu-icon {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
    color: #168f83;
    background: #d7f4eb;
    border-radius: 12px;
    transition: transform 0.22s ease;
  }

  .app-menu-item:nth-child(2) .app-menu-icon { color: #e57650; background: #ffeadf; }
  .app-menu-item:nth-child(3) .app-menu-icon { color: #b58216; background: #fff2c9; }
  .app-menu-item:nth-child(4) .app-menu-icon { color: #4c8cbd; background: #dff2ff; }
  .app-menu-item:nth-child(5) .app-menu-icon { color: #6f9e45; background: #e9f5d9; }
  .app-menu-item:nth-child(6) .app-menu-icon { color: #db7693; background: #ffe5ec; }
  .app-menu-item:nth-child(7) .app-menu-icon { color: #9473c2; background: #eee6ff; }
  .app-menu-item:nth-child(8) .app-menu-icon { color: #d48b3f; background: #fff0dc; }
  .app-menu-item:nth-child(9) .app-menu-icon { color: #328f9a; background: #dcf4f4; }
  .app-menu-item:hover .app-menu-icon { transform: translateY(-2px) rotate(-5deg) scale(1.06); }
  .app-menu-icon svg { width: 21px; height: 21px; }

  .menu-dot {
    width: 7px;
    height: 7px;
    margin-left: auto;
    border-radius: 50%;
    background: #1a8f86;
  }

  .sidebar-note {
    margin-top: auto;
    padding: 18px 8px 4px;
    border-top: 1px solid rgba(29, 72, 82, 0.08);
    color: #4d6678;
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .sidebar-note span { color: #e9a73a; }

  .app-content {
    min-width: 0;
    flex: 1;
