</style>

<script>
  const publishBookButton = document.getElementById('publish-book-button') as HTMLAnchorElement;
  publishBookButton?.addEventListener('click', (event) => {
    if (window.localStorage.getItem('token')) return;

    event.preventDefault();
    const modal = document.getElementById('loginModalOverlay');
    const title = document.getElementById('modalTitle');
    const message = document.getElementById('modalMessage');
    if (title) title.textContent = 'Inicio de sesión requerido';
    if (message) message.textContent = 'Debes iniciar sesión para publicar un libro.';
    modal?.classList.add('active');
  });

  const searchForm = document.getElementById('book-search-form') as HTMLFormElement;
  const searchInput = searchForm?.querySelector('input[name="q"]') as HTMLInputElement;
  const bookFilter = document.getElementById('book-filter') as HTMLButtonElement;
  const bookFilterMenu = document.getElementById('book-filter-menu') as HTMLDivElement;
  const bookFilterCurrent = document.getElementById('book-filter-current') as HTMLSpanElement;
  const ageFilter = document.getElementById('age-filter') as HTMLButtonElement;
  const ageFilterMenu = document.getElementById('age-filter-menu') as HTMLDivElement;
  const ageFilterCurrent = document.getElementById('age-filter-current') as HTMLSpanElement;
  const activeAge = document.getElementById('active-age') as HTMLInputElement;
  const activeOrder = document.getElementById('active-order') as HTMLInputElement;
  const activeCategory = document.getElementById('active-category') as HTMLInputElement;
  const booksGrid = document.getElementById('books-grid') as HTMLDivElement;
  const resultCount = document.getElementById('results-count') as HTMLElement;
  const resultLabel = document.getElementById('results-label') as HTMLElement;
  const resultQuery = document.getElementById('results-query') as HTMLElement;
  const emptyResults = document.getElementById('empty-results') as HTMLDivElement;
  const bookResults = Array.from(document.querySelectorAll<HTMLElement>('.book-result'));

  function normalizeSearch(value: string) {
    return value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es').trim();
  }

  function getSelectedOrder() {
    return activeOrder.value || 'todos';
  }

  function updateBookFilters() {
    const url = new URL(window.location.href);
    const query = searchInput.value.trim();
    if (activeOrder.value && activeOrder.value !== 'todos') url.searchParams.set('orden', activeOrder.value);
    else url.searchParams.delete('orden');
    if (activeCategory.value) url.searchParams.set('categoria', activeCategory.value);
    else url.searchParams.delete('categoria');
    if (activeAge.value) url.searchParams.set('edad', activeAge.value);
    else url.searchParams.delete('edad');
    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');

    window.history.replaceState({}, '', url);
    applyBookFilters();
  }

  function setMenuOpen(button: HTMLButtonElement, menu: HTMLDivElement, open: boolean) {
    button.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    if (open) {
      menu.querySelector<HTMLButtonElement>('[aria-checked="true"]')?.focus();
    }
  }

  bookFilter?.addEventListener('click', () => {
    const open = bookFilter.getAttribute('aria-expanded') !== 'true';
    setMenuOpen(bookFilter, bookFilterMenu, open);
    if (open) setMenuOpen(ageFilter, ageFilterMenu, false);
  });

  bookFilterMenu?.addEventListener('click', (event) => {
    const option = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter-kind]');
    if (!option) return;

    const kind = option.dataset.filterKind;
    if (kind === 'reset') {
      activeOrder.value = 'todos';
      activeCategory.value = '';
    } else if (kind === 'orden') {
      activeOrder.value = option.dataset.filterValue || 'todos';
      activeCategory.value = '';
    } else if (kind === 'categoria') {
      activeCategory.value = option.dataset.filterValue || '';
    }

    bookFilterMenu.querySelectorAll<HTMLButtonElement>('[data-filter-kind]').forEach((item) => {
      const selected =
        (item.dataset.filterKind === 'reset' && !activeCategory.value && activeOrder.value === 'todos') ||
        (item.dataset.filterKind === 'orden' && !activeCategory.value && item.dataset.filterValue === activeOrder.value) ||
        (item.dataset.filterKind === 'categoria' && item.dataset.filterValue === activeCategory.value);
      item.setAttribute('aria-checked', String(selected));
    });

    const orderLabels: Record<string, string> = {
      todos: 'Todos',
      destacado: 'Destacados',
      nuevo: 'Nuevos',
      descargas: 'Más descargados',
      rating: 'Mejor valorados',
    };
    bookFilterCurrent.textContent = activeCategory.value || orderLabels[activeOrder.value] || 'Todos';
    setMenuOpen(bookFilter, bookFilterMenu, false);
    updateBookFilters();
    bookFilter.focus();
  });

  ageFilter?.addEventListener('click', () => {
    const open = ageFilter.getAttribute('aria-expanded') !== 'true';
    setMenuOpen(ageFilter, ageFilterMenu, open);
    if (open) setMenuOpen(bookFilter, bookFilterMenu, false);
  });

  ageFilterMenu?.addEventListener('click', (event) => {
    const option = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-age]');
    if (!option) return;

    activeAge.value = option.dataset.age || '';
    ageFilterCurrent.textContent = option.textContent?.trim() || 'Todas las edades';
    ageFilterMenu.querySelectorAll<HTMLButtonElement>('[data-age]').forEach((item) => {
      item.setAttribute('aria-checked', String(item === option));
    });
    setMenuOpen(ageFilter, ageFilterMenu, false);
    updateBookFilters();
    ageFilter.focus();
  });

  function handleMenuKeyboard(
    event: KeyboardEvent,
    button: HTMLButtonElement,
    menu: HTMLDivElement,
  ) {
    const items = Array.from(menu.querySelectorAll<HTMLButtonElement>('[role="menuitemradio"]'));
    if (event.key === 'Escape') {
      event.preventDefault();
      setMenuOpen(button, menu, false);
      button.focus();
      return;
    }
    if (button === document.activeElement && ['ArrowDown', 'Enter', ' '].includes(event.key)) {
      event.preventDefault();
      setMenuOpen(button, menu, true);
      return;
    }
    if (!items.includes(document.activeElement as HTMLButtonElement)) return;

    const currentIndex = items.indexOf(document.activeElement as HTMLButtonElement);
    const nextIndex = event.key === 'ArrowDown'
      ? (currentIndex + 1) % items.length
      : event.key === 'ArrowUp'
        ? (currentIndex - 1 + items.length) % items.length
        : event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? items.length - 1
            : -1;
    if (nextIndex >= 0) {
      event.preventDefault();
      items[nextIndex].focus();
    }
  }

  [bookFilter, ageFilter].forEach((button) => {
    const menu = button === bookFilter ? bookFilterMenu : ageFilterMenu;
    button.addEventListener('keydown', (event) => handleMenuKeyboard(event, button, menu));
    menu.addEventListener('keydown', (event) => handleMenuKeyboard(event, button, menu));
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (!ageFilterMenu.contains(event.target) && !ageFilter.contains(event.target)) {
      setMenuOpen(ageFilter, ageFilterMenu, false);
    }
    if (!bookFilterMenu.contains(event.target) && !bookFilter.contains(event.target)) {
      setMenuOpen(bookFilter, bookFilterMenu, false);
    }
  });

  searchInput?.addEventListener('input', () => {
    updateBookFilters();
  });

  searchForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    updateBookFilters();
  });

  function applyBookFilters() {
    if (!booksGrid) return;
    const query = normalizeSearch(searchInput.value);
    const category = normalizeSearch(activeCategory.value || '');
    const order = getSelectedOrder();
    let visibleCount = 0;

    const matchingBooks = bookResults.filter((book) => {
      const matchesQuery = !query || normalizeSearch(book.dataset.search || '').includes(query);
      const matchesCategory = !category || normalizeSearch(book.dataset.categories || '').includes(`"${category}"`);
      const matchesAge = !activeAge.value || book.dataset.age === activeAge.value;
      const matchesNew = order !== 'nuevo' || book.dataset.new === 'true';
      return matchesQuery && matchesCategory && matchesAge && matchesNew;
    });

    matchingBooks.sort((a, b) => {
      if (order === 'destacado') {
        const featuredDifference = Number(b.dataset.featured === 'true') - Number(a.dataset.featured === 'true');
        if (featuredDifference) return featuredDifference;
      } else if (order === 'descargas') {
        const downloadDifference = Number(b.dataset.downloads) - Number(a.dataset.downloads);
        if (downloadDifference) return downloadDifference;
      } else if (order === 'rating') {
        const ratingDifference = Number(b.dataset.rating) - Number(a.dataset.rating);
        if (ratingDifference) return ratingDifference;
      }
      return Number(a.dataset.originalOrder) - Number(b.dataset.originalOrder);
    });

    for (const book of bookResults) book.hidden = true;
    for (const book of matchingBooks) {
      book.hidden = false;
      booksGrid.append(book);
      visibleCount += 1;
    }

    resultCount.textContent = String(visibleCount);
    resultLabel.textContent = visibleCount === 1 ? 'libro encontrado' : 'libros encontrados';
    resultQuery.hidden = !query;
    resultQuery.textContent = query ? ` para "${searchInput.value.trim()}"` : '';
    emptyResults.hidden = visibleCount > 0;
  }

  applyBookFilters();
</script>
