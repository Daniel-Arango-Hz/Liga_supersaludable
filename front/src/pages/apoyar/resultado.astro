---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Estado de tu aporte – CBI Personitas" description="Consulta el estado del aporte realizado a la biblioteca.">
  <main class="result-page">
    <section class="result-content container">
      <p class="eyebrow">APORTE A LA BIBLIOTECA</p>
      <h1 id="result-title">Consultando tu pago</h1>
      <p id="result-message" role="status" aria-live="polite">Estamos verificando la respuesta de Wompi.</p>
      <dl id="transaction-summary" hidden>
        <div><dt>Referencia</dt><dd id="reference"></dd></div>
        <div><dt>Valor</dt><dd id="amount"></dd></div>
        <div><dt>Medio de pago</dt><dd id="method"></dd></div>
      </dl>
      <a class="return-link" href="/">Volver a la biblioteca</a>
    </section>
  </main>
</Layout>

<script>
  const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';
  const params = new URLSearchParams(window.location.search);
  const transactionId = params.get('id');
  const title = document.querySelector<HTMLElement>('#result-title');
  const message = document.querySelector<HTMLElement>('#result-message');
  const summary = document.querySelector<HTMLDListElement>('#transaction-summary');
  const terminalStatuses = new Set(['APPROVED', 'DECLINED', 'VOIDED', 'ERROR']);

  function setResult(status: string, transaction?: { reference: string; amountInCents: number; currency: string; paymentMethod?: string }) {
    const copy: Record<string, { title: string; message: string }> = {
      APPROVED: { title: '¡Gracias por tu aporte!', message: 'Wompi confirmó el pago. Tu apoyo ayuda a que los recursos sigan disponibles para las familias.' },
      DECLINED: { title: 'El pago no fue aprobado', message: 'No se realizó el aporte. Puedes intentarlo de nuevo desde la página de apoyo.' },
      VOIDED: { title: 'Pago cancelado', message: 'El aporte fue cancelado y no se realizó ningún cobro.' },
      ERROR: { title: 'No se pudo completar el pago', message: 'Wompi informó un error al procesar el aporte. Puedes intentarlo de nuevo.' },
      PENDING: { title: 'Tu pago sigue en proceso', message: 'El banco aún no confirma el resultado. Puedes volver a consultar más tarde.' },
      PROCESSING: { title: 'Tu pago sigue en proceso', message: 'El banco aún no confirma el resultado. Puedes volver a consultar más tarde.' },
    };
    const result = copy[status] ?? copy.PENDING;
    if (title) title.textContent = result.title;
    if (message) message.textContent = result.message;

    if (transaction && summary) {
      summary.hidden = false;
      const reference = document.querySelector<HTMLElement>('#reference');
      const amount = document.querySelector<HTMLElement>('#amount');
      const method = document.querySelector<HTMLElement>('#method');
      if (reference) reference.textContent = transaction.reference;
      if (amount) amount.textContent = new Intl.NumberFormat('es-CO', { style: 'currency', currency: transaction.currency }).format(transaction.amountInCents / 100);
      if (method) method.textContent = transaction.paymentMethod || 'PSE';
    }
  }

  async function checkStatus() {
    if (!transactionId) {
      if (title) title.textContent = 'No encontramos la transacción';
      if (message) message.textContent = 'Vuelve a la biblioteca o contacta al equipo si ya realizaste el pago.';
      return;
    }

    for (let attempt = 0; attempt < 8; attempt += 1) {
      try {
        const response = await fetch(`${apiUrl}/pagos/wompi/transacciones/${encodeURIComponent(transactionId)}`);
        const transaction = await response.json();
        if (response.ok) {
          setResult(transaction.status, transaction);
          if (terminalStatuses.has(transaction.status)) return;
        }
      } catch {
        // Mantener el mensaje pendiente mientras la respuesta de Wompi se propaga.
      }

      await new Promise((resolve) => window.setTimeout(resolve, 2500));
    }

    setResult('PENDING');
  }

  checkStatus();
</script>

<style>
  .result-page { min-height: 55vh; padding: 4rem 0; background: #f8f5ef; }
  .result-content { max-width: 720px; }
  .eyebrow { color: #176b59; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.08em; }
  h1 { margin-top: 0.8rem; color: #173f37; font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3rem); }
  #result-message { max-width: 560px; margin-top: 0.8rem; color: #52645e; line-height: 1.7; }
  dl { display: grid; gap: 0; max-width: 460px; margin-top: 2rem; border-top: 1px solid #cad8d1; }
  dl[hidden] { display: none; }
  dl div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.8rem 0; border-bottom: 1px solid #cad8d1; }
  dt { color: #687771; }
  dd { color: #173f37; font-weight: 700; text-align: right; }
  .return-link { display: inline-flex; margin-top: 2rem; color: #176b59; font-weight: 700; text-decoration: underline; text-underline-offset: 0.2em; }
</style>