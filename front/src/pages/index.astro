---
import Layout from '../layouts/Layout.astro';
const actividades = [
  {
    titulo: 'Cuentos',
    descripcion: 'Súper saludables',
    badge: '3 nuevos',
    clase: 'card-mint',
    href: '/biblioteca',
    img: '/img/cuentos.png',
  },
  {
    titulo: 'Libro viajero',
    descripcion: 'Aventuras para compartir',
    badge: 'Leer ahora',
    clase: 'card-sky',
   img: '/img/cuentos-viejos.png',
  },
  {
    titulo: 'Super Capibara',
    descripcion: 'Salud total',
    badge: 'Jugar',
    clase: 'card-orange',
  img: '/img/super-capibara.png',
  },
  {
    titulo: 'Kiwi',
    descripcion: 'Bienestar emocional',
    badge: 'Explorar',
    clase: 'card-yellow',
    icon: '<svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="23" stroke="currentColor" stroke-width="4"/><path d="M24 27h.1M40 27h.1M23 38c2 5 5 8 9 8s7-3 9-8" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>',
  },
  {
    titulo: 'Jabonoso',
    descripcion: 'Hábitos saludables',
    badge: 'Aprender',
    clase: 'card-coral',
    icon: '<svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M32 19c-12-10-26-1-26 14 0 14 12 26 22 21 3-2 5-2 8 0 10 5 22-7 22-21 0-15-14-24-26-14ZM32 18V8m0 0c-6 0-9 3-9 8" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
  {
    titulo: 'Super Z',
    descripcion: 'Hábitos saludables',
    badge: 'Descubrir',
    clase: 'card-purple',
    icon: '<svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="m13 52 14-34 10 10 14-8-5 15 10 10-35 13-8-6Z" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><path d="M27 18c-2-8 3-13 7-15 5 6 5 11 3 17" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
  {
    titulo: 'Retos',
    descripcion: 'Juegos para divertirse',
    badge: '2 pendientes',
    clase: 'card-green',
    icon: '<svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M19 20h26a11 11 0 0 1 10 8l4 18c1 6-6 9-10 5l-9-8H24l-9 8c-4 4-11 1-10-5l4-18a11 11 0 0 1 10-8Z" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><path d="M20 30v12m-6-6h12m17-3h.1m8 7h.1" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>',
  },
  {
    titulo: 'Retos y desafíos',
    descripcion: 'Supera nuevas pruebas',
    badge: 'Comenzar',
    clase: 'card-peach',
    icon: '<svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="M14 12h36v20a18 18 0 0 1-36 0V12Zm0 7H8a8 8 0 0 0 0 16h8m34-16h6a8 8 0 0 1 0 16h-8M32 50v8m-12 0h24" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
  {
    titulo: 'Mi progreso',
    descripcion: 'Mira cuánto has avanzado',
    badge: 'Ver avance',
    clase: 'card-blue',
    icon: '<svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><path d="m36 5-25 31h18l-2 23 26-34H35l1-20Z" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
];
---

<Layout>
    <main class="home-content">
      <section class="hero-card" aria-label="Bienvenido a Liga Supersaludables">
        <img class="hero-image" src="/img/image.png" alt="Bienvenido a Liga Supersaludables, con dos superhéroes infantiles" fetchpriority="high" />
      </section>

      <section class="activities">
        <div class="section-header activities-header">
          <div class="activity-heading">
            <svg class="activity-star" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M16 2.5 19.7 12l9.8 4-9.8 4L16 29.5 12.3 20l-9.8-4 9.8-4L16 2.5Z" fill="currentColor" />
              <path d="m24.5 2 .9 2.3 2.3.9-2.3.9-.9 2.3-.9-2.3-2.3-.9 2.3-.9.9-2.3Z" fill="currentColor" />
            </svg>
            <div>
              <h2>¡Hoy es un gran día!</h2>
              <p>Elige una actividad y sigue cuidando de ti</p>
            </div>
          </div>
        </div>

        <a class="see-all" href="#todas-actividades">Ver todas <span>›</span></a>

        <div class="activity-grid" id="todas-actividades">
          {actividades.map((actividad) => (
            <article class={`activity-card ${actividad.clase}`}>
              {actividad.href && <a class="activity-card-link" href={actividad.href} aria-label={`Abrir ${actividad.titulo}`}></a>}
              <div class="activity-art">
                <span class="activity-badge">{actividad.badge}</span>
                {actividad.img ? (
                  <img class="activity-image" src={actividad.img} alt="Niño leyendo un libro" loading="lazy" />
                ) : (
                  <>
                    <span class="activity-spark spark-one" aria-hidden="true"></span>
                    <span class="activity-spark spark-two" aria-hidden="true"></span>
                    <span class="activity-icon" set:html={actividad.icon}></span>
                  </>
                )}
              </div>
              <div class="activity-details">
                <div class="activity-copy">
                  <span class="activity-label">{actividad.titulo}</span>
                  <span class="activity-description">{actividad.descripcion}</span>
                </div>
                {actividad.href && <span class="activity-arrow" aria-hidden="true">›</span>}
              </div>
            </article>
          ))}
        </div>
      </section>
    </main>
</Layout>

<style>
  .hero-card {
    margin-top: 14px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 14px 32px rgba(31, 64, 68, 0.1);
  }

  .hero-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .activities {
    margin-top: 34px;
    position: relative;
  }

  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .eyebrow {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #4f6b7b;
    font-size: 0.8rem;
    font-weight: 800;
    margin-bottom: 6px;
  }

  .section-header h2 {
    font-size: clamp(2rem, 3vw, 3rem);
    margin: 0;
    color: #2e405e;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .activities-header {
    align-items: center;
    margin-bottom: 22px;
  }

  .activity-heading {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .activity-star {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    color: #f2ae3b;
    filter: drop-shadow(0 4px 5px rgba(213, 142, 37, 0.2));
  }

  .activity-heading h2 {
    font-size: clamp(1.7rem, 2.5vw, 2.35rem);
    line-height: 1.15;
  }

  .activity-heading p {
    margin: 6px 0 0;
    color: #607889;
    font-size: 1rem;
    line-height: 1.45;
  }

  .see-all {
    position: absolute;
    right: 0;
    top: 26px;
    color: #3b7f86;
    font-size: 1.08rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .see-all span {
    font-size: 1.8rem;
    line-height: 1;
  }

  .activity-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px 22px;
    margin-top: 16px;
    scroll-margin-top: 24px;
  }

  .activity-card {
    min-width: 0;
    position: relative;
    border-radius: 24px;
    background: #fff;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 12px 26px rgba(31, 64, 68, 0.07);
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .activity-card-link {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
  }

  .activity-card-link:focus-visible {
    outline: 3px solid #247f78;
    outline-offset: 3px;
  }

  .activity-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 32px rgba(31, 64, 68, 0.13);
  }

  .activity-art {
    height: 164px;
    flex: 0 0 164px;
    position: relative;
    display: grid;
    place-items: center;
    color: #fff;
  }

  .card-mint .activity-art { background: #72d2bf; }
  .card-sky .activity-art { background: #79c0df; }
  .card-orange .activity-art { background: #ffc367; }
  .card-yellow .activity-art { background: #f6dc68; }
  .card-coral .activity-art { background: #f5a49b; }
  .card-purple .activity-art { background: #b29ae3; }
  .card-green .activity-art { background: #98c98c; }
  .card-peach .activity-art { background: #f3977e; }
  .card-blue .activity-art { background: #91cddd; }

  .activity-badge {
    position: absolute;
    top: 9px;
    right: 12px;
    z-index: 2;
    background: rgba(255, 255, 255, 0.82);
    color: #42687b;
    padding: 7px 11px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .activity-icon {
    width: 66px;
    height: 66px;
    display: block;
    z-index: 1;
  }

  .activity-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .activity-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 47%;
  }

  .activity-spark {
    position: absolute;
    width: 10px;
    height: 10px;
    background: rgba(255, 255, 255, 0.86);
    transform: rotate(45deg);
  }

  .spark-one {
    top: 26px;
    left: 25%;
  }

  .spark-two {
    right: 22%;
    bottom: 29px;
    width: 9px;
    height: 9px;
  }

  .activity-details {
    min-height: 86px;
    padding: 14px 18px 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .activity-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .activity-description {
    color: #8294a9;
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .activity-arrow {
    width: 36px;
    height: 36px;
    flex: 0 0 36px;
    border: 1px solid #e2ebf3;
    border-radius: 50%;
    background: #fff;
    color: #7890a7;
    font-size: 1.8rem;
    line-height: 1;
    display: grid;
    place-items: center;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .activity-card:hover .activity-arrow {
    transform: translateX(2px);
    border-color: #b7d6d5;
  }

  .activity-label {
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 1.02rem;
    color: #2d405d;
    font-weight: 700;
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .activity-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 680px) {
    .activity-grid { grid-template-columns: 1fr; }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .see-all {
      position: static;
      margin-bottom: 12px;
    }
  }
</style>
