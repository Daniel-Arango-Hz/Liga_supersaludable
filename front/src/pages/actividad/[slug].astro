---
import Layout from '../../layouts/Layout.astro';
import { actividades } from '../../data/actividades';

const { slug } = Astro.params;
const actividad = actividades.find((item) => item.slug === slug);
const esProgreso = slug === 'progreso';

if (!actividad && !esProgreso) {
  return Astro.redirect('/');
}

const titulo = esProgreso ? 'Mi progreso' : actividad!.titulo;
const descripcion = esProgreso
  ? 'Mira los pasos que has completado en tus actividades.'
  : actividad!.descripcion;
---

<Layout title={`${titulo} | Liga Supersaludable`} description={descripcion}>
  <main class:list={['activity-page', esProgreso && 'progress-page']}>
    <a class="back-link" href="/#todas-actividades">← Volver a las actividades</a>

    {esProgreso ? (
      <>
        <section class="activity-intro progress-intro">
          <span class="eyebrow">Tu aventura saludable</span>
          <h1>¡Mira cuánto has avanzado!</h1>
          <p>Los pasos que completas se guardan solo en este dispositivo. No necesitas crear una cuenta.</p>
        </section>
        <section class="progress-summary" aria-live="polite">
          <div class="progress-number"><span id="completed-count">0</span><small>pasos completados</small></div>
          <div class="progress-meter" role="progressbar" aria-label="Avance de actividades" aria-valuemin="0" aria-valuemax="21" aria-valuenow="0">
            <span id="progress-meter-fill"></span>
          </div>
          <p id="progress-message">Completa un paso en cualquier actividad para empezar.</p>
        </section>
        <section class="activity-list">
          <h2>Continúa explorando</h2>
          <div class="activity-links">
            {actividades.map((item) => (
              <a class={`activity-link theme-${item.color}`} href={`/actividad/${item.slug}`}>
                <span>{item.titulo}</span><span aria-hidden="true">›</span>
              </a>
            ))}
          </div>
        </section>
      </>
    ) : (
      <>
        <section class:list={['activity-intro', `theme-${actividad!.color}`]}>
          <span class="eyebrow">{actividad!.categoria}</span>
          <h1>{actividad!.titulo}</h1>
          <p>{actividad!.introduccion}</p>
          <span class="activity-illustration" aria-hidden="true">
            {actividad!.slug === 'super-capibara' ? (
              <img src="/img/super-capibara.png" alt="" />
            ) : (
              <span>{actividad!.slug === 'libro-viajero' ? '📚' : '✦'}</span>
            )}
          </span>
        </section>
        <section class="activity-list" aria-labelledby="steps-title">
          <div class="list-heading">
            <div>
              <span class="eyebrow">Tu misión de hoy</span>
              <h2 id="steps-title">Pequeños pasos, grandes logros</h2>
            </div>
            <span class="steps-count"><span id="activity-completed-count">0</span> de {actividad!.pasos.length}</span>
          </div>
          <div class="steps">
            {actividad!.pasos.map((paso, index) => (
              <article class="step-card" data-step={index}>
                <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
                <div class="step-copy">
                  <h3>{paso.titulo}</h3>
                  <p>{paso.descripcion}</p>
                </div>
                <button class="step-toggle" type="button" aria-pressed="false">Lo hice</button>
              </article>
            ))}
          </div>
          <p class="completion-message" id="completion-message" aria-live="polite" hidden>¡Misión completada! Cada paso cuenta. ✨</p>
        </section>
      </>
    )}
  </main>
</Layout>

<script>
  const STORAGE_KEY = 'liga:actividades:progreso';
  type Progress = Record<string, number[]>;

  function isProgress(value: unknown): value is Progress {
    return typeof value === 'object' &&
      value !== null &&
      !Array.isArray(value) &&
      Object.values(value).every((steps) =>
        Array.isArray(steps) && steps.every((step) => Number.isInteger(step) && step >= 0),
      );
  }

  function readProgress(): Progress {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (!stored) return {};
      const parsed: unknown = JSON.parse(stored);
      if (isProgress(parsed)) return parsed;
      console.error('El progreso local tiene un formato no válido.');
      return {};
    } catch (error) {
      console.error('No se pudo leer el progreso local.', error);
      return {};
    }
  }

  function saveProgress(progress: Progress) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(progress));
    } catch (error) {
      console.error('No se pudo guardar el progreso local.', error);
    }
  }

  const currentSlug = window.location.pathname.split('/').filter(Boolean).at(-1) ?? '';
  const progress = readProgress();

  if (currentSlug === 'progreso') {
    const total = Object.values(progress).reduce((sum, steps) => sum + steps.length, 0);
    const count = document.getElementById('completed-count');
    const fill = document.getElementById('progress-meter-fill');
    const meter = document.querySelector<HTMLElement>('[role="progressbar"]');
    const message = document.getElementById('progress-message');
    if (count) count.textContent = String(total);
    if (fill) fill.style.width = `${Math.min(100, (total / 21) * 100)}%`;
    if (meter) meter.setAttribute('aria-valuenow', String(Math.min(total, 21)));
    if (message && total > 0) {
      message.textContent = total === 1
        ? '¡Ya diste tu primer paso! Sigue explorando.'
        : `¡Buen trabajo! Ya completaste ${total} pasos.`;
    }
  } else {
    const cards = [...document.querySelectorAll<HTMLElement>('.step-card')];
    const completed = new Set(progress[currentSlug] ?? []);
    const count = document.getElementById('activity-completed-count');
    const message = document.getElementById('completion-message');

    function render() {
      cards.forEach((card) => {
        const index = Number(card.dataset.step);
        const button = card.querySelector<HTMLButtonElement>('.step-toggle');
        const isDone = completed.has(index);
        card.classList.toggle('is-complete', isDone);
        button?.setAttribute('aria-pressed', String(isDone));
        if (button) button.textContent = isDone ? '✓ Completado' : 'Lo hice';
      });
      if (count) count.textContent = String(completed.size);
      if (message) message.hidden = completed.size !== cards.length;
    }

    cards.forEach((card) => {
      card.querySelector('button')?.addEventListener('click', () => {
        const index = Number(card.dataset.step);
        if (completed.has(index)) completed.delete(index);
        else completed.add(index);
        progress[currentSlug] = [...completed].sort((a, b) => a - b);
        saveProgress(progress);
        render();
      });
    });
    render();
  }
</script>

<style>
  .activity-page {
    max-width: 1040px;
    margin: 0 auto;
    padding: 22px clamp(16px, 3vw, 36px) 56px;
    color: #2d405d;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 20px;
    color: #397f7b;
    font-weight: 700;
    text-decoration: none;
  }

  .activity-intro {
    position: relative;
    min-height: 230px;
    overflow: hidden;
    padding: clamp(26px, 5vw, 52px);
    border-radius: 28px;
    background: #e5f4f4;
  }

  .activity-intro h1 {
    position: relative;
    z-index: 1;
    max-width: 650px;
    margin: 8px 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .activity-intro p {
    position: relative;
    z-index: 1;
    max-width: 620px;
    color: #536b7c;
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .eyebrow {
    color: #527779;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .theme-sky { background: #dff2f8; }
  .theme-orange { background: #ffedcf; }
  .theme-yellow { background: #fff4bf; }
  .theme-coral { background: #ffe3df; }
  .theme-purple { background: #eee6ff; }
  .theme-green { background: #e4f2df; }
  .theme-peach { background: #ffe6dc; }

  .activity-illustration {
    position: absolute;
    top: 0;
    right: 3%;
    bottom: 0;
    display: grid;
    width: 28%;
    place-items: center;
    color: rgba(57, 127, 123, 0.28);
    font-size: 7rem;
  }

  .activity-illustration img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.24;
    mask-image: linear-gradient(to left, #000 50%, transparent);
  }

  .activity-list {
    margin-top: 38px;
  }

  .list-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .activity-list h2 {
    margin-top: 6px;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
    letter-spacing: -0.03em;
  }

  .steps {
    display: grid;
    gap: 12px;
  }

  .step-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 20px;
    border: 1px solid #e5edf0;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 8px 22px rgba(31, 64, 68, 0.05);
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .step-card.is-complete {
    border-color: #a9d5be;
    background: #f1faf4;
  }

  .step-number {
    display: grid;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    place-items: center;
    border-radius: 14px;
    background: #edf5f2;
    color: #498477;
    font-weight: 800;
  }

  .step-copy {
    flex: 1;
  }

  .step-copy h3 {
    margin-bottom: 5px;
    font-size: 1.05rem;
  }

  .step-copy p {
    color: #718399;
    line-height: 1.5;
  }

  .step-toggle {
    flex: 0 0 auto;
    padding: 10px 16px;
    border: 0;
    border-radius: 999px;
    background: #397f7b;
    color: #fff;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }

  .step-toggle:hover { background: #286b68; }
  .step-toggle[aria-pressed="true"] { background: #e1f2e7; color: #286b52; }

  .steps-count {
    flex: 0 0 auto;
    padding: 8px 12px;
    border-radius: 999px;
    background: #edf5f2;
    color: #397f7b;
    font-size: 0.85rem;
    font-weight: 800;
  }

  .completion-message {
    margin-top: 16px;
    padding: 16px;
    border-radius: 14px;
    background: #e7f6e9;
    color: #286b52;
    font-weight: 700;
  }

  .progress-intro { background: #e0f3f6; }

  .progress-summary {
    margin-top: 24px;
    padding: clamp(22px, 4vw, 38px);
    border-radius: 22px;
    background: white;
    box-shadow: 0 10px 28px rgba(31, 64, 68, 0.08);
  }

  .progress-number {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: #317f85;
  }

  .progress-number span {
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.06em;
  }

  .progress-number small { color: #687f91; font-size: 1rem; }

  .progress-meter {
    height: 14px;
    margin: 16px 0;
    overflow: hidden;
    border-radius: 999px;
    background: #eaf0f1;
  }

  .progress-meter span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #72c9b8, #91cddd);
    transition: width 0.3s ease;
  }

  #progress-message { color: #687f91; }

  .activity-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 12px;
    margin-top: 16px;
  }

  .activity-link {
    display: flex;
    justify-content: space-between;
    padding: 16px;
    border-radius: 14px;
    color: #2d405d;
    font-weight: 700;
    text-decoration: none;
  }

  .activity-link:hover { filter: brightness(0.97); }

  @media (max-width: 600px) {
    .activity-intro { min-height: 250px; }
    .activity-illustration { right: -10%; width: 45%; opacity: 0.55; }
    .step-card { align-items: flex-start; gap: 12px; padding: 15px; }
    .step-number { width: 36px; height: 36px; flex-basis: 36px; border-radius: 12px; }
    .step-toggle { align-self: center; padding: 9px 11px; font-size: 0.8rem; }
  }
</style>
