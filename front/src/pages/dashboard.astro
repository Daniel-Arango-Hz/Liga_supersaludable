---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard – FamiliaLee" description="Tu panel de control en FamiliaLee">
  <main class="dashboard-main">
    <div class="container">
      <div class="dashboard-header">
        <h1 class="dashboard-title">🌟 ¡Bienvenido a tu Mundo! 🌟</h1>
        <p class="dashboard-subtitle">Aquí encontrarás tus libros favoritos y mucho más</p>
      </div>

      <div class="dashboard-grid">
        <a href="/perfil" class="dashboard-card card-blue">
          <div class="card-icon">👤</div>
          <h3>Mi Perfil</h3>
          <p>Edita tu información</p>
        </a>

        <a href="/mis-libros" class="dashboard-card card-purple">
          <div class="card-icon">📚</div>
          <h3>Mis Libros</h3>
          <p>Accede a tus favoritos</p>
        </a>

        <a href="/mis-descargas" class="dashboard-card card-green">
          <div class="card-icon">⬇️</div>
          <h3>Descargas</h3>
          <p>Historial de descargas</p>
        </a>

        <a href="/mi-biblioteca" class="dashboard-card card-pink">
          <div class="card-icon">🎨</div>
          <h3>Mi Biblioteca</h3>
          <p>Gestiona tu colección</p>
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .dashboard-main {
    min-height: calc(100vh - 64px);
    background: linear-gradient(135deg, var(--color-cream) 0%, rgba(0, 168, 232, 0.1) 100%);
    padding: 3rem 0;
  }

  .dashboard-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .dashboard-title {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-primary-blue), var(--color-primary-purple), var(--color-primary-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.75rem;
    animation: slideInDown 0.6s ease-out;
  }

  @keyframes slideInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .dashboard-subtitle {
    font-size: 1.15rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
  }

  @media (max-width: 1024px) {
    .dashboard-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 680px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .dashboard-header {
      margin-bottom: 2.5rem;
    }

    .dashboard-title {
      font-size: 2rem;
    }

    .dashboard-subtitle {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .dashboard-main {
      padding: 2rem 0;
    }

    .dashboard-header {
      margin-bottom: 2rem;
    }

    .dashboard-title {
      font-size: 1.75rem;
    }

    .dashboard-card {
      padding: 1.75rem 1.5rem;
      gap: 0.75rem;
    }

    .card-icon {
      font-size: 2.75rem;
      margin-bottom: 0.5rem;
    }

    .dashboard-card h3 {
      font-size: 1.15rem;
    }

    .dashboard-card p {
      font-size: 0.9rem;
    }
  }
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2.5rem 2rem;
    background: var(--color-white);
    border: 3px solid transparent;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transition: all 0.3s;
    position: relative;
    overflow: hidden;
  }

  .dashboard-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary-blue), var(--color-primary-purple));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s;
  }

  .dashboard-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-lg);
  }

  .dashboard-card:hover::before {
    transform: scaleX(1);
  }

  .dashboard-card.card-blue {
    border-color: var(--color-primary-blue);
  }

  .dashboard-card.card-blue:hover {
    background: rgba(0, 168, 232, 0.08);
  }

  .dashboard-card.card-purple {
    border-color: var(--color-primary-purple);
  }

  .dashboard-card.card-purple:hover {
    background: rgba(184, 45, 181, 0.08);
  }

  .dashboard-card.card-green {
    border-color: var(--color-primary-green);
  }

  .dashboard-card.card-green:hover {
    background: rgba(6, 167, 125, 0.08);
  }

  .dashboard-card.card-pink {
    border-color: var(--color-primary-pink);
  }

  .dashboard-card.card-pink:hover {
    background: rgba(255, 0, 110, 0.08);
  }

  .card-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    display: block;
  }

  .dashboard-card h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .dashboard-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 768px) {
    .dashboard-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.5rem;
    }

    .dashboard-title {
      font-size: 2rem;
    }
  }

  @media (max-width: 480px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }

    .dashboard-card {
      padding: 2rem 1.5rem;
    }
  }

  .dashboard-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2.5rem 2rem;
    border: 3px solid var(--color-navy);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s;
    text-decoration: none;
    color: inherit;
  }

  .dashboard-card:hover {
    border-color: var(--color-navy);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .card-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(13, 34, 64, 0.1), rgba(200, 135, 42, 0.1));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .dashboard-card:hover .card-icon {
    background: linear-gradient(135deg, var(--color-navy), var(--color-gold));
    color: var(--color-white);
  }

  .dashboard-card h3 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }

  .dashboard-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .dashboard-main {
      padding: 2rem 0;
    }

    .dashboard-title {
      font-size: 1.8rem;
    }

    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { isAuthenticated } from '../utils/api';

  // Proteger la página - solo usuarios logueados
  if (!isAuthenticated()) {
    window.location.href = '/auth/login';
  }
</script>
