---
import Layout from '../../layouts/Layout.astro';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';
---

<Layout title="Mi Biblioteca – FamiliaLee" description="Libros guardados por el usuario.">
  <main>
    <section class="panel-hero">
      <div class="container panel-hero-inner">
        <div class="panel-avatar" aria-hidden="true">📚</div>
        <div>
          <h1 class="panel-nombre">Mi Biblioteca</h1>
          <p class="panel-email">Tus libros guardados para leer después</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container panel-layout">
        <nav class="panel-nav" aria-label="Navegación del panel">
          <ul class="panel-nav-list">
            <li><a href="/panel/guardados" class="panel-nav-link active">Guardados</a></li>
            <li><a href="/panel/publicaciones" class="panel-nav-link">Publicaciones</a></li>
          </ul>
        </nav>

        <div class="panel-content">
          <div class="section-header">
            <h2>Libros Guardados</h2>
            <p id="saved-count">Cargando...</p>
          </div>

          <div id="saved-grid" class="panel-books-grid"></div>

          <div id="saved-empty" class="empty-state" style="display: none;">
            <p>Aún no tienes libros guardados.</p>
            <a href="/biblioteca" class="btn-link">Explorar biblioteca</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script define:vars={{ apiUrl }}>
  // @ts-nocheck
  const API_URL = apiUrl;

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function renderSavedBooks(libros) {
    const grid = document.getElementById('saved-grid');
    const empty = document.getElementById('saved-empty');
    const count = document.getElementById('saved-count');

    if (!grid || !empty || !count) return;

    count.textContent = `${libros.length} ${libros.length === 1 ? 'libro guardado' : 'libros guardados'}`;

    if (!libros.length) {
      grid.innerHTML = '';
      empty.style.display = 'block';
      return;
    }

    empty.style.display = 'none';

    grid.innerHTML = libros
      .map((libro) => {
        const portada = /^https?:\/\//i.test(libro.portada_icono || '')
          ? `<img class="cover-image" src="${escapeHtml(libro.portada_icono)}" alt="Portada de ${escapeHtml(libro.titulo)}" loading="lazy" />`
          : `<span class="cover-icon">${escapeHtml(libro.portada_icono || '📖')}</span>`;

        return `
          <article class="book-card">
            <a href="/libro/${encodeURIComponent(libro.slug)}" class="book-card-link">
              <div class="book-cover" style="background: ${escapeHtml(libro.portada_gradiente || 'linear-gradient(135deg,#00a8e8,#b82db5)')}">
                ${portada}
                <div class="cover-title-overlay">
                  <p class="cover-titulo">${escapeHtml(libro.titulo || 'Sin título')}</p>
                  <p class="cover-autor">${escapeHtml(libro.autor_nombre || 'Anónimo')}</p>
                </div>
              </div>
              <div class="book-info">
                <p class="book-autor">${escapeHtml(libro.autor_nombre || 'Anónimo')}</p>
                <h3 class="book-titulo">${escapeHtml(libro.titulo || 'Sin título')}</h3>
                <div class="book-meta">
                  <div class="star-rating">⭐ ${Number(libro.rating_promedio || 0).toFixed(1)}</div>
                  <div class="book-descargas">⬇ ${Number(libro.descargas_total || 0).toLocaleString('es')}</div>
                </div>
              </div>
            </a>
          </article>
        `;
      })
      .join('');
  }

  async function loadSavedBooks() {
    const token = localStorage.getItem('token');
    if (!token) {
      window.location.href = '/auth/login';
      return;
    }

    try {
      const res = await fetch(`${API_URL}/usuarios/guardados`, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      if (res.status === 401) {
        window.location.href = '/auth/login';
        return;
      }

      if (!res.ok) throw new Error('No se pudieron cargar los guardados.');

      const data = await res.json();
      renderSavedBooks(Array.isArray(data) ? data : []);
    } catch (error) {
      const count = document.getElementById('saved-count');
      if (count) count.textContent = 'Error al cargar guardados';
      renderSavedBooks([]);
    }
  }

  loadSavedBooks();
</script>

<style>
  .panel-hero {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-border);
    padding: 2rem 0;
  }

  .panel-hero-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .panel-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-white);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
  }

  .panel-nombre {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--color-navy);
  }

  .panel-email {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .panel-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
  }

  .panel-nav {
    position: sticky;
    top: 80px;
  }

  .panel-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .panel-nav-link {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .panel-nav-link:hover {
    background: var(--color-cream);
    color: var(--color-navy);
  }

  .panel-nav-link.active {
    background: var(--color-cream-dark);
    color: var(--color-navy);
    font-weight: 700;
  }

  .panel-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .panel-books-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .book-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition: all 0.3s;
    border: 3px solid var(--color-primary-blue);
    position: relative;
  }

  .book-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 168, 232, 0), rgba(0, 168, 232, 0.15));
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .book-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-8px) scale(1.02);
    border-color: var(--color-primary-pink);
  }

  .book-card:hover::before {
    opacity: 1;
  }

  .book-card-link {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }

  .book-cover {
    position: relative;
    aspect-ratio: 3/4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-icon {
    font-size: 4.5rem;
    opacity: 0.4;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
  }

  .cover-title-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem 1rem 1rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, transparent 100%);
  }

  .cover-titulo {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
  }

  .cover-autor {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .book-info {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .book-autor {
    font-size: 0.85rem;
    color: var(--color-primary-blue);
    font-weight: 600;
    margin: 0;
  }

  .book-titulo {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.35;
    margin: 0;
  }

  .book-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  .star-rating {
    color: var(--color-primary-yellow);
    font-weight: 600;
  }

  .book-descargas {
    color: var(--color-primary-blue);
    font-weight: 600;
  }

  .empty-state {
    background: var(--color-white);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.2rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .btn-link {
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary-blue);
    color: var(--color-white);
    font-size: 0.88rem;
  }

  @media (max-width: 900px) {
    .panel-layout {
      grid-template-columns: 1fr;
    }

    .panel-nav {
      position: static;
    }

    .panel-nav-list {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .panel-books-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .panel-books-grid {
      grid-template-columns: 1fr;
    }

    .book-card {
      border-width: 2px;
    }

    .cover-icon {
      font-size: 3rem;
    }

    .book-meta {
      gap: 0.5rem;
      font-size: 0.8rem;
    }
  }
</style>

