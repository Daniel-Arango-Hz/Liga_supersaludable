---
import Layout from '../../layouts/Layout.astro';
import '../../styles/panel-adventure-card.css';

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000/api';
---

<Layout title="Mi Biblioteca – FamiliaLee" description="Libros guardados por el usuario.">
  <main>
    <section class="panel-hero">
      <div class="container panel-hero-inner">
        <div class="panel-avatar" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z" />
            <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20M8 7h8M8 10h8" />
          </svg>
        </div>
        <div>
          <h1 class="panel-nombre">Mi Biblioteca</h1>
          <p class="panel-email">Tus libros guardados para leer después</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container panel-layout">
        <nav class="panel-nav" aria-label="Navegación del panel">
          <ul class="panel-nav-list">
            <li>
              <a href="/panel/guardados" class="panel-nav-link active" aria-current="page">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" /></svg>
                Guardados
              </a>
            </li>
            <li>
              <a href="/panel/publicaciones" class="panel-nav-link">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5Z" /></svg>
                Publicaciones
              </a>
            </li>
          </ul>
        </nav>

        <div class="panel-content">
          <div class="section-header">
            <h2 class="panel-section-title">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" /></svg>
              Libros guardados
            </h2>
            <p id="saved-count">Cargando...</p>
          </div>

          <div id="saved-grid" class="panel-books-grid"></div>

          <div id="saved-empty" class="empty-state" style="display: none;">
            <p>Aún no tienes libros guardados.</p>
            <a href="/biblioteca" class="btn-link">Explorar biblioteca</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script define:vars={{ apiUrl }}>
  // @ts-nocheck
  const API_URL = apiUrl;
  const requestLogin = () => window.dispatchEvent(new CustomEvent('auth:required', {
    detail: { title: 'Inicio de sesión requerido', message: 'Inicia sesión para ver tus libros guardados.' },
  }));

  function escapeHtml(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function renderSavedBooks(libros) {
    const grid = document.getElementById('saved-grid');
    const empty = document.getElementById('saved-empty');
    const count = document.getElementById('saved-count');

    if (!grid || !empty || !count) return;

    count.textContent = `${libros.length} ${libros.length === 1 ? 'libro guardado' : 'libros guardados'}`;

    if (!libros.length) {
      grid.innerHTML = '';
      empty.style.display = 'block';
      return;
    }

    empty.style.display = 'none';

    grid.innerHTML = libros
      .map((libro) => {
        const portada = /^https?:\/\//i.test(libro.portada_icono || '')
          ? `<img class="adventure-cover-image" src="${escapeHtml(libro.portada_icono)}" alt="Portada de ${escapeHtml(libro.titulo)}" loading="lazy" />`
          : `<span class="adventure-cover-icon" aria-hidden="true">${escapeHtml(libro.portada_icono || '📖')}</span>`;
        const rating = Math.min(5, Math.max(0, Number(libro.rating_promedio || 0)));

        return `
          <article class="adventure-card">
            <a href="/libro/${encodeURIComponent(libro.slug)}" class="adventure-card-link" aria-label="Comenzar ${escapeHtml(libro.titulo || 'libro')}">
              <div class="adventure-cover" style="background: ${escapeHtml(libro.portada_gradiente || 'linear-gradient(135deg,#00a8e8,#b82db5)')}">
                ${portada}
                ${libro.destacado ? '<span class="adventure-badge">Destacado</span>' : ''}
                <h3 class="adventure-title">${escapeHtml(libro.titulo || 'Sin título')}</h3>
              </div>
              <div class="adventure-info">
                <div class="adventure-stats">
                  <div class="adventure-stat" aria-label="${Number(libro.descargas_total || 0).toLocaleString('es')} descargas">
                    <div class="adventure-stat-value">
                      <strong>${Number(libro.descargas_total || 0).toLocaleString('es')}</strong>
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>
                    <span>Descargas</span>
                  </div>
                  <span class="adventure-divider" aria-hidden="true"></span>
                  <div class="adventure-stat adventure-rating" aria-label="${rating.toFixed(1)} de 5, valoración">
                    <span class="adventure-stars" style="--rating: ${rating / 5 * 100}%" aria-hidden="true">★★★★★</span>
                    <span><strong>${rating.toFixed(1)}</strong> Valoración</span>
                  </div>
                </div>
                <span class="adventure-cta">Comenzar</span>
              </div>
            </a>
          </article>
        `;
      })
      .join('');
  }

  async function loadSavedBooks() {
    const token = localStorage.getItem('token');
    if (!token) {
      requestLogin();
      return;
    }

    try {
      const res = await fetch(`${API_URL}/usuarios/guardados`, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      if (res.status === 401) {
        window.dispatchEvent(new Event('auth:expired'));
        return;
      }

      if (!res.ok) throw new Error('No se pudieron cargar los guardados.');

      const data = await res.json();
      renderSavedBooks(Array.isArray(data) ? data : []);
    } catch (error) {
      const count = document.getElementById('saved-count');
      if (count) count.textContent = 'Error al cargar guardados';
      renderSavedBooks([]);
    }
  }

  loadSavedBooks();
</script>

<style>
  .panel-hero {
    background: var(--color-cream);
    border-bottom: 1px solid var(--color-border);
    padding: 2rem 0;
  }

  .panel-hero-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .panel-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-white);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
  }
  .panel-avatar svg { width: 26px; height: 26px; stroke: #269e91; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  .panel-nombre {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--color-navy);
  }

  .panel-email {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .panel-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
  }

  .panel-nav {
    position: sticky;
    top: 80px;
  }

  .panel-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .panel-nav-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }
  .panel-nav-link svg, .panel-section-title svg { width: 18px; height: 18px; flex: 0 0 auto; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .panel-section-title { display: flex; align-items: center; gap: 0.55rem; }

  .panel-nav-link:hover {
    background: var(--color-cream);
    color: var(--color-navy);
  }

  .panel-nav-link.active {
    background: var(--color-cream-dark);
    color: var(--color-navy);
    font-weight: 700;
  }

  .panel-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .panel-books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 280px));
    justify-content: start;
    gap: 1.25rem;
  }

  .book-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition: all 0.3s;
    border: 3px solid var(--color-primary-blue);
    position: relative;
  }

  .book-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0, 168, 232, 0), rgba(0, 168, 232, 0.15));
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .book-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-8px) scale(1.02);
    border-color: var(--color-primary-pink);
  }

  .book-card:hover::before {
    opacity: 1;
  }

  .book-card-link {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }

  .book-cover {
    position: relative;
    aspect-ratio: 3/4;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-icon {
    font-size: 4.5rem;
    opacity: 0.4;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
  }

  .cover-title-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem 1rem 1rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, transparent 100%);
  }

  .cover-titulo {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
  }

  .cover-autor {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .book-info {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .book-autor {
    font-size: 0.85rem;
    color: var(--color-primary-blue);
    font-weight: 600;
    margin: 0;
  }

  .book-titulo {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.35;
    margin: 0;
  }

  .book-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.2rem;
  }

  .star-rating {
    color: var(--color-primary-yellow);
    font-weight: 600;
  }

  .book-descargas {
    color: var(--color-primary-blue);
    font-weight: 600;
  }

  .empty-state {
    background: var(--color-white);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.2rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .btn-link {
    display: inline-block;
    margin-top: 0.6rem;
    padding: 0.45rem 0.8rem;
    border-radius: var(--radius-sm);
    background: var(--color-primary-blue);
    color: var(--color-white);
    font-size: 0.88rem;
  }

  @media (max-width: 900px) {
    .panel-layout {
      grid-template-columns: 1fr;
    }

    .panel-nav {
      position: static;
    }

    .panel-nav-list {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .panel-books-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .panel-books-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  }
</style>

<style is:global>
  #saved-grid .book-card {
    min-width: 0;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 26px;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    border: 1px solid rgba(29, 41, 74, 0.05);
    position: relative;
  }

  #saved-grid .book-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(78, 160, 255, 0.03), rgba(255, 95, 156, 0.06));
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  #saved-grid .book-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-5px);
    border-color: rgba(255, 95, 156, 0.2);
  }

  #saved-grid .book-card:hover::before {
    opacity: 1;
  }

  #saved-grid .book-card-link {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
    color: inherit;
  }

  #saved-grid .book-cover {
    position: relative;
    aspect-ratio: 3/4;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    overflow: hidden;
  }

  #saved-grid .cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #saved-grid .cover-icon {
    font-size: 4.5rem;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -60%);
    opacity: 0.38;
    pointer-events: none;
  }

  #saved-grid .cover-title-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 1.5rem 1rem 1rem;
    background: linear-gradient(to top, rgba(8, 15, 24, 0.8) 0%, transparent 100%);
  }

  #saved-grid .cover-titulo {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
    margin: 0;
  }

  #saved-grid .cover-autor {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.9);
    margin-top: 0.25rem;
    font-weight: 500;
  }

  #saved-grid .book-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.15rem;
  }

  #saved-grid .book-eyebrow {
    margin: 0;
    color: #c86628;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #saved-grid .book-subtitle {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  #saved-grid .book-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.35rem;
  }

  #saved-grid .book-stats { display: flex; flex-wrap: wrap; align-items: center; gap: 0.65rem; }
  #saved-grid .stat { display: inline-flex; align-items: center; gap: 0.28rem; color: var(--color-text-muted); font-size: 0.76rem; font-weight: 700; }
  #saved-grid .stat svg { width: 14px; height: 14px; }
  #saved-grid .stat-rating svg { color: #f4b73e; }
  #saved-grid .stat-downloads svg { stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  #saved-grid .book-cta { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--color-primary-pink); font-size: 0.8rem; font-weight: 800; }
  #saved-grid .book-cta svg { width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  #saved-grid .badge-destacado { position: absolute; z-index: 3; top: 12px; left: 12px; padding: 0.38rem 0.72rem; border-radius: 999px; background: linear-gradient(135deg, #ffb347, #ff725d); color: #fff; font-size: 0.72rem; font-weight: 800; }
  #saved-grid .pages-bubble { position: absolute; z-index: 3; top: 12px; right: 12px; padding: 0.35rem 0.6rem; border-radius: 999px; background: rgba(255, 255, 255, 0.92); color: var(--color-navy); font-size: 0.74rem; font-weight: 800; }

  #saved-grid .book-titulo {
    margin: 0;
    color: var(--color-navy);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.25;
  }

  @media (max-width: 520px) {
    #saved-grid .book-info { padding: 1rem; }
    #saved-grid .cover-icon { font-size: 3.5rem; }
  }
</style>
